<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool: bake planet-textures.png, the sky atlas's offline planet colour maps (one cell per
    textured body, in PlanetMap's convention, poles filled). Run on demand and the output committed; see
    tools/bake-planet-textures/README.md and docs/plans/atlas-planet-detail.md, "A4: the textured disc".

    Not part of the solution; not packed; not shipped. Sibling of bake-object-imagery.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BakePlanetTextures</AssemblyName>
    <RootNamespace>BakePlanetTextures</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TianWen.Lib\TianWen.Lib.csproj" />
  </ItemGroup>

</Project>
