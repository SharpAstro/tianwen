<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool: bake object_articles.gs.gz, the English Wikipedia article each catalogued object is
    VERIFIED to have (Wikidata position agrees with ours), with the article's lead image and its credit.
    Run on demand and the output committed; see tools/bake-object-imagery/README.md and
    docs/plans/object-imagery.md P0.

    Not part of the solution; not packed; not shipped. Sibling of bake-comets.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BakeObjectImagery</AssemblyName>
    <RootNamespace>BakeObjectImagery</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TianWen.Lib\TianWen.Lib.csproj" />
  </ItemGroup>

</Project>
