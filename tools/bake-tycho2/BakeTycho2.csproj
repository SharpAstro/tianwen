<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool: slice the Tycho-2 catalog into region-aligned lzip members so the browser can
    fetch the sky it is looking at instead of all 2.5M stars.

      tyc2/manifest.bin   member framing only (count, raw length, each member's first region)
      tyc2/m0000.lz       the catalog HEADER (offset table); always fetched, gives star identity
      tyc2/m0001.lz ...   one member per ~256 KB of region-aligned records

    DERIVED from the committed tyc2.bin.lz rather than from the upstream catalog, on purpose: the
    members are a repack of the exact bytes the desktop embeds, so the two encodings cannot drift
    into disagreeing about the sky. The tool decompresses, repacks, and then VERIFIES that the
    concatenated members decode back to the identical input before writing anything.

    Not part of the solution; not packed; not shipped. See tools/bake-tycho2/README.md, the
    "Bake Tycho-2 members" step in .github/workflows/pages.yml, and docs/plans/web-tycho2.md.
    Sibling of bake-comets.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BakeTycho2</AssemblyName>
    <RootNamespace>BakeTycho2</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TianWen.Lib\TianWen.Lib.csproj" />
  </ItemGroup>

</Project>
