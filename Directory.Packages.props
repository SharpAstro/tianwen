<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>

    <SharpAstroCodecsVersion>3.14.*</SharpAstroCodecsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />

    <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageVersion Include="DotNext.Threading" Version="6.8.0" />

    <PackageVersion Include="FITS.Lib" Version="6.2.*" />

    <PackageVersion Include="SER.Lib" Version="1.1.*" />

    <PackageVersion Include="Lzip.Lib" Version="1.1.*" />

    <PackageVersion Include="LAN.Lib" Version="2.0.*" />
    <PackageVersion Include="SharpAstro.AppShell" Version="1.1.*" />
    <PackageVersion Include="GeoTimeZone" Version="6.1.0" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />

    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.12" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.12" />

    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.*" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.24.*" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.*" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.QNN" Version="1.24.*" />

    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <PackageVersion Include="Meziantou.Extensions.Logging.Xunit.v3" Version="3.0.7" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.354" />

    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />

    <PackageVersion Include="Pastel" Version="8.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />

    <PackageVersion Include="DIR.Lib" Version="11.5.*" />

    <PackageVersion Include="SharpAstro.Tiff" Version="$(SharpAstroCodecsVersion)" />
    <PackageVersion Include="SharpAstro.Exif" Version="$(SharpAstroCodecsVersion)" />
    <PackageVersion Include="SharpAstro.Png" Version="$(SharpAstroCodecsVersion)" />
    <PackageVersion Include="SharpAstro.Color.Icc" Version="$(SharpAstroCodecsVersion)" />
    <PackageVersion Include="SharpAstro.Jpeg.IccInjector" Version="$(SharpAstroCodecsVersion)" />

    <PackageVersion Include="SharpAstro.Jpeg" Version="$(SharpAstroCodecsVersion)" />

    <PackageVersion Include="SharpAstro.Jpeg.GainMap" Version="$(SharpAstroCodecsVersion)" />

    <PackageVersion Include="SharpAstro.Jxr" Version="$(SharpAstroCodecsVersion)" />
    <PackageVersion Include="SharpAstro.Exr" Version="$(SharpAstroCodecsVersion)" />

    <PackageVersion Include="SharpAstro.Codecs" Version="$(SharpAstroCodecsVersion)" />

    <PackageVersion Include="Console.Lib" Version="5.4.*" />

    <PackageVersion Include="SdlVulkan.Renderer" Version="7.50.*" />
    <!-- tools/BakeShaders only. Here rather than inline because this file now covers tools/ as well as
         src/, which is the whole point: a version the sweep cannot see is a version that drifts. -->
    <PackageVersion Include="Vortice.ShaderCompiler" Version="1.9.0" />

    <PackageVersion Include="WebGl.Renderer" Version="1.36.*" />
    <PackageVersion Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    <PackageVersion Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />

    <PackageVersion Include="FC.SDK" Version="3.1.*" />

    <PackageVersion Include="FC.SDK.Raw" Version="3.1.*" />

    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />

    <PackageVersion Include="PlayerOne.SDK" Version="3.11.*" />
    <PackageVersion Include="ToupTek.SDK" Version="1.1.*" />
    <PackageVersion Include="QHYCCD.SDK" Version="2.0.*" />
    <PackageVersion Include="TianWen.DAL" Version="3.2.*" />
    <PackageVersion Include="ZWOptical.SDK" Version="6.0.*" />
  </ItemGroup>
</Project>
