# Auto detect text files and normalise line endings
* text=auto

# C# / .NET — CRLF (Windows convention, matches .editorconfig)
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
# Config / markup
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.editorconfig text eol=lf
# Shell scripts — always LF
*.sh text eol=lf
# Shaders
*.glsl text eol=lf
*.vert text eol=lf
*.frag text eol=lf
*.comp text eol=lf
*.spv binary
# Binary — no conversion
*.png binary
*.fits binary
*.fit binary
*.fts binary
# fpack tile-compressed FITS. Auto-detection calls this one TEXT -- the compressed payload
# contains 0x0A bytes -- so without this, text=auto rewrites line endings inside a binary.
*.fz binary
*.dll binary
*.exe binary
*.nupkg binary
*.snk binary
*.pfx binary
*.gz binary
*.tgz binary
*.zip binary
*.lz binary
*.lzip binary
*.lz filter=lfs diff=lfs merge=lfs -text
*.fits.gz filter=lfs diff=lfs merge=lfs -text
*.bin.gz filter=lfs diff=lfs merge=lfs -text
*.bin.zip filter=lfs diff=lfs merge=lfs -text
tyc2.bin filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
# In-house AI model weights (src/TianWen.AI.Imaging/models/) - small enough to
# live in the repo, too binary to diff. The fetch script materializes them into
# %LOCALAPPDATA%/TianWen/models; CI narrow-pulls them for the parity tests.
*.onnx filter=lfs diff=lfs merge=lfs -text

# TEMPORARY, and the only reason it is here: the repo's LFS budget is exhausted, so CI cannot fetch a
# single new object. This file is the ONLY one missing from the runners' LFS cache -- verified by
# reproducing the workflow's cache key across main (the cached set is 32 files at 237d7515, the wanted
# set is 33 from 69218529, and this is the file that differs) -- so storing it as a plain git blob is
# the whole fix, and every other LFS object still rides the cache.
#
# The cost is 3.1 MB of permanent history against a 976 MB .git, i.e. 0.3%; measured rather than
# assumed, because "later remove" does NOT reclaim it (that needs a history rewrite, which is not worth
# doing for this).
#
# REVERT when the replacement model lands (expected 2026-09): delete this block, then
# `git rm --cached` + `git add` the file so *.onnx above takes it back into LFS.
src/TianWen.AI.Imaging/models/*.onnx !filter !diff !merge -text
*.bz2 filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
# Canon raw fixtures - keep repo slim, narrow-pull in CI
*.cr2 filter=lfs diff=lfs merge=lfs -text
*.cr3 filter=lfs diff=lfs merge=lfs -text
*.CR2 filter=lfs diff=lfs merge=lfs -text
*.CR3 filter=lfs diff=lfs merge=lfs -text
