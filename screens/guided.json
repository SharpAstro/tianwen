{
  "id": "guided",
  "title": "Guided",
  "root": {
    "kind": "dock",
    "background": "ContentBg",
    "children": [
      {
        "kind": "dock", "side": "top", "padding": 8, "background": "HeaderBg", "size": 44,
        "children": [
          {"kind": "text", "side": "left", "size": 180, "text": "M42 · 2026-11-18", "fontSize": 16, "color": "HeaderText"},
          {"kind": "text", "side": "left", "size": 80, "text": "Guided", "align": "center", "background": "Selection", "color": "SelectionText", "borderRadius": 4},
          {"kind": "text", "side": "left", "size": 80, "text": "Stack", "align": "center", "color": "BodyText", "action": "goto:home"},
          {"kind": "text", "side": "left", "size": 80, "text": "Process", "align": "center", "color": "BodyText", "action": "goto:process"},
          {"kind": "text", "side": "left", "size": 90, "text": "Workflow", "align": "center", "color": "BodyText", "action": "goto:workflow"},
          {"kind": "text", "text": "Workflow: tianwen viewer", "color": "DimText", "align": "far"}
        ]
      },
      {
        "kind": "grid", "side": "top", "size": 44, "columns": 10, "gap": 4, "padding": 6, "background": "PanelBg",
        "children": [
          {"kind": "text", "text": "1 Load ✓", "color": "BodyText", "align": "center", "padding": 4, "tooltip": "312 lights, 40 darks, 30 flats"},
          {"kind": "text", "text": "2 Calibrate ✓", "color": "BodyText", "align": "center", "padding": 4},
          {"kind": "text", "text": "3 Analyse ✓", "color": "BodyText", "align": "center", "padding": 4, "tooltip": "1 frame left out: FWHM over 2σ"},
          {"kind": "text", "text": "4 Register ✓", "color": "BodyText", "align": "center", "padding": 4},
          {"kind": "text", "text": "5 Integrate ✓", "color": "BodyText", "align": "center", "padding": 4, "action": "goto:integrate"},
          {"kind": "text", "text": "6 Crop ✓", "color": "BodyText", "align": "center", "padding": 4, "tooltip": "Quick auto-crop (GPU, same as the viewer): 6193×4136 px", "action": "goto:crop"},
          {"kind": "text", "text": "7 Plate solve", "color": "SelectionText", "background": "Selection", "align": "center", "padding": 4, "borderRadius": 4},
          {"kind": "text", "text": "8 SPCC", "color": "DimText", "align": "center", "padding": 4},
          {"kind": "text", "text": "9 Gradient", "color": "DimText", "align": "center", "padding": 4},
          {"kind": "text", "text": "10 Stretch", "color": "DimText", "align": "center", "padding": 4}
        ]
      },
      {
        "kind": "vstack", "side": "left", "size": 360, "gap": 8, "padding": 10, "background": "PanelBg",
        "children": [
          {"kind": "text", "text": "Step 7 of 10: Plate solve", "fontSize": 15, "color": "HeaderText"},
          {"kind": "text", "text": "Finds where the master points on the sky.", "color": "DimText"},
          {"kind": "dropdown", "bind": "solver", "label": "Built-in solver", "options": ["Built-in solver", "ASTAP", "astrometry.net"]},
          {"kind": "text", "text": "Hint from FITS header", "color": "DimText"},
          {"kind": "grid", "columns": 2, "gap": 4, "children": [
            {"kind": "text", "text": "Position", "color": "DimText"},
            {"kind": "text", "text": "05h 35m, −05° 23′", "color": "BodyText"},
            {"kind": "text", "text": "Focal length", "color": "DimText"},
            {"kind": "text", "text": "800 mm", "color": "BodyText"},
            {"kind": "text", "text": "Pixel size", "color": "DimText"},
            {"kind": "text", "text": "3.76 µm (drizzled 2×)", "color": "BodyText"}
          ]},
          {"kind": "vstack", "gap": 4, "padding": 8, "border": "Success", "borderWidth": 1, "borderRadius": 4, "children": [
            {"kind": "text", "text": "✓ Solved in 3.2 s", "color": "Success"},
            {"kind": "text", "text": "Centre 05h 35m 17s, −05° 23′ 28″", "color": "BodyText"},
            {"kind": "text", "text": "0.48″/px · 92.3° · 1 204 stars", "color": "BodyText"}
          ]},
          {"kind": "checkbox", "bind": "runOn", "label": "Run on until a step needs me", "tooltip": "Off: stop after every step so you can look"},
          {"kind": "dock", "height": 34, "children": [
            {"kind": "text", "side": "left", "size": 80, "text": "← Back", "padding": 8, "background": "HeaderBg", "color": "BodyText", "borderRadius": 4, "align": "center"},
            {"kind": "text", "side": "right", "size": 130, "text": "Next: SPCC →", "padding": 8, "background": "Accent", "color": "SelectionText", "borderRadius": 4, "align": "center"},
            {"kind": "spacer"}
          ]},
          {"kind": "text", "text": "Same solver and SPCC as the viewer.", "color": "DimText"}
        ]
      },
      {
        "kind": "dock", "side": "bottom", "size": 36, "padding": 8, "background": "PanelBg",
        "children": [
          {"kind": "text", "side": "right", "size": 220, "text": "Open as workflow to change ↗", "color": "Accent", "align": "far", "action": "goto:workflow"},
          {"kind": "text", "text": "Steps 1–6 done in 18 min · 311 frames, Bayer drizzle 2×", "color": "BodyText"}
        ]
      },
      {
        "kind": "overlay",
        "children": [
          {"kind": "box", "color": "#0b0d12"},
          {"kind": "dock", "padding": 10, "children": [
            {"kind": "dock", "side": "top", "size": 32, "children": [
              {"kind": "buttonGroup", "side": "right", "size": 260, "bind": "overlayMode", "options": ["Image", "Grid", "Stars"]},
              {"kind": "text", "text": "Cropped master, with the solved sky grid", "color": "#c8ccd4"}
            ]},
            {"kind": "text", "text": "image canvas: RA/Dec grid and matched catalogue stars", "align": "center", "color": "#8a90a0"}
          ]}
        ]
      }
    ]
  }
}
