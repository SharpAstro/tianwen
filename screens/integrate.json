{
  "id": "integrate",
  "title": "Guided: jump to integrate",
  "root": {
    "kind": "dock",
    "background": "ContentBg",
    "children": [
      {
        "kind": "dock", "side": "top", "padding": 8, "background": "HeaderBg", "size": 44,
        "children": [
          {"kind": "text", "side": "left", "size": 180, "text": "M42 · 2026-11-19", "fontSize": 16, "color": "HeaderText"},
          {"kind": "text", "side": "left", "size": 80, "text": "Guided", "align": "center", "background": "Selection", "color": "SelectionText", "borderRadius": 4, "action": "goto:guided"},
          {"kind": "text", "side": "left", "size": 80, "text": "Stack", "align": "center", "color": "BodyText", "action": "goto:home"},
          {"kind": "text", "side": "left", "size": 80, "text": "Process", "align": "center", "color": "BodyText", "action": "goto:process"},
          {"kind": "text", "side": "left", "size": 90, "text": "Workflow", "align": "center", "color": "BodyText", "action": "goto:workflow"},
          {"kind": "text", "text": "Workflow: tianwen viewer", "color": "DimText", "align": "far"}
        ]
      },
      {
        "kind": "grid", "side": "top", "size": 44, "columns": 10, "gap": 4, "padding": 6, "background": "PanelBg",
        "children": [
          {"kind": "text", "text": "1 Load ✓", "color": "BodyText", "align": "center", "padding": 4, "tooltip": "Done and still valid: reused"},
          {"kind": "text", "text": "2 Calibrate ↻", "color": "Warn", "align": "center", "padding": 4, "tooltip": "Done, but the flats changed: runs again"},
          {"kind": "text", "text": "3 Analyse ○", "color": "BodyText", "align": "center", "padding": 4, "tooltip": "Not done yet: runs first"},
          {"kind": "text", "text": "4 Register ○", "color": "BodyText", "align": "center", "padding": 4, "tooltip": "Not done yet: runs first"},
          {"kind": "text", "text": "5 Integrate", "color": "SelectionText", "background": "Selection", "align": "center", "padding": 4, "borderRadius": 4},
          {"kind": "text", "text": "6 Crop", "color": "DimText", "align": "center", "padding": 4},
          {"kind": "text", "text": "7 Plate solve", "color": "DimText", "align": "center", "padding": 4},
          {"kind": "text", "text": "8 SPCC", "color": "DimText", "align": "center", "padding": 4},
          {"kind": "text", "text": "9 Gradient", "color": "DimText", "align": "center", "padding": 4},
          {"kind": "text", "text": "10 Stretch", "color": "DimText", "align": "center", "padding": 4}
        ]
      },
      {
        "kind": "vstack", "side": "left", "size": 360, "gap": 8, "padding": 10, "background": "PanelBg",
        "children": [
          {"kind": "text", "text": "Step 5 of 10: Integrate", "fontSize": 15, "color": "HeaderText"},
          {"kind": "text", "text": "Stacks the registered frames into one master.", "color": "DimText"},
          {"kind": "dropdown", "bind": "gRejection", "label": "Rejection: Winsorized σ-clip", "options": ["Winsorized σ-clip", "Linear fit", "ESD", "None"]},
          {"kind": "dropdown", "bind": "gWeighting", "label": "Weighting: PSF signal", "options": ["PSF signal", "SNR", "Noise", "Equal"]},
          {"kind": "text", "text": "Before it integrates, it will:", "fontSize": 15, "color": "HeaderText", "padding": 2},
          {"kind": "grid", "columns": 2, "gap": 4, "children": [
            {"kind": "text", "text": "✓ Load", "color": "BodyText"},
            {"kind": "text", "text": "reuse", "color": "DimText"},
            {"kind": "text", "text": "↻ Calibrate", "color": "Warn"},
            {"kind": "text", "text": "re-run: new flats", "color": "Warn"},
            {"kind": "text", "text": "○ Analyse", "color": "BodyText"},
            {"kind": "text", "text": "run: not done", "color": "DimText"},
            {"kind": "text", "text": "○ Register", "color": "BodyText"},
            {"kind": "text", "text": "run: not done", "color": "DimText"}
          ]},
          {"kind": "checkbox", "bind": "runOn2", "label": "Run on until a step needs me"},
          {"kind": "dock", "height": 34, "children": [
            {"kind": "text", "side": "right", "size": 200, "text": "Integrate (runs 2–4 first)", "padding": 8, "background": "Accent", "color": "SelectionText", "borderRadius": 4, "align": "center"},
            {"kind": "spacer"}
          ]},
          {"kind": "text", "text": "About 22 min in all", "color": "DimText"}
        ]
      },
      {
        "kind": "dock", "side": "bottom", "size": 36, "padding": 8, "background": "PanelBg",
        "children": [
          {"kind": "text", "side": "right", "size": 220, "text": "Open as workflow to change ↗", "color": "Accent", "align": "far", "action": "goto:workflow"},
          {"kind": "text", "text": "✓ reused · ↻ runs again · ○ not done yet", "color": "BodyText"}
        ]
      },
      {
        "kind": "overlay",
        "children": [
          {"kind": "box", "color": "#0b0d12"},
          {"kind": "dock", "padding": 10, "children": [
            {"kind": "dock", "side": "top", "size": 32, "children": [
              {"kind": "text", "text": "Nothing integrated yet: showing L_0002 as loaded", "color": "#c8ccd4"}
            ]},
            {"kind": "text", "text": "image canvas: one raw light frame", "align": "center", "color": "#8a90a0"}
          ]}
        ]
      }
    ]
  }
}
