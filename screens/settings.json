{
  "id": "settings",
  "title": "Session settings",
  "root": {
    "kind": "dock",
    "background": "#101318",
    "children": [
      {
        "kind": "dock", "side": "top", "size": 48, "padding": 8, "background": "#1e232c",
        "children": [
          {"kind": "text", "side": "left", "size": 160, "text": "tianwen", "fontSize": 16, "color": "#ff5e00"},
          {"kind": "hstack", "side": "right", "size": 600, "gap": 6, "children": [
            {"kind": "text", "text": "Switch", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:home"},
            {"kind": "text", "text": "Confirm", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:confirm"},
            {"kind": "text", "text": "Busy", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:busy"},
            {"kind": "text", "text": "Segments", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:segments"},
            {"kind": "text", "text": "Settings", "width": "star", "height": "star", "align": "center", "background": "#302820", "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Equipment", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:equipment"}
          ]},
          {"kind": "hstack", "side": "right", "size": 166, "children": [
            {"kind": "text", "width": 150, "height": "star", "when": "running=false", "text": "▶  Start session", "align": "center", "background": "#ff5e00", "color": "#101318", "borderRadius": 6, "action": "set:running=true", "tooltip": "Starts the session; its settings lock while it runs"},
            {"kind": "text", "width": 150, "height": "star", "when": "running=true", "text": "■  Stop session", "align": "center", "background": "#171b22", "border": "#ff7a70", "color": "#ff7a70", "borderRadius": 6, "action": "set:running=false"},
            {"kind": "spacer", "width": "star"}
          ]},
          {"kind": "spacer"}
        ]
      },
      {
        "kind": "dock", "side": "left", "size": 220, "padding": 12, "background": "#171b22",
        "children": [
          {"kind": "text", "side": "top", "size": 44, "text": "Session", "fontSize": 18, "color": "#ff5e00"},
          {"kind": "vstack", "gap": 2, "children": [
            {"kind": "text", "text": "Cooling rates", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Guiding", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Horizon", "width": "star", "height": 32, "padding": 8, "background": "#302820", "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Meridian flip", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Focusing", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Imaging", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Mosaic", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6},
            {"kind": "text", "text": "Conditions", "width": "star", "height": 32, "padding": 8, "color": "#e2e6ec", "borderRadius": 6}
          ]}
        ]
      },
      {
        "kind": "vstack", "padding": 24, "gap": 10,
        "children": [
          {"kind": "hstack", "width": 640, "height": 40, "padding": 10, "gap": 8, "when": "running=true", "background": "#171b22", "border": "#ccac18", "borderRadius": 8, "children": [
            {"kind": "text", "text": "The session is running: its settings are locked until it stops.", "width": "star", "height": "star", "color": "#ccac18"}
          ]},

          {"kind": "text", "text": "Horizon", "fontSize": 15, "color": "#ff5e00"},
          {"kind": "vstack", "width": 640, "background": "#171b22", "borderRadius": 8, "children": [
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Minimum altitude", "color": "#e2e6ec"},
                {"kind": "text", "text": "Targets below this are not started", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "hstack", "width": 120, "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "−", "width": 30, "height": "star", "align": "center", "background": "#1e232c", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8},
                {"kind": "text", "text": "20°", "width": "star", "height": "star", "align": "center", "color": "#e2e6ec"},
                {"kind": "text", "text": "+", "width": 30, "height": "star", "align": "center", "background": "#1e232c", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Wait for a rising target", "color": "#e2e6ec"},
                {"kind": "text", "text": "Longest wait before moving on", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "hstack", "width": 120, "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "−", "width": 30, "height": "star", "align": "center", "background": "#1e232c", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8},
                {"kind": "text", "text": "30 min", "width": "star", "height": "star", "align": "center", "color": "#e2e6ec"},
                {"kind": "text", "text": "+", "width": 30, "height": "star", "align": "center", "background": "#1e232c", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Unpark mount", "color": "#e2e6ec"},
                {"kind": "text", "text": "Unpark a parked mount once the wait for dark is over", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "vstack", "width": 40, "height": "star", "when": "running=false", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "unpark_off=false", "width": 40, "height": 22, "padding": 2, "background": "#ff5e00", "borderRadius": 11, "action": "toggle:unpark_off", "tooltip": "Turn off", "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#ffffff", "borderRadius": 9}
                ]},
                {"kind": "hstack", "when": "unpark_off=true", "width": 40, "height": 22, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 11, "action": "toggle:unpark_off", "tooltip": "Turn on", "children": [
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#8b939f", "borderRadius": 9},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]},
              {"kind": "vstack", "width": 40, "height": "star", "when": "running=true", "tooltip": "Locked while the session runs", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "unpark_off=false", "width": 40, "height": 22, "padding": 2, "background": "#743614", "borderRadius": 11, "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#8b939f", "borderRadius": 9}
                ]},
                {"kind": "hstack", "when": "unpark_off=true", "width": 40, "height": 22, "padding": 2, "background": "#171b22", "border": "#2a3039", "borderRadius": 11, "children": [
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#3c444f", "borderRadius": 9},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]}
          ]},

          {"kind": "text", "text": "Focusing", "fontSize": 15, "color": "#ff5e00"},
          {"kind": "vstack", "width": 640, "background": "#171b22", "borderRadius": 8, "children": [
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Autofocus steps", "color": "#e2e6ec"},
                {"kind": "text", "text": "Positions sampled in one autofocus run", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "hstack", "width": 120, "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "−", "width": 30, "height": "star", "align": "center", "background": "#1e232c", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8},
                {"kind": "text", "text": "9", "width": "star", "height": "star", "align": "center", "color": "#e2e6ec"},
                {"kind": "text", "text": "+", "width": 30, "height": "star", "align": "center", "background": "#1e232c", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Refocus on a new target", "color": "#e2e6ec"},
                {"kind": "text", "text": "Run autofocus before the first frame of each target", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "vstack", "width": 40, "height": "star", "when": "running=false", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "refocus_off=false", "width": 40, "height": 22, "padding": 2, "background": "#ff5e00", "borderRadius": 11, "action": "toggle:refocus_off", "tooltip": "Turn off", "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#ffffff", "borderRadius": 9}
                ]},
                {"kind": "hstack", "when": "refocus_off=true", "width": 40, "height": 22, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 11, "action": "toggle:refocus_off", "tooltip": "Turn on", "children": [
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#8b939f", "borderRadius": 9},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]},
              {"kind": "vstack", "width": 40, "height": "star", "when": "running=true", "tooltip": "Locked while the session runs", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "refocus_off=false", "width": 40, "height": 22, "padding": 2, "background": "#743614", "borderRadius": 11, "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#8b939f", "borderRadius": 9}
                ]},
                {"kind": "hstack", "when": "refocus_off=true", "width": 40, "height": 22, "padding": 2, "background": "#171b22", "border": "#2a3039", "borderRadius": 11, "children": [
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#3c444f", "borderRadius": 9},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Save intermediate frames", "color": "#e2e6ec"},
                {"kind": "text", "text": "Keep every autofocus frame on disk", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "vstack", "width": 40, "height": "star", "when": "running=false", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "save_inter=true", "width": 40, "height": 22, "padding": 2, "background": "#ff5e00", "borderRadius": 11, "action": "toggle:save_inter", "tooltip": "Turn off", "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#ffffff", "borderRadius": 9}
                ]},
                {"kind": "hstack", "when": "save_inter=false", "width": 40, "height": 22, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 11, "action": "toggle:save_inter", "tooltip": "Turn on", "children": [
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#8b939f", "borderRadius": 9},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]},
              {"kind": "vstack", "width": 40, "height": "star", "when": "running=true", "tooltip": "Locked while the session runs", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "save_inter=true", "width": 40, "height": 22, "padding": 2, "background": "#743614", "borderRadius": 11, "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#8b939f", "borderRadius": 9}
                ]},
                {"kind": "hstack", "when": "save_inter=false", "width": 40, "height": 22, "padding": 2, "background": "#171b22", "border": "#2a3039", "borderRadius": 11, "children": [
                  {"kind": "spacer", "width": 18, "height": 18, "background": "#3c444f", "borderRadius": 9},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]}
          ]}
        ]
      }
    ]
  }
}
