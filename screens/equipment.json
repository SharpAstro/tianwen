{
  "id": "equipment",
  "title": "Equipment",
  "root": {
    "kind": "dock",
    "background": "#101318",
    "children": [
      {
        "kind": "dock", "side": "top", "size": 48, "padding": 8, "background": "#1e232c",
        "children": [
          {"kind": "text", "side": "left", "size": 160, "text": "tianwen", "fontSize": 16, "color": "#ff5e00"},
          {"kind": "hstack", "side": "right", "size": 560, "gap": 6, "children": [
            {"kind": "text", "text": "Switch", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:home"},
            {"kind": "text", "text": "Confirm", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:confirm"},
            {"kind": "text", "text": "Segments", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:segments"},
            {"kind": "text", "text": "Settings", "width": "star", "height": "star", "align": "center", "background": "#171b22", "color": "#e2e6ec", "borderRadius": 6, "action": "goto:settings"},
            {"kind": "text", "text": "Equipment", "width": "star", "height": "star", "align": "center", "background": "#302820", "color": "#e2e6ec", "borderRadius": 6}
          ]},
          {"kind": "spacer"}
        ]
      },
      {
        "kind": "vstack", "padding": 24, "gap": 10,
        "children": [
          {"kind": "text", "text": "Profile: Backyard rig", "height": 28, "fontSize": 15, "color": "#ff5e00"},
          {"kind": "vstack", "width": 760, "background": "#171b22", "borderRadius": 8, "children": [

            {"kind": "hstack", "width": "star", "height": 48, "padding": 12, "gap": 12, "children": [
              {"kind": "text", "text": "Mount", "width": 100, "height": "star", "color": "#8b939f"},
              {"kind": "text", "text": "Sky-Watcher EQ6-R Pro", "width": "star", "height": "star", "color": "#e2e6ec"},
              {"kind": "text", "when": "mount_off=false", "text": "Connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#4cc38a"},
              {"kind": "text", "when": "mount_off=true", "text": "Not connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#8b939f"},
              {"kind": "vstack", "width": 38, "height": "star", "padding": 4, "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "mount_off=false", "width": 30, "height": 16, "padding": 2, "background": "#ff5e00", "borderRadius": 8, "action": "toggle:mount_off", "tooltip": "Disconnect the mount", "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#ffffff", "borderRadius": 6}
                ]},
                {"kind": "hstack", "when": "mount_off=true", "width": 30, "height": 16, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 8, "action": "toggle:mount_off", "tooltip": "Connect the mount", "children": [
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#8b939f", "borderRadius": 6},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},

            {"kind": "hstack", "width": "star", "height": 48, "padding": 12, "gap": 12, "children": [
              {"kind": "text", "text": "Camera", "width": 100, "height": "star", "color": "#8b939f"},
              {"kind": "text", "text": "ZWO ASI2600MM Pro", "width": "star", "height": "star", "color": "#e2e6ec"},
              {"kind": "text", "when": "cam=false", "text": "Connected · −10 °C", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#4cc38a"},
              {"kind": "text", "when": "cam=confirm", "text": "Connected · −10 °C", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#4cc38a"},
              {"kind": "text", "when": "cam=off", "text": "Not connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#8b939f"},
              {"kind": "vstack", "width": 38, "height": "star", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "cam=false", "width": 38, "height": 24, "padding": 4, "children": [
                  {"kind": "hstack", "width": 30, "height": 16, "padding": 2, "background": "#ff5e00", "borderRadius": 8, "action": "set:cam=confirm", "tooltip": "Disconnect the camera: asks to warm the sensor first", "children": [
                    {"kind": "spacer", "width": "star"},
                    {"kind": "spacer", "width": 12, "height": 12, "background": "#ffffff", "borderRadius": 6}
                  ]}
                ]},
                {"kind": "hstack", "when": "cam=confirm", "width": 38, "height": 24, "padding": 4, "border": "#ccac18", "borderWidth": 2, "borderRadius": 12, "children": [
                  {"kind": "hstack", "width": 30, "height": 16, "padding": 2, "background": "#ff5e00", "borderRadius": 8, "action": "set:cam=false", "tooltip": "Keep the camera connected", "children": [
                    {"kind": "spacer", "width": "star"},
                    {"kind": "spacer", "width": 12, "height": 12, "background": "#ffffff", "borderRadius": 6}
                  ]}
                ]},
                {"kind": "hstack", "when": "cam=off", "width": 38, "height": 24, "padding": 4, "children": [
                  {"kind": "hstack", "width": 30, "height": 16, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 8, "action": "set:cam=false", "tooltip": "Connect the camera", "children": [
                    {"kind": "spacer", "width": 12, "height": 12, "background": "#8b939f", "borderRadius": 6},
                    {"kind": "spacer", "width": "star"}
                  ]}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "hstack", "when": "cam=confirm", "width": "star", "height": 52, "padding": 8, "gap": 8, "background": "#1e232c", "border": "#ccac18", "borderRadius": 6, "children": [
              {"kind": "text", "text": "The sensor is at −10 °C. Warm it before disconnecting?", "width": "star", "height": "star", "fontSize": 12, "color": "#ccac18"},
              {"kind": "text", "text": "Warm, then off", "width": 120, "height": "star", "align": "center", "fontSize": 12, "background": "#ff5e00", "color": "#101318", "borderRadius": 8, "action": "set:cam=off"},
              {"kind": "text", "text": "Off now", "width": 80, "height": "star", "align": "center", "fontSize": 12, "background": "#1e232c", "border": "#ff7a70", "color": "#ff7a70", "borderRadius": 8, "action": "set:cam=off"},
              {"kind": "text", "text": "Cancel", "width": 70, "height": "star", "align": "center", "fontSize": 12, "background": "#171b22", "border": "#3c444f", "color": "#e2e6ec", "borderRadius": 8, "action": "set:cam=false"}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},

            {"kind": "hstack", "width": "star", "height": 48, "padding": 12, "gap": 12, "tooltip": "Connecting: wait for it to finish", "children": [
              {"kind": "text", "text": "Focuser", "width": 100, "height": "star", "color": "#8b939f"},
              {"kind": "text", "text": "ZWO EAF", "width": "star", "height": "star", "color": "#e2e6ec"},
              {"kind": "text", "text": "Connecting…", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#7cc4ff"},
              {"kind": "vstack", "width": 38, "height": "star", "padding": 4, "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "width": 30, "height": 16, "padding": 2, "background": "#2a3039", "border": "#3c444f", "borderRadius": 8, "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#8b939f", "borderRadius": 6},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},

            {"kind": "hstack", "width": "star", "height": 48, "padding": 12, "gap": 12, "children": [
              {"kind": "text", "text": "Filter wheel", "width": 100, "height": "star", "color": "#8b939f"},
              {"kind": "text", "text": "ZWO EFW 7 × 36 mm", "width": "star", "height": "star", "color": "#e2e6ec"},
              {"kind": "text", "when": "efw_on=true", "text": "Connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#4cc38a"},
              {"kind": "text", "when": "efw_on=false", "text": "Not connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#8b939f"},
              {"kind": "vstack", "width": 38, "height": "star", "padding": 4, "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "efw_on=true", "width": 30, "height": 16, "padding": 2, "background": "#ff5e00", "borderRadius": 8, "action": "toggle:efw_on", "tooltip": "Disconnect the filter wheel", "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#ffffff", "borderRadius": 6}
                ]},
                {"kind": "hstack", "when": "efw_on=false", "width": 30, "height": 16, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 8, "action": "toggle:efw_on", "tooltip": "Connect the filter wheel", "children": [
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#8b939f", "borderRadius": 6},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},

            {"kind": "hstack", "width": "star", "height": 48, "padding": 12, "gap": 12, "children": [
              {"kind": "text", "text": "Guider", "width": 100, "height": "star", "color": "#8b939f"},
              {"kind": "text", "text": "Built-in guider", "width": "star", "height": "star", "color": "#e2e6ec"},
              {"kind": "text", "when": "guider_on=true", "text": "Connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#4cc38a"},
              {"kind": "text", "when": "guider_on=false", "text": "Not connected", "width": 170, "height": "star", "align": "far", "fontSize": 12, "color": "#8b939f"},
              {"kind": "vstack", "width": 38, "height": "star", "padding": 4, "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "guider_on=true", "width": 30, "height": 16, "padding": 2, "background": "#ff5e00", "borderRadius": 8, "action": "toggle:guider_on", "tooltip": "Disconnect the guider", "children": [
                  {"kind": "spacer", "width": "star"},
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#ffffff", "borderRadius": 6}
                ]},
                {"kind": "hstack", "when": "guider_on=false", "width": 30, "height": 16, "padding": 2, "background": "#1e232c", "border": "#3c444f", "borderRadius": 8, "action": "toggle:guider_on", "tooltip": "Connect the guider", "children": [
                  {"kind": "spacer", "width": 12, "height": 12, "background": "#8b939f", "borderRadius": 6},
                  {"kind": "spacer", "width": "star"}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]}
          ]},
          {"kind": "text", "text": "Only the switch connects or disconnects. The cooled camera asks first; its switch stays on until you choose.", "fontSize": 12, "color": "#8b939f"}
        ]
      }
    ]
  }
}
