{
  "id": "live",
  "title": "Session preview: live stack",
  "root": {
    "kind": "dock",
    "background": "ContentBg",
    "children": [
      {
        "kind": "dock", "side": "top", "padding": 8, "background": "HeaderBg", "size": 44,
        "children": [
          {"kind": "text", "side": "left", "size": 260, "text": "tianwen · session M42", "fontSize": 16, "color": "HeaderText"},
          {"kind": "text", "side": "right", "size": 160, "text": "Back to the app", "align": "far", "color": "Accent", "action": "goto:home"},
          {"kind": "text", "text": "Imaging · frame 47 of 60 · 120 s", "color": "BodyText", "align": "far"}
        ]
      },
      {
        "kind": "dock", "side": "bottom", "size": 40, "padding": 8, "background": "PanelBg",
        "children": [
          {"kind": "text", "side": "right", "size": 110, "text": "Save stack", "padding": 4, "background": "Accent", "color": "SelectionText", "borderRadius": 4, "align": "center"},
          {"kind": "text", "side": "right", "size": 90, "text": "Restart", "padding": 4, "background": "HeaderBg", "color": "BodyText", "borderRadius": 4, "align": "center", "tooltip": "Throw away the running stack and start again from the next frame"},
          {"kind": "text", "text": "46 frames · 1 h 32 m · 1 left out (frame 41, trailed) · SNR ×6.8", "color": "BodyText"}
        ]
      },
      {
        "kind": "overlay",
        "children": [
          {"kind": "box", "color": "#0b0d12"},
          {"kind": "dock", "padding": 10, "children": [
            {"kind": "dock", "side": "top", "size": 32, "children": [
              {"kind": "text", "side": "left", "size": 90, "text": "Frame", "align": "center", "background": "HeaderBg", "color": "BodyText", "borderRadius": 4, "action": "goto:session", "tooltip": "Show the last frame as it came off the camera"},
              {"kind": "text", "side": "left", "size": 110, "text": "Live stack", "align": "center", "background": "Selection", "color": "SelectionText", "borderRadius": 4},
              {"kind": "buttonGroup", "side": "right", "size": 260, "bind": "stretch", "options": ["Linear", "Auto STF", "Histogram"]},
              {"kind": "spacer"}
            ]},
            {"kind": "text", "text": "image canvas: the stack of 46 frames", "align": "center", "color": "#8a90a0"}
          ]}
        ]
      }
    ]
  }
}
