                {"kind": "text", "text": "Off", "width": "star", "height": "star", "align": "center", "color": "#3c444f"},
                {"kind": "text", "text": "Auto", "width": "star", "height": "star", "align": "center", "background": "#2a3039", "color": "#8b939f", "borderRadius": 7},
                {"kind": "text", "text": "Manual", "width": "star", "height": "star", "align": "center", "color": "#3c444f"}
              ]},
              {"kind": "text", "text": "Locked", "fontSize": 12, "color": "#8b939f", "align": "center", "width": "star"}
            ]},
            {"kind": "vstack", "width": 250, "height": 84, "padding": 12, "gap": 10, "background": "#171b22", "borderRadius": 8, "children": [
              {"kind": "hstack", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "border": "#ff5e00", "borderWidth": 2, "borderRadius": 9, "children": [
                {"kind": "text", "text": "Off", "width": "star", "height": "star", "align": "center", "color": "#8b939f"},
                {"kind": "text", "text": "Auto", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                {"kind": "text", "text": "Manual", "width": "star", "height": "star", "align": "center", "color": "#8b939f"}
              ]},
              {"kind": "text", "text": "Keyboard focus (← → move)", "fontSize": 12, "color": "#8b939f", "align": "center", "width": "star"}
            ]}
          ]},

          {"kind": "text", "text": "In tianwen (click them)", "fontSize": 15, "color": "#ff5e00"},
          {"kind": "vstack", "width": 640, "background": "#171b22", "borderRadius": 8, "children": [
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
