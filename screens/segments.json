                {"kind": "hstack", "when": "stretch=hist", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Linear", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:stretch=false"},
                  {"kind": "text", "text": "Auto STF", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:stretch=auto"},
                  {"kind": "text", "text": "Histogram", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Recenter", "color": "#e2e6ec"},
                {"kind": "text", "text": "Planetary capture", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "vstack", "width": 300, "height": "star", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "recenter=false", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Off", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "Auto", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:recenter=auto"},
                  {"kind": "text", "text": "Manual", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:recenter=manual"}
                ]},
                {"kind": "hstack", "when": "recenter=auto", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Off", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:recenter=false"},
                  {"kind": "text", "text": "Auto", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "Manual", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:recenter=manual"}
                ]},
                {"kind": "hstack", "when": "recenter=manual", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Off", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:recenter=false"},
                  {"kind": "text", "text": "Auto", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:recenter=auto"},
                  {"kind": "text", "text": "Manual", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]},
            {"kind": "spacer", "width": "star", "height": 1, "background": "#2a3039"},
            {"kind": "hstack", "width": "star", "height": 56, "padding": 12, "gap": 12, "children": [
              {"kind": "vstack", "width": "star", "height": "star", "gap": 2, "children": [
                {"kind": "text", "text": "Theme", "color": "#e2e6ec"},
                {"kind": "text", "text": "Home board header", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "vstack", "width": 300, "height": "star", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "theme=false", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Light", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=light"},
                  {"kind": "text", "text": "Dark", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "Night", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=night"},
                  {"kind": "text", "text": "System", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=system"}
                ]},
                {"kind": "hstack", "when": "theme=light", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Light", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "Dark", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=false"},
                  {"kind": "text", "text": "Night", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=night"},
                  {"kind": "text", "text": "System", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=system"}
                ]},
                {"kind": "hstack", "when": "theme=night", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Light", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=light"},
                  {"kind": "text", "text": "Dark", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=false"},
                  {"kind": "text", "text": "Night", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "System", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=system"}
                ]},
                {"kind": "hstack", "when": "theme=system", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Light", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=light"},
                  {"kind": "text", "text": "Dark", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=false"},
                  {"kind": "text", "text": "Night", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:theme=night"},
                  {"kind": "text", "text": "System", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7}
                ]},
                {"kind": "spacer", "height": "star"}
              ]}
            ]}
          ]}
        ]
      }
    ]
  }
}
