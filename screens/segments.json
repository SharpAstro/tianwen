                {"kind": "text", "text": "Frame preview", "fontSize": 12, "color": "#8b939f"}
              ]},
              {"kind": "vstack", "width": 300, "height": "star", "children": [
                {"kind": "spacer", "height": "star"},
                {"kind": "hstack", "when": "stretch=false", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Linear", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "Auto STF", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:stretch=auto"},
                  {"kind": "text", "text": "Histogram", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:stretch=hist"}
                ]},
                {"kind": "hstack", "when": "stretch=auto", "width": "star", "height": 30, "padding": 2, "gap": 2, "background": "#1e232c", "borderRadius": 9, "children": [
                  {"kind": "text", "text": "Linear", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:stretch=false"},
                  {"kind": "text", "text": "Auto STF", "width": "star", "height": "star", "align": "center", "background": "#3c444f", "color": "#e2e6ec", "borderRadius": 7},
                  {"kind": "text", "text": "Histogram", "width": "star", "height": "star", "align": "center", "color": "#8b939f", "action": "set:stretch=hist"}
