<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tianwen-fits</AssemblyName>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/MilkyWay.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Version)' == '' ">
    <Version Condition=" '$(VersionSuffix)' != '' And $(VersionSuffix[0]) != '+'">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Version Condition=" '$(VersionSuffix)' != '' And $(VersionSuffix[0]) == '+'">$(VersionPrefix)$(VersionSuffix)</Version>
    <Version Condition=" '$(Version)' == '' ">$(VersionPrefix)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Native" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- The single-instance gate. Shared with the other viewer in the family rather than written
       twice, which is why it lives in a package and not in this project. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\AppShell\src\SharpAstro.AppShell\SharpAstro.AppShell.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.AppShell" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.UI.Shared\TianWen.UI.Shared.csproj" />
    <!-- AI enhancers (SAS ONNX + RC-Astro CLI wrappers) for the viewer's Enhance action. -->
    <ProjectReference Include="..\TianWen.AI.Imaging\TianWen.AI.Imaging.csproj" />
  </ItemGroup>

  <Import Project="..\VCRuntimeRedist.targets" />

  <!-- LINKED, not copied: the file lives in TianWen.UI.Gui/Fonts, and a second copy in the repo would be
       a second thing to keep in step plus 0.72 MB of duplicate LFS. Bundling it at all is what makes this
       app's text identical on every host. Without it the viewer resolved the platform monospace, which on
       Windows is Consolas, and Consolas carries no check mark, so a tick in a label drew NOTHING at all.
       The licence travels in FONT-LICENSES.txt at the repo root.

       The EMOJI face is here for the same reason, and was missing for longer: BundledFonts
       resolves both roles, and with no bundled colour face this app fell through to whatever the
       platform ships, which is a Windows answer (Segoe UI Emoji) and often no answer at all on
       Linux. That cost nothing visible while DejaVu happened to cover every mark the viewer drew,
       and everything the moment one of them was a pictograph Unicode says is drawn in colour.
       (No double hyphen anywhere above: XML forbids it inside a comment, which is a build error here.) -->
  <ItemGroup>
    <Content Include="..\TianWen.UI.Gui\Fonts\DejaVuSans.ttf" Link="Fonts\DejaVuSans.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TianWen.UI.Gui\Fonts\Noto-COLRv1.ttf" Link="Fonts\Noto-COLRv1.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
