<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <!-- DIR.Lib's SignalDirectory source generator (emits the DEBUG-only inspector signal directory over
         this assembly's *Signal types). Analyzers do NOT flow transitively through a ProjectReference, so
         it is referenced directly for local (in-tree) builds; the DIR.Lib PACKAGE bundles it under
         analyzers/, so the PackageReference path below gets it automatically. -->
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib.SourceGenerators\DIR.Lib.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>

  <!-- The house rule for testing what is not public: an internal member plus this, never reflection.
       AstroImageDocument.InheritColorCalibration is internal because only the enhance and display-carry
       paths may set a calibration they did not measure; DisplayCarryTests drives it to check that a fit
       solved on one frame of a run reaches the rest. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TianWen.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.Lib\TianWen.Lib.csproj" />
    <!-- RemoteRigConnection owns a RemoteSessionMirror and hands it to a ViewContext as the context's
         ISessionTelemetry, so the tabs render a rig unchanged (docs/plans/remote-profile.md P4). -->
    <ProjectReference Include="..\TianWen.RemoteClient\TianWen.RemoteClient.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- LAN.Lib: GuiAppState.PeerTable + EquipmentTab's "rigs nearby" list read IPeerTable/LanPeer
       (docs/plans/remote-profile.md). Sibling repo's csproj lives at ../LAN.Lib/src/LAN.Lib/LAN.Lib.csproj. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\LAN.Lib\src\LAN.Lib\LAN.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="LAN.Lib" />
  </ItemGroup>

  <!-- SharpAstro.Png + SharpAstro.Color.Icc: MasterPreviewRenderer emits the
       cICP-tagged PNG via PngWriter; the cICP enums (ColorPrimaries /
       TransferFunction / MatrixCoefficients) come from SharpAstro.Color.Icc. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj" />
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Color.Icc\SharpAstro.Color.Icc.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Png" />
    <PackageReference Include="SharpAstro.Color.Icc" />
  </ItemGroup>
  <!-- Icon marks are baked from font glyphs into committed tables by tools/bake-icons.ps1, one table per
       recipe (BakedFile is the table it generates, relative to this project). Baked rather than drawn from
       a font at runtime because a missing glyph draws NOTHING rather than a placeholder, a colour glyph
       cannot be tinted so it cannot dim with its label, and the runtime result varies with whichever
       face the host resolved. Mirrors the shader bake in TianWen.UI.Shared, including the warning below. -->
  <ItemGroup>
    <IconRecipe Include="icons.recipe" BakedFile="BakedIcons.g.cs" />
    <IconRecipe Include="sky-icons.recipe" BakedFile="SkyIcons.g.cs" />
  </ItemGroup>

  <!-- Warn (never fail) when a recipe is newer than the table it generates by more than
       StaleBakeToleranceSeconds, or the table is missing, so an edit that forgets to re-bake is caught
       in the build log instead of silently shipping a stale mark. Each recipe is judged on its own.
       The tolerance exists because a git checkout writes files in directory order, the recipe often
       last: a fresh clone measured the recipe 17 ms newer than its byte-correct table, which a plain
       Inputs/Outputs comparison reported as stale on every clone. A forgotten re-bake is an edit made
       minutes or days after the last bake, well past the tolerance. A timestamp is still the weaker of
       the two available checks: the bake is byte-reproducible, so CI runs
       'pwsh tools/bake-icons.ps1 -Verify' over both recipes and catches a HAND-EDITED table too, which a
       timestamp cannot. This one is here because it costs nothing and needs neither the tool nor the
       network. -->
  <PropertyGroup>
    <StaleBakeToleranceSeconds Condition="'$(StaleBakeToleranceSeconds)' == ''">60</StaleBakeToleranceSeconds>
  </PropertyGroup>

  <Target Name="WarnStaleBakedIcons" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_IconRecipeCheck Include="@(IconRecipe)">
        <BakedPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '%(IconRecipe.BakedFile)'))</BakedPath>
      </_IconRecipeCheck>
      <_IconRecipeCheck>
        <BakedExists>$([System.IO.File]::Exists('%(BakedPath)'))</BakedExists>
        <AheadTicks>$([MSBuild]::Subtract($([System.IO.File]::GetLastWriteTime('%(FullPath)').ToUniversalTime().Ticks), $([System.IO.File]::GetLastWriteTime('%(BakedPath)').ToUniversalTime().Ticks)))</AheadTicks>
      </_IconRecipeCheck>
    </ItemGroup>
    <PropertyGroup>
      <_StaleBakeToleranceTicks>$([MSBuild]::Multiply($(StaleBakeToleranceSeconds), 10000000))</_StaleBakeToleranceTicks>
    </PropertyGroup>
    <Warning Code="TWIC0001"
             Condition="'%(_IconRecipeCheck.BakedExists)' != 'True'"
             Text="%(_IconRecipeCheck.Identity) has no baked table (%(_IconRecipeCheck.BakedFile) is missing); run 'pwsh tools/bake-icons.ps1' and commit the generated table." />
    <Warning Code="TWIC0001"
             Condition="'%(_IconRecipeCheck.BakedExists)' == 'True' and %(_IconRecipeCheck.AheadTicks) &gt; $(_StaleBakeToleranceTicks)"
             Text="%(_IconRecipeCheck.Identity) is newer than %(_IconRecipeCheck.BakedFile) by more than $(StaleBakeToleranceSeconds) s; re-run 'pwsh tools/bake-icons.ps1' and commit the regenerated table." />
  </Target>

</Project>
