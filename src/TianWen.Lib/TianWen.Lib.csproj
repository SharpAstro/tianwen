<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Derived; the version itself lives in src/Directory.Build.props (VersionMajorMinor). -->
    <AssemblyVersion>$(VersionMajorMinor).0.0</AssemblyVersion>
    <PackageID>TianWen.Lib</PackageID>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- A file, not a PackageLicenseExpression: the terms are AGPL-3.0-or-later PLUS the section-7
         additional permission in LICENSE.EXCEPTION (which lets TianWen link the proprietary vendor
         camera/mount SDKs), and SPDX has no identifier for a bespoke exception. LICENSE.EXCEPTION is
         packed alongside; both must travel with the package or the terms are only half stated. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/tianwen.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Lightweight build gate. A "lightweight" build drops heavy, deep-field data a small-payload
       host does not need (today: the ~30 MB Tycho-2 star catalog, tyc2.bin.lz) - the browser/WASM
       app turns it on. Set as a GLOBAL property on the publish command: `dotnet publish ...
       -p:Lightweight=true`. A global property flows into every project in the build graph, including
       this one built as a transitive ProjectReference; a property set only on the consuming Blazor
       project does NOT reach here (and the target RID is not browser-wasm during a ProjectReference
       build either). ReadTycho2Bulk no-ops gracefully when the manifest entry is absent, so no code
       change is needed. Default (false) = full build, everything embedded. The Tycho-dependent
       cross-ref maps (hip_to_tyc/hd_to_tyc, dead without tyc2) are candidates to join this gate. -->
  <PropertyGroup>
    <Lightweight Condition="'$(Lightweight)' == ''">false</Lightweight>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MAttiaverga.OpenNGC/**" />
    <Compile Remove="OpenNGC/**" />
    <Compile Remove="Astrometry/Catalogs/*.json" />
    <Compile Remove="Astrometry/Catalogs/tmp-data/**" />
    <EmbeddedResource Remove="MAttiaverga.OpenNGC/**" />
    <EmbeddedResource Remove="OpenNGC/**" />
    <EmbeddedResource Remove="Astrometry/Catalogs/tmp-data/**" />
    <None Remove="OpenNGC/**" />
    <None Remove="MAttiaverga.OpenNGC/**" />
    <None Remove=".git*." />
    <None Remove="Astrometry/Catalogs/tmp-data/**" />
    <EmbeddedResource Remove="Astrometry/Catalogs/*.json" />
    <EmbeddedResource Include="Astrometry/Catalogs/*.lz" WithCulture="false" />
    <!-- A lightweight build (-p:Lightweight=true, e.g. the browser/WASM app) gates off the ~30 MB
         Tycho-2 star catalog (tyc2.bin.lz), keeping the download small: the WebGL atlas uses the
         bright-star (HR) set and the planner is DSO-only. ReadTycho2Bulk (CelestialObjectDB) already
         no-ops gracefully when the tyc2 manifest entry is absent, so this needs no code change. The
         tiny GSC-bounds + pm-sidecar companions stay embedded but unread (harmless). Default keeps it. -->
    <!-- Tycho-2 ships EXPANDED, and the .lz is never embedded. tyc2.bin is already the format the
         runtime reads (stream count, per-GSC-region offset table, region-major 17-byte records read
         straight out of a flat span); lzip was only ever the container, and its ~4 MiB members must
         be decoded WHOLE, so reaching one region's ~59 KB cost decompressing all 43.5 MB at init.
         Expanded, GetManifestResourceStream hands back an UnmanagedMemoryStream over the mapped
         image, so a region query touches only its own pages. The .lz stays the COMMITTED artifact
         and ExpandTycho2 expands it into obj/ on the way past: the repository has no LFS budget
         to spend, and .gitattributes routes both *.lz and a bare tyc2.bin to LFS. -->
    <EmbeddedResource Remove="Astrometry/Catalogs/tyc2.bin.lz" />
    <!-- Tracked .gz/.bin.gz catalog files: committed in git (filter_curves,
         hd_hip_cross, pickles_sed, sensor_qe, simbad_merge), so they exist at
         project-evaluation time. Listed explicitly because the previous
         "Astrometry/Catalogs/*.gz" wildcard races against PreprocessCatalogs
         on a fresh worktree: the glob expands at project-load time before
         the target generates Barnard.gs.gz / NGC.gs.gz / etc., so first-build
         DLLs silently shipped without 15 of the 30 catalogs embedded. The
         generated outputs of PreprocessCatalogs are now injected by the
         EmbedCatalogOutputs target below so they get picked up deterministically
         regardless of disk state at evaluation time. -->
    <EmbeddedResource Include="Astrometry/Catalogs/filter_curves.gs.gz" WithCulture="false" />
    <EmbeddedResource Include="Astrometry/Catalogs/hd_hip_cross.bin.gz" WithCulture="false" />
    <EmbeddedResource Include="Astrometry/Catalogs/pickles_sed.gs.gz" WithCulture="false" />
    <EmbeddedResource Include="Astrometry/Catalogs/sensor_qe.gs.gz" WithCulture="false" />
    <EmbeddedResource Include="Astrometry/Catalogs/simbad_merge.bin.gz" WithCulture="false" />
    <!-- Fake planetary capture: NASA/ESA Hubble OPAL 2024 Jupiter (public domain), cropped to the disk
         + stored as a gzipped raw RGB blob (8-byte LE width/height header + row-major RGB). The fake
         camera's video path scales it to the correct angular size and runs it through the optical chain.
         Source: https://science.nasa.gov/asset/hubble/jupiter-opal-2024/ -->
    <EmbeddedResource Include="Devices/Fake/Data/jupiter.rgb.gz" WithCulture="false" />
    <!-- Catalogs migrated to the ASCII-separated .gs.gz format: keep the .json.lz on
         disk as preprocessor input but exclude it from the assembly so only the
         faster path ships. See docs/plans/catalog-binary-format.md. -->
    <EmbeddedResource Remove="Astrometry/Catalogs/HR.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/GUM.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/RCW.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/LDN.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/Dobashi.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/Sh.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/Barnard.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/Ced.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/CG.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/vdB.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/DG.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/HH.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/Cl.json.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/NGC.csv.lz" />
    <EmbeddedResource Remove="Astrometry/Catalogs/NGC.addendum.csv.lz" />
    <CatalogPreprocess Include="Astrometry/Catalogs/HR.json.lz">
      <OutputPath>Astrometry/Catalogs/HR.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/GUM.json.lz">
      <OutputPath>Astrometry/Catalogs/GUM.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/RCW.json.lz">
      <OutputPath>Astrometry/Catalogs/RCW.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/LDN.json.lz">
      <OutputPath>Astrometry/Catalogs/LDN.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/Dobashi.json.lz">
      <OutputPath>Astrometry/Catalogs/Dobashi.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/Sh.json.lz">
      <OutputPath>Astrometry/Catalogs/Sh.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/Barnard.json.lz">
      <OutputPath>Astrometry/Catalogs/Barnard.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/Ced.json.lz">
      <OutputPath>Astrometry/Catalogs/Ced.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/CG.json.lz">
      <OutputPath>Astrometry/Catalogs/CG.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/vdB.json.lz">
      <OutputPath>Astrometry/Catalogs/vdB.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/DG.json.lz">
      <OutputPath>Astrometry/Catalogs/DG.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/HH.json.lz">
      <OutputPath>Astrometry/Catalogs/HH.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/Cl.json.lz">
      <OutputPath>Astrometry/Catalogs/Cl.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/NGC.csv.lz">
      <OutputPath>Astrometry/Catalogs/NGC.gs.gz</OutputPath>
    </CatalogPreprocess>
    <CatalogPreprocess Include="Astrometry/Catalogs/NGC.addendum.csv.lz">
      <OutputPath>Astrometry/Catalogs/NGC.addendum.gs.gz</OutputPath>
    </CatalogPreprocess>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="True" PackagePath="/" />
    <None Include="../../LICENSE.EXCEPTION" Pack="True" PackagePath="/" />
    <None Include="../../NOTICE" Pack="True" PackagePath="/" />
    <None Include="../.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <!-- Convert source .json.lz catalogs to the ASCII-separated .gs.gz format consumed
       by AsciiRecordReader at runtime. Re-runs only when an input is newer than its
       output. See tools/preprocess-catalog.ps1 + docs/plans/catalog-binary-format.md.
       DependsOnTargets="ResolveReferences" ensures the Lzip.Lib reference (the managed
       lzip decoder that replaced the external `lzip -dc`) is resolved + copied, so we can
       hand its dll path to the script via -LzipAssembly (works for both the sibling
       ProjectReference and the NuGet PackageReference). -->
  <!-- Expand tyc2.bin.lz into obj/ and embed THAT. See the EmbeddedResource Remove above for why
       the container is the whole problem. Gated off for a lightweight build exactly as the .lz was:
       the browser does not want 43.5 MB in its bundle, and does not need it. pages.yml stages the
       committed .lz as same-origin static assets (whole-catalogue fallback plus 166 region-aligned
       members), reading the source tree directly, so that pipeline is untouched by any of this. -->
  <PropertyGroup Condition="'$(Lightweight)' != 'true'">
    <_Tycho2Lz>$(MSBuildThisFileDirectory)Astrometry/Catalogs/tyc2.bin.lz</_Tycho2Lz>
    <!-- BaseIntermediateOutputPath (obj\), NOT IntermediateOutputPath (obj\<config>\<tfm>\): the
         latter is defined by the common TARGETS, which import after this body, so it evaluates EMPTY
         here and the 43.5 MB expansion lands in the project ROOT. That is not a cosmetic slip:
         .gitattributes routes a bare tyc2.bin to LFS, so a stray `git add -A` would commit it to a
         repository with no LFS budget to spend. obj\ is gitignored, and the content does not vary by
         configuration, so sharing one copy across them is right anyway. -->
    <_Tycho2Expanded>$(BaseIntermediateOutputPath)tyc2.bin</_Tycho2Expanded>
    <!-- The same treatment for the two HIP/HD to TYC cross-reference arrays, for the same reason and
         with the same LFS-neutrality: the .lz files stay exactly as committed and are read-only
         inputs, while the expansion lands in obj/ and is never a tracked object.
         Measured 2026-08-31, cold init: LoadCrossRefBinFile spent 274.7 ms decompressing these two
         (83.9 hip + 190.8 hd) against 131.4 ms actually decoding their records, and the main thread
         blocks ~228 ms on the task at the tycho2-cross-ref-join phase, the largest item in a 530 ms
         init. tyc2.bin got expanded and these did not, which is the whole of the gap; the code
         comment calling them "cheap to decompress" was the assumption that hid it.
         Expanded they are 0.57 + 1.71 = 2.29 MiB, against the 43.5 MiB expansion already accepted
         next door, so this is a cheap trade. The .lz stay embedded as the fallback rather than being
         Removed like tyc2's: at ~1.2 MiB they cost little, and keeping them means no build shape,
         Lightweight included, can silently lose the HD/HIP cross-references. -->
    <_HipToTycLz>$(MSBuildThisFileDirectory)Astrometry/Catalogs/hip_to_tyc.bin.lz</_HipToTycLz>
    <_HipToTycExpanded>$(BaseIntermediateOutputPath)hip_to_tyc.bin</_HipToTycExpanded>
    <_HdToTycLz>$(MSBuildThisFileDirectory)Astrometry/Catalogs/hd_to_tyc.bin.lz</_HdToTycLz>
    <_HdToTycExpanded>$(BaseIntermediateOutputPath)hd_to_tyc.bin</_HdToTycExpanded>
  </PropertyGroup>

  <Target Name="ExpandTycho2"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveReferences"
          Condition="'$(Lightweight)' != 'true' AND Exists('$(_Tycho2Lz)')"
          Inputs="$(_Tycho2Lz)"
          Outputs="$(_Tycho2Expanded)">
    <PropertyGroup>
      <_LzipLibDllTyc>@(ReferenceCopyLocalPaths->WithMetadataValue('FileName','Lzip.Lib')->WithMetadataValue('Extension','.dll'))</_LzipLibDllTyc>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../tools/expand-tycho2.ps1&quot; -LzPath &quot;$(_Tycho2Lz)&quot; -OutPath &quot;$(_Tycho2Expanded)&quot; -LzipAssembly &quot;$(_LzipLibDllTyc)&quot;" />
  </Target>

  <!-- Registered in its own ungated target so the embed set is the same on an incremental build as
       on a clean one, mirroring EmbedCatalogOutputs. LogicalName is stated explicitly because the
       file lives in obj/, so the name MSBuild would derive from its path is not the one
       ReadTycho2Bulk looks for. -->
  <Target Name="EmbedTycho2Expanded"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ExpandTycho2"
          Condition="'$(Lightweight)' != 'true' AND Exists('$(_Tycho2Lz)')">
    <ItemGroup>
      <EmbeddedResource Include="$(_Tycho2Expanded)"
                        LogicalName="TianWen.Lib.Astrometry.Catalogs.tyc2.bin"
                        WithCulture="false" />
    </ItemGroup>
  </Target>

  <!-- Mirrors ExpandTycho2 / EmbedTycho2Expanded for the cross-reference arrays. expand-tycho2.ps1
       is already generic over (-LzPath, -OutPath), so this reuses it rather than adding a script. -->
  <Target Name="ExpandTycho2CrossRef"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveReferences"
          Condition="'$(Lightweight)' != 'true' AND Exists('$(_HipToTycLz)') AND Exists('$(_HdToTycLz)')"
          Inputs="$(_HipToTycLz);$(_HdToTycLz)"
          Outputs="$(_HipToTycExpanded);$(_HdToTycExpanded)">
    <PropertyGroup>
      <_LzipLibDllXref>@(ReferenceCopyLocalPaths->WithMetadataValue('FileName','Lzip.Lib')->WithMetadataValue('Extension','.dll'))</_LzipLibDllXref>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../tools/expand-tycho2.ps1&quot; -LzPath &quot;$(_HipToTycLz)&quot; -OutPath &quot;$(_HipToTycExpanded)&quot; -LzipAssembly &quot;$(_LzipLibDllXref)&quot;" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../tools/expand-tycho2.ps1&quot; -LzPath &quot;$(_HdToTycLz)&quot; -OutPath &quot;$(_HdToTycExpanded)&quot; -LzipAssembly &quot;$(_LzipLibDllXref)&quot;" />
  </Target>

  <!-- Ungated so the embed set is identical incremental vs clean, as for EmbedTycho2Expanded.
       LogicalName is explicit because these live in obj/, so the name MSBuild would derive from the
       path is not the one LoadCrossRefBinFile looks for. -->
  <Target Name="EmbedTycho2CrossRefExpanded"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ExpandTycho2CrossRef"
          Condition="'$(Lightweight)' != 'true' AND Exists('$(_HipToTycLz)') AND Exists('$(_HdToTycLz)')">
    <ItemGroup>
      <EmbeddedResource Include="$(_HipToTycExpanded)"
                        LogicalName="TianWen.Lib.Astrometry.Catalogs.hip_to_tyc.bin"
                        WithCulture="false" />
      <EmbeddedResource Include="$(_HdToTycExpanded)"
                        LogicalName="TianWen.Lib.Astrometry.Catalogs.hd_to_tyc.bin"
                        WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="PreprocessCatalogs"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveReferences"
          Inputs="@(CatalogPreprocess)"
          Outputs="@(CatalogPreprocess->'%(OutputPath)')">
    <PropertyGroup>
      <_LzipLibDll>@(ReferenceCopyLocalPaths->WithMetadataValue('FileName','Lzip.Lib')->WithMetadataValue('Extension','.dll'))</_LzipLibDll>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\tools\preprocess-catalog.ps1&quot; -Input &quot;%(CatalogPreprocess.FullPath)&quot; -Output &quot;$(MSBuildThisFileDirectory)%(CatalogPreprocess.OutputPath)&quot; -LzipAssembly &quot;$(_LzipLibDll)&quot;" />
  </Target>

  <!-- Register the generated .gs.gz outputs as EmbeddedResource items.
       Separate target with no Inputs/Outputs gate so it runs on every build
       (incremental and clean), making the embed set deterministic. The
       DependsOnTargets ensures PreprocessCatalogs has generated the files
       before this target collects them. -->
  <Target Name="EmbedCatalogOutputs"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="PreprocessCatalogs">
    <ItemGroup>
      <EmbeddedResource Include="@(CatalogPreprocess->'%(OutputPath)')" WithCulture="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.Lib.SourceGenerators\TianWen.Lib.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="DotNext.Threading" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="FC.SDK.Raw" />
    <PackageReference Include="GeoTimeZone" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="FC.SDK" />
    <PackageReference Include="ZWOptical.SDK" />
    <!-- Every device driver in Devices/ does `using TianWen.DAL`. Declaring it
         directly here (rather than relying on the transitive via QHYCCD.SDK /
         ZWOptical.SDK) is the honest "this project imports it" signal; same
         pattern as the SharpAstro codec direct refs below. -->
    <PackageReference Include="TianWen.DAL" />
  </ItemGroup>

  <!-- Image.Import / Image.Export import SharpAstro.Tiff + .Exif directly. DIR.Lib
       4.0 dropped its phantom codec dependencies (a leftover from the Phase 1
       extraction), so tianwen declares them itself: sibling ProjectReference during
       local dev, NuGet PackageReference for CI / package builds. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Tiff\SharpAstro.Tiff.csproj" />
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Exif\SharpAstro.Exif.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Tiff" />
    <PackageReference Include="SharpAstro.Exif" />
  </ItemGroup>

  <!-- SharpAstro.Jxr: the jxrlib-faithful re-port. Image.WriteJxrAsync uses the
       JxrImageCodec.EncodeGrayF32 / EncodeRgbF16 API (BD8/16/16F/32F + arbitrary
       dimensions, oracle-validated bit-exact vs jxrlib). Shipped to NuGet in the
       3.1.* codec family, so both the local sibling (ProjectReference) and the
       published package (PackageReference, version 3.1.* below) expose the new API. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Jxr\SharpAstro.Jxr.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Jxr" />
  </ItemGroup>

  <!-- SharpAstro.Exr: pure-managed OpenEXR read+write. Image.WriteExrAsync uses the
       ExrImageCodec.EncodeMonoFloat / EncodeRgbHalf API (HDR float, value-exact vs
       OpenEXR). Joined the 3.2.* lockstep family, so both the local sibling and the
       published package (version 3.2.* below) expose it. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Exr\SharpAstro.Exr.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Exr" />
  </ItemGroup>

  <!-- SharpAstro.Png: MasterPreviewRenderer's 16-bit PNG preview encode
       (PngWriter.EncodeRgba16 + cICP colour signalling, incl. HDR10/PQ via
       Bt2020Pq). The renderer moved down from TianWen.UI.Abstractions so the
       stacking post-processor can produce previews in-pipeline; this brings its
       PNG encoder dependency with it. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Png" />
  </ItemGroup>

  <!-- SharpAstro.Codecs: the image-decode facade. Image.Import's TryReadImageFile
       falls back to ImageCodecs.TryDecode for the raster formats tianwen writes but
       has no bespoke reader for (PNG / JPEG / JPEG XR / OpenEXR / JPEG XL) so a
       preview or HDR master it exported can be reopened. TIFF stays on the bespoke
       TryReadTiff path (it extracts EXIF -> ImageMeta the facade doesn't carry).
       Pulls the codec members it wraps in transitively; all on the 3.5.* lockstep. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Codecs\SharpAstro.Codecs.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Codecs" />
  </ItemGroup>

  <!-- SharpAstro.Jpeg + SharpAstro.Jpeg.GainMap: the Ultra HDR (gain-map JPEG) WRITE
       path for the stacking / render preview. MasterPreviewRenderer emits an
       hdrgm-1.0 / Android Ultra HDR JPEG via JpegGainMap.Compute (fit the gain map
       from an aligned HDR-linear/SDR pair) + JpegEncoder.Encode (baseline sequential,
       shipped in Codecs 3.6) + JpegGainMap.Assemble (splice GContainer XMP + MPF).
       Both are already pulled in transitively by SharpAstro.Codecs (gain-map decode
       lives in the facade registry), but tianwen references them directly since it
       calls the encode API, matching the direct-ref convention of the Tiff/Png/Exr
       codecs above. All on the 3.6.* lockstep. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Jpeg\SharpAstro.Jpeg.csproj" />
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Jpeg.GainMap\SharpAstro.Jpeg.GainMap.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Jpeg" />
    <PackageReference Include="SharpAstro.Jpeg.GainMap" />
  </ItemGroup>

  <!-- DIR.Lib: TiffWriter + PngWriter on the production path (Image.Export.cs). -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>

  <!-- FITS.Lib: FITS read/write under Image.Fits.cs. Sibling repo's csproj
       lives at ../FITS.Lib/CSharpFITS/CSharpFITS.csproj (no src/Lib/Lib pattern). -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\FITS.Lib\CSharpFITS\CSharpFITS.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="FITS.Lib" />
  </ItemGroup>

  <!-- SER.Lib: SER planetary-video reader (SharpAstro.Ser). Imaging/SerImageBridge.cs maps SER
       frames -> Image; the viewer's SerPreviewSource (TianWen.UI.Abstractions) gets it transitively.
       Sibling repo's csproj lives at ../SER.Lib/src/SER.Lib/SER.Lib.csproj. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\SER.Lib\src\SER.Lib\SER.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SER.Lib" />
