<linker>
  <!--
    Feature switches TianWen.Lib.EmbeddedData.<group>, one for each kind of data this assembly embeds
    (#2155). A consumer that never reads a group sets

        <RuntimeHostConfigurationOption Include="TianWen.Lib.EmbeddedData.Imaging" Value="false" Trim="true" />

    and the trimmer / NativeAOT compiler drops every manifest resource of that group from the output.
    Groups and not levels, because what a consumer reads does not nest: tianwen-thumb.dll, the Explorer
    thumbnail provider, reads none (its code is 1.7 MB and these resources are 57 MB, so the switches are
    the difference between a 3 MB and a 60 MB shell DLL); the browser app draws the sky and calibrates no
    image; a headless stacker would calibrate and draw no sky. There is no switch for "all of them": a
    consumer that reads none names every group, and EmbeddedCatalogFeatureSwitchTests fails when the
    thumbnail provider's project misses one.

    Why the lists live HERE and not in the consumer: ILC indexes an embedded ILLink.Substitutions.xml
    by the module that embeds it, so a consumer's copy naming TianWen.Lib resources removes nothing
    (measured: 59.6 MB either way). Only this assembly's own file, or a global substitution file passed
    on the ILC command line, reaches them. (No double hyphen anywhere in this comment: XML forbids it,
    and the parser that enforces it is the test that pins this file.)

    The names are manifest resource names and must match the assembly exactly; there is no wildcard.
    EmbeddedCatalogFeatureSwitchTests pins these lists against the built assembly: every embedded
    resource is in exactly one group, so adding a catalog without adding it here fails a test rather
    than silently shipping it in the thumbnail DLL. A reader of a group must say so when its file is
    gone (or do without it), never read a null stream.
  -->
  <!-- The objects an atlas or a planner draws and names: the deep-sky catalogues and their outlines, the bright
       stars (HR), the SIMBAD merge and the verified articles. -->
  <assembly fullname="TianWen.Lib" feature="TianWen.Lib.EmbeddedData.Sky" featurevalue="false">
    <resource name="TianWen.Lib.Astrometry.Catalogs.Barnard.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Barnard.shapes.json.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.CG.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Ced.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Ced.shapes.json.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Cl.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.DG.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Dobashi.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Dobashi.shapes.json.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.GUM.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.HH.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.HR.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.LDN.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.LDN.shapes.json.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.NGC.addendum.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.NGC.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.RCW.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.Sh.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.object_articles.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.simbad_merge.bin.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.vdB.gs.gz" action="remove" />
  </assembly>
  <!-- Tycho-2 and what resolves into it: the catalogue, its region bounds and proper motions, and the HD and HIP
       cross-references. The cross-reference snapshot is checked against its inputs, so these go together. -->
  <assembly fullname="TianWen.Lib" feature="TianWen.Lib.EmbeddedData.Stars" featurevalue="false">
    <resource name="TianWen.Lib.Astrometry.Catalogs.hd_hip_cross.bin.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.hd_to_tyc.bin" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.hd_to_tyc.bin.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.hd_to_tyc_multi.json.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.hip_to_tyc.bin" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.hip_to_tyc.bin.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.hip_to_tyc_multi.json.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.tyc2.bin" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.tyc2_gsc_bounds.bin.lz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.tyc2_pm_sidecar.bin.lz" action="remove" />
  </assembly>
  <!-- What colour calibration reads: filter curves, sensor QE and the Pickles stellar spectra. -->
  <assembly fullname="TianWen.Lib" feature="TianWen.Lib.EmbeddedData.Imaging" featurevalue="false">
    <resource name="TianWen.Lib.Astrometry.Catalogs.filter_curves.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.pickles_sed.gs.gz" action="remove" />
    <resource name="TianWen.Lib.Astrometry.Catalogs.sensor_qe.gs.gz" action="remove" />
  </assembly>
  <!-- What a simulated device shows: the fake planetary camera's Jupiter. -->
  <assembly fullname="TianWen.Lib" feature="TianWen.Lib.EmbeddedData.FakeDevices" featurevalue="false">
    <resource name="TianWen.Lib.Devices.Fake.Data.jupiter.rgb.gz" action="remove" />
  </assembly>
</linker>
