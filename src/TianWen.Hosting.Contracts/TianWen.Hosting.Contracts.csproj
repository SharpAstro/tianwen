<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <!-- Shared by the AOT-published tianwen-server (through TianWen.Hosting) and by
         TianWen.RemoteClient, so the trim/AOT analyzers run here too. The source-generated
         HostingJsonContext lives in this assembly, which is the point of the split: server and
         client serialize the SAME contract with the SAME generated metadata, instead of a
         hand-copied DTO set that drifts. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.Lib\TianWen.Lib.csproj" />
  </ItemGroup>

  <!--
    Node.Lib from the sibling clone when it is there, else the package. Its own switch rather than UseLocalSiblings, with
    the two probes pilot uses (a clone sits three folders under the org root, a Claude Code worktree six), so a worktree
    builds against the sibling too.
  -->
  <PropertyGroup>
    <NodeLibRoot Condition="'$(NodeLibRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\Node.Lib\src\Node.Lib')">$(MSBuildThisFileDirectory)..\..\..\Node.Lib\</NodeLibRoot>
    <NodeLibRoot Condition="'$(NodeLibRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\Node.Lib\src\Node.Lib')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\Node.Lib\</NodeLibRoot>
    <UseLocalNodeLib Condition="'$(UseLocalNodeLib)' == '' AND '$(RuntimeIdentifier)' == '' AND '$(NodeLibRoot)' != ''">true</UseLocalNodeLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalNodeLib)' == 'true'">
    <ProjectReference Include="$(NodeLibRoot)src\Node.Lib\Node.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalNodeLib)' != 'true'">
    <PackageReference Include="Node.Lib" />
  </ItemGroup>

</Project>
