@* No @page routes: this app mounts Planner DIRECTLY as the root component (Program.cs
   RootComponents.Add<Planner>("#app")) - there is no Blazor Router, so route templates and
   route parameters would be inert. Deep links + chip navigation carry the active view in a
   "?view=sky" query string (refresh-safe on GitHub Pages - the path stays at the app root, so a
   share/refresh serves index.html instead of 404-ing on a "/sky-atlas" path segment), parsed
   ourselves (ApplyViewFromLocation + NavigationManager.LocationChanged, which also covers browser
   back/forward). *@
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@implements IAsyncDisposable
@using DIR.Lib
@using TianWen.Lib.Astrometry.Catalogs
@using TianWen.Lib.Astrometry.Comets
@using TianWen.Lib.Astrometry.SOFA
@using TianWen.Lib.Devices
@using TianWen.UI.Abstractions
@using TianWen.UI.Web.SkyMap
@using WebGl.Renderer
@inject ICelestialObjectDB Db
@inject ICometRepository Comets
@inject ITimeProvider Time
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<Planner> Logger

@* The favicon is already the 🔭 emoji (inline SVG data URI in index.html) - keep the tab
   title text-only or the emoji shows twice next to the tab label. Web titles follow
   "Astro - <view>" per view. *@
<PageTitle>@(_view == View.SkyMap ? "Astro - Sky Atlas" : "Astro - Planner")</PageTitle>

<div class="app">
    <div class="titlebar">
        <span class="title" title="tiānwén">🔭 天文</span>
        @* data-view: a stable hook for the E2E browser tests (TianWen.UI.Web.E2E), so a chip
           selector doesn't depend on the emoji label text. *@
        <button class="subtitle chip @(_view == View.Planner ? "active" : null)" data-view="planner" @onclick="() => SwitchView(View.Planner)">📅 Planner</button>
        @* Both views wait on the same catalog, so the chips never block - switch freely while
           it loads (the atlas draws sky + planets immediately; stars/figures pop in when the
           catalog lands). The load state shows BESIDE the chip instead of graying it out. *@
        <button class="subtitle chip @(_view == View.SkyMap ? "active" : null)" data-view="sky"
                @onclick="() => SwitchView(View.SkyMap)">🌌 Sky Atlas</button>
        @if (!_ready)
        {
            <span class="catalog-loading">⏳ catalog loading…</span>
        }
        <span class="spacer"></span>
        <span class="status" aria-live="polite">@_status</span>
    </div>

    <div class="toolbar">
        <label>Lat <input type="number" step="0.1" @bind="_lat" /></label>
        <label>Lon <input type="number" step="0.1" @bind="_lon" /></label>
        <button @onclick="() => RecomputeAsync()" disabled="@_busy">Recompute</button>
        <button @onclick="RelocateAsync" disabled="@_busy" title="Plan for my current location">📍 Locate</button>
        <button @onclick="ToggleFullscreenAsync" title="Fullscreen (Esc to exit)">⛶</button>
    </div>

    <div class="canvas-host">
        @* The atlas keeps building AFTER the catalog chip clears: the star field is fetched,
           decompressed and flattened in phases that are synchronous stalls on the single WASM
           thread. Without this the app looks finished and then freezes, which reads as a hang
           rather than as loading. pointer-events:none so it can never swallow a click. *@
        @if (_atlasBusy)
        {
            <div class="atlas-loading" data-atlas-loading aria-live="polite">@_atlasBusyText</div>
        }
        @* WebGlCanvas (1.2) owns the hi-dpi plumbing: backing-buffer sizing, resize/dpr watching,
           backing-space input mapping, pointer capture (drags survive leaving the canvas), and
           focus - the JS helpers this host used to carry. *@
        <WebGlCanvas @ref="_canvas" Id="@CanvasElementId" TabIndex="0" AutoFocus="true"
                     OnReady="OnCanvasReady" OnResized="OnCanvasResized"
                     OnPointerDown="OnPointerDown" OnPointerMove="OnPointerMove"
                     OnPointerUp="OnPointerUp" OnWheel="OnWheel" OnKeyDown="OnKeyDown"
                     OnPinch="OnPinch" OnPinchEnd="OnPinchEnd" />
        @* Read-only selectable text (planner detail lines): the canvas skips rasterizing
           DrawSelectableText runs (HostRendersSelectableText) and this layer paints them as real
           DOM spans over the same rects — native browser selection/copy/find, zero widget rewrite. *@
        <CanvasTextLayer Runs="_textRuns" FontFamily="'DejaVu Sans', system-ui, sans-serif" />
        @* A REAL focusable input floated over the active canvas text widget: native IME /
           clipboard / autocorrect and the mobile soft keyboard, none of which a canvas-drawn
           widget can provide. Shown/hidden by the ActivateTextInput/DeactivateTextInput flow. *@
        <CanvasTextOverlay @ref="_textOverlay" Class="canvas-text-input"
                           OnInput="OnOverlayInput" OnSpecialKey="OnOverlayKey" OnBlurred="OnOverlayBlurred" />
    </div>
</div>

@code {
    static readonly RGBAColor32 Background = new(0x10, 0x10, 0x18, 0xff);

    // The canvas element's DOM id. Named once because document-keys.js is handed it to recognise the
    // element whose own @onkeydown already delivered an event, and a listener comparing against a
    // stale literal would double every key instead of failing visibly.
    const string CanvasElementId = "planner";

    enum View { Planner, SkyMap }

    WebGlRenderer? _webGl;
    WebGlCanvas? _canvas;
    PlannerTab<WebGlContext>? _tab;
    WebSkyMapTab? _skyTab;
    View _view = View.Planner;
    // The state's IsDirty setter auto-posts SavePlannerSessionSignal on this bus (same wiring as
    // the desktop host); the subscriber below persists to localStorage. Pumped in RenderFrame.
    // The tracker is mandatory: ProcessPending THROWS on an async handler without one (the
    // localStorage save is async), and ProcessCompletions reaps + logs the finished saves.
    readonly SignalBus _bus = new SignalBus();
    readonly BackgroundTaskTracker _tracker = new BackgroundTaskTracker();
    PlannerState _state = new();
    // First-metrics gate: WebGlCanvas's OnReady can fire while OnInitializedAsync is still staging
    // the font, so init awaits this instead of racing the component (the Chess.Web pattern).
    readonly TaskCompletionSource<CanvasMetrics> _firstMetrics = new();
    // Latest canvas metrics: backing size feeds the GL projection + content rect,
    // DevicePixelRatio is the tab's dpiScale. Input arrives pre-mapped to backing space.
    CanvasMetrics _metrics;
    string _fontPath = "monospace";
    string _status = "Loading…";
    (float X, float Y) _mouse;
    bool _ready;

    // The atlas is still assembling itself: shown as an overlay, and canvas navigation is dropped
    // while it is set. Dropping matters more than it looks -- the heavy phases are synchronous on
    // the one WASM thread, so the BROWSER queues every pointer/wheel event that arrives during a
    // stall and delivers the whole burst the moment it ends. Handling them then applies a second's
    // worth of accumulated pan and zoom in one frame, which is how a stall turns into a jump.
    bool _atlasBusy;
    string _atlasBusyText = "";

    // Canvas navigation is ignored while the atlas builds. Deliberately NOT applied to the DOM
    // toolbar: Lat/Lon/Recompute stay usable, and they do not touch the half-built star field.
    bool CanvasInputBlocked => _atlasBusy;

    void SetAtlasBusy(bool busy, string text = "")
    {
        _atlasBusy = busy;
        _atlasBusyText = text;
        StateHasChanged();
    }
    bool _busy;
    // Which canvas text field has the keyboard. The same owner the desktop uses, so the two hosts differ
    // only in what they BIND to its transition: SDL Start/StopTextInput there, showing and hiding the
    // CanvasTextOverlay below here. That is the whole platform step on this host.
    readonly TextInputFocus _focus = new TextInputFocus();
    // The real HTML <input> floated over the active widget (IME / clipboard / mobile keyboard).
    CanvasTextOverlay? _textOverlay;
    // Last CSS rect pushed to the overlay, so the per-frame sync only calls into JS on a move.
    RectF32 _overlayRect;
    // Bumped on every overlay Show; the deferred blur handler compares epochs so a blur that
    // was immediately followed by a re-activation (click from one input to another) is ignored.
    int _overlayEpoch;
    // Planner search autocomplete candidates; built after catalog init and rebuilt with comet
    // designations once they load (mirrors AppSignalHandler.SetAutoCompleteCache on desktop).
    string[]? _autoComplete;
    // One-shot guard: the full ~2.5M-star Tycho-2 catalog is fetched + decoded the first time the
    // Sky Atlas actually renders (deep-link or chip). ~30 MB static asset, stripped from the WASM
    // bundle - the atlas shows the HR bright-star seed until it lands (and stays HR-only if the
    // fetch 404s, e.g. a dev server without the CI-baked asset).
    bool _tycho2Requested;
    // E2E-only view-state hook (activated by ?e2e=1). Held so it can be disposed; null in a
    // normal session (the hook is never registered).
    DotNetObjectReference<Planner>? _testRef;

    // ── Frame-coalesced repaints (see wwwroot/raf-pump.js for the why) ────────
    // A continuous gesture (drag-pan, pinch, wheel) delivers several events per vsync and each one
    // used to paint a full frame that the next overwrote unseen. Those handlers now call
    // RequestRenderCoalesced, which paints at most once per animation frame. One-shot events keep
    // calling RenderFrame directly - deferring a click's repaint by a frame is latency for nothing.
    IJSObjectReference? _rafModule;
    DotNetObjectReference<Planner>? _rafRef;
    // Owned by the UI thread only (WASM is single-threaded and every writer is an event handler or the
    // rAF callback), so a plain bool needs no interlocking.
    bool _rafPending;
    // Counts repaints the coalescing actually skipped, so the win is measurable from the app rather
    // than only from a browser trace. Read by the E2E hook.
    int _rafCoalesced;
    int _renderFrames;
    double _renderMs;

    // Per-phase render accounting, and the SPLIT OF THE WORST FRAME. A total cannot answer the
    // question a jank hunt actually asks: a repaint here has a median of 0.9 ms and a max of 177 ms,
    // so the mean is dominated by the 99% of frames that are already fine, and the phase that only
    // fires on the slow 1% is invisible in it. Recording the worst frame's own breakdown names that
    // phase directly. Every other candidate for those frames -- the overlay gather, the GPU upload,
    // IndexedDB, member fetch/decode, the atlas rebuild, a clock tick, the region selector -- has
    // been measured and excluded, so what is left is inside this method and nothing outside it can
    // see in: to a browser trace the whole WASM module is one opaque frame.
    double _phaseBusMs, _phaseSkyMs, _phasePresentMs, _phaseOverlaySyncMs, _phaseTextLayerMs;
    double _worstFrameMs, _worstBusMs, _worstSkyMs, _worstPresentMs, _worstOverlaySyncMs, _worstTextLayerMs;
    int _slowFrames;

    // ── Document-level keys (see wwwroot/document-keys.js for the why) ─────────
    // A <canvas> only hears keydown while it holds DOM focus, and RestoreCanvasFocus only covers the
    // two ways focus leaves that the app can see (a chrome button click, a gesture). Focus taken by
    // devtools, an alt-tab landing on <body>, or an extension left the shortcuts dead with nothing
    // able to notice. So the document is a second source for the same keys, filtered in JS so a real
    // editable (Lat/Lon, the text overlay) still owns every key while it is focused.
    IJSObjectReference? _docKeysModule;
    // The listener handle, kept only so teardown can remove it: a stray listener on a torn-down page
    // holds the DotNetObjectReference alive and calls into a component that is gone.
    IJSObjectReference? _docKeysHandle;
    DotNetObjectReference<Planner>? _docKeysRef;
    // Keys the document listener delivered because the canvas did not have focus. Zero in a session
    // that never lost it, so a test can tell "the fallback carried this" from "focus was fine anyway".
    int _documentKeys;

    // Sensible default dark-ish mid-northern site; geolocation / manual entry override it.
    double _lat = 47.5;
    double _lon = 11.0;
    const double SiteElevationMeters = 500d;

    protected override async Task OnInitializedAsync()
    {
        // Deep link: resolve the initial view from the URL, then track every later change
        // (chip NavigateTo + browser back/forward both raise LocationChanged).
        ApplyViewFromLocation();
        ApplyObjectFromLocation();
        Nav.LocationChanged += OnLocationChanged;
        BindTextInputFocus();

        // Last-used site loads first (localStorage) so a reload shows it immediately instead of
        // flashing the built-in default while geolocation resolves.
        await LoadSavedSiteAsync();

        // Stage the UI font into the WASM in-memory FS so ManagedFontRasterizer's file loader finds
        // it. The await here also yields once so Blazor performs the first render (mounting the
        // <canvas>) BEFORE we measure it / WebGlRenderer.CreateAsync runs getElementById on it.
        await LoadFontAsync();

        // Site resolution, two-phase: if geolocation is ALREADY granted, fetch it now (no prompt,
        // fast) so the first compute uses the real site. If it would prompt, don't block init -
        // compute with the default site and apply the position in the background whenever the user
        // answers (see ApplyGeolocationLaterAsync).
        var geoGranted = await JS.InvokeAsync<string>("tianwenGeoState") == "granted";
        if (geoGranted)
        {
            await TryGeolocateAsync(waitForPrompt: false);
        }

        // Dirty-flag driven persistence, mirroring AppSignalHandler's subscriber on desktop.
        _state.Bus = _bus;
        _bus.Subscribe<SavePlannerSessionSignal>(async _ =>
        {
            if (!_state.IsDirty) return;
            _state.MarkSaved();
            await SavePlannerSessionAsync();
        });

        // The canvas is laid out + measured once WebGlCanvas reports (canvas-in-DOM gate).
        _metrics = await _firstMetrics.Task;

        try
        {
            _webGl = await WebGlRenderer.CreateAsync("planner", _metrics.BackingWidth, _metrics.BackingHeight);
            // This host mounts a <CanvasTextLayer>, so DrawSelectableText runs skip the glyph raster
            // and surface as real, selectable DOM spans instead (see SyncSelectableTextLayer).
            _webGl.HostRendersSelectableText = true;
            _tab = new PlannerTab<WebGlContext>(_webGl) { Bus = _bus };
            _skyTab = new WebSkyMapTab(_webGl) { Bus = _bus };
        }
        catch (Exception ex)
        {
            _status = $"WebGL2 unavailable: {ex.Message}";
            return;
        }

        // Search wiring - the same shared interaction bodies AppSignalHandler wires on desktop,
        // with web-flavoured context: transform from the lat/lon fields, focus release via the
        // shared TextInputFocus. requestRedraw paints directly because a committed search finishes
        // on a task continuation AFTER the triggering event's RenderFrame already ran.
        _state.Search = new PlannerSearchInteraction(
            _state, Db,
            createTransform: CreateSiteTransform,
            autoComplete: () => _autoComplete,
            ensureVisible: idx => _tab?.EnsureVisible(idx),
            deactivate: DeactivateTextInput,
            requestRedraw: RenderFrame);
        WireSkyMapSearch(_skyTab);
        WireSkyMapInteractions(_skyTab);
        ApplyPendingObjectSelection();

        // E2E-only: when the app is opened with ?e2e=1, hand a .NET ref to the index.html shim so
        // browser tests can read LIVE sky-map view state (FOV/centre) via window.__tianwenTest -
        // the "assert canvas state without pixels" hook (a single WebGL canvas has no DOM to inspect).
        // Inert in a normal session: the shim's getSkyView is never wired unless the flag is present.
        if (IsE2ETestMode())
        {
            // Latched, because the URL is NOT a durable carrier of this fact: SwitchView rewrites it to
            // "?view=sky", dropping the flag, so anything asking IsE2ETestMode() after the first chip
            // click gets false. The session's e2e-ness is decided once, where the ref is handed out.
            _isE2ETestSession = true;
            _testRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("__tianwenTestInit", _testRef);
        }

        // Bring up the repaint pump. Imported here rather than earlier because everything before this
        // point paints one-shot frames through RenderFrame anyway, and RequestRenderCoalesced falls
        // back to a direct paint until this lands - so a slow import costs correctness nothing.
        try
        {
            _rafRef = DotNetObjectReference.Create(this);
            _rafModule = await JS.InvokeAsync<IJSObjectReference>("import", "./raf-pump.js");
        }
        catch (Exception ex)
        {
            // Every gesture then paints synchronously, exactly as it did before the pump existed.
            Logger.LogWarning(ex, "raf-pump.js did not load; repaints will not be frame-coalesced");
        }

        // Bring up the document-level key fallback. Separate try from the pump above on purpose: these
        // are unrelated capabilities and one failing must not take the other down with it.
        try
        {
            _docKeysRef = DotNetObjectReference.Create(this);
            _docKeysModule = await JS.InvokeAsync<IJSObjectReference>("import", "./document-keys.js");
            _docKeysHandle = await _docKeysModule.InvokeAsync<IJSObjectReference>("attach", _docKeysRef, CanvasElementId);
        }
        catch (Exception ex)
        {
            // Shortcuts then work only while the canvas holds focus, which is what they did before this
            // module existed -- a degraded keyboard, not a broken one.
            Logger.LogWarning(ex, "document-keys.js did not load; shortcuts will need canvas focus");
        }

        await ComputeAsync();
        _ready = true;
        // Paint explicitly: Blazor's firstRender already happened way back during the font fetch
        // (the first await in OnInitializedAsync yields to the renderer), so an
        // `if (firstRender && _ready)` guard in OnAfterRender never fires - the classic
        // "board/menu doesn't show until the first click" init-ordering bug.
        RenderFrame();
        StateHasChanged();

        // Comets load after first paint, off the critical path (fire-and-forget; logs its own failures).
        _ = LoadCometsInBackgroundAsync();

        // First visit (permission prompt pending): wait for the user's decision in the background
        // and recompute for their real site once granted.
        if (!geoGranted)
        {
            _ = ApplyGeolocationLaterAsync();
        }
    }

    void OnCanvasReady(CanvasMetrics m) => _firstMetrics.TrySetResult(m);

    void OnCanvasResized(CanvasMetrics m)
    {
        _metrics = m;
        if (_webGl is null) return;
        _webGl.Resize(m.BackingWidth, m.BackingHeight);
        RenderFrame();
    }

    async Task LoadFontAsync()
    {
        var dir = System.IO.Path.Combine(AppContext.BaseDirectory, "Fonts");
        System.IO.Directory.CreateDirectory(dir);
        _fontPath = System.IO.Path.Combine(dir, "DejaVuSans.ttf");
        if (!System.IO.File.Exists(_fontPath))
        {
            var bytes = await Http.GetByteArrayAsync("Fonts/DejaVuSans.ttf");
            await System.IO.File.WriteAllBytesAsync(_fontPath, bytes);
        }
    }

    // Best-effort browser geolocation: if granted, use the real lat/lon instead of the default.
    // Denied / unavailable / dismissed -> keep the default. A manual lat/lon edit + Recompute
    // overrides this for the session (cross-reload persistence is a follow-up - localStorage).
    // Returns true when a position was applied.
    async Task<bool> TryGeolocateAsync(bool waitForPrompt)
    {
        try
        {
            var pos = await JS.InvokeAsync<double[]?>("tianwenGeo", waitForPrompt);
            if (pos is { Length: 2 } && !double.IsNaN(pos[0]) && !double.IsNaN(pos[1]))
            {
                _lat = Math.Round(pos[0], 4);
                _lon = Math.Round(pos[1], 4);
                return true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] geolocation unavailable, using default site: {ex.Message}");
        }
        return false;
    }

    // First-visit path: the permission prompt is open (or about to be). Wait for the user's
    // decision with NO timeout - the initial plan for the default site renders meanwhile - and when
    // a position arrives, recompute for the real site. Runs strictly after the initial compute
    // (single-threaded WASM queues the continuation), so it never races _busy.
    async Task ApplyGeolocationLaterAsync()
    {
        if (await TryGeolocateAsync(waitForPrompt: true))
        {
            Console.WriteLine($"[tianwen-web] geolocation granted late - recomputing for {_lat}, {_lon}");
            StateHasChanged();
            await RecomputeAsync();
        }
    }

    // Toolbar 📍: re-fetch the current position on demand (prompting if needed) and recompute.
    async Task RelocateAsync()
    {
        RestoreCanvasFocus(); // the button click took the keyboard; give it straight back
        if (_busy) return;
        if (await TryGeolocateAsync(waitForPrompt: true))
        {
            StateHasChanged();
            await RecomputeAsync();
        }
        else
        {
            await SetStatusAsync("Location unavailable - enter Lat/Lon manually");
        }
    }

    // Builds the night window + tonight's-best plan for the current site. The catalog DB is embedded
    // (InitDBAsync is idempotent). Comets are deliberately NOT passed here: ComputeTonightsBestAsync
    // awaits the JPL SBDB fetch inline when a repository is given, which would put a multi-MB (or
    // CORS-failing) network call on the first-paint critical path; they load in the background below.
    async Task ComputeAsync()
    {
        _state.ObjectDb = Db;
        _state.Comets = Comets;

        var transform = CreateSiteTransform();

        // Full-sweep gate, mirroring the desktop host (AppSignalHandler.CheckRecompute): the broad
        // RA/Dec catalog scan (ObservationScheduler.TonightsBest) is only needed on the FIRST compute
        // (no ranked list yet) or when the site moves >1°. Otherwise a Recompute / 📍 Locate at
        // essentially the same site just re-scores the EXISTING TonightsBest for the current time via
        // the synchronous RecomputeForDate fast path - no catalog scan, a fraction of the sweep cost.
        // Compare BEFORE overwriting the state's site (its previous value is the baseline; NaN on the
        // first run -> full sweep).
        var siteChanged = double.IsNaN(_state.SiteLatitude)
            || Math.Abs(transform.SiteLatitude - _state.SiteLatitude) > 1.0
            || Math.Abs(transform.SiteLongitude - _state.SiteLongitude) > 1.0;
        _state.SiteLatitude = _lat;
        _state.SiteLongitude = _lon;

        var sw = System.Diagnostics.Stopwatch.StartNew();
        await SetStatusAsync("Reading the star catalog…");
        await Db.InitDBAsync();
        Console.WriteLine($"[tianwen-web] catalog init: {sw.ElapsedMilliseconds} ms");

        // The catalog is only NOW loaded, so a "?object=<dso>" deep link can finally resolve.
        ApplyPendingObjectSelection();

        // The catalog sweep (or the lighter same-site rescore) + altitude profiles are one long
        // synchronous block; on the single browser thread nothing repaints while it runs.
        // SetStatusAsync yields first so the status above actually paints before the block starts.
        sw.Restart();
        // Three ways to a scored list, cheapest first. The two rescore paths differ only in where the
        // candidate set came from -- a live one already in state, or last visit's, restored from
        // localStorage -- because RecomputeForDate rebuilds everything else from the targets alone.
        //
        // The cache lookup is deliberately NOT gated on siteChanged. That flag compares against the
        // previous IN-MEMORY site, which is NaN on the first compute of a session -- i.e. on exactly
        // the reload this cache exists for, it always reads "the site moved". The cache validates its
        // own site (and minimum altitude, and age) against the payload it stored, which is the check
        // that actually means something here.
        var fromCache = _state.TonightsBest.Length == 0
            && await TryRestoreTonightsBestCacheAsync(transform);
        if (_state.TonightsBest.Length > 0 && (!siteChanged || fromCache))
        {
            await SetStatusAsync("Refreshing tonight's best…");
            PlannerActions.RecomputeForDate(_state, transform);
            Console.WriteLine($"[tianwen-web] tonight's best (rescore, {(fromCache ? "cached candidates" : "same site")}): "
                + $"{sw.ElapsedMilliseconds} ms");
        }
        else
        {
            await SetStatusAsync("Scanning the sky for tonight's best…");
            await PlannerActions.ComputeTonightsBestAsync(
                _state, Db, transform, _state.MinHeightAboveHorizon, CancellationToken.None,
                onProgress: msg => Console.WriteLine($"[tianwen-web] {msg}"));
            Console.WriteLine($"[tianwen-web] tonight's best (full sweep): {sw.ElapsedMilliseconds} ms");
            await SaveTonightsBestCacheAsync(transform);
        }

        // Resolve the display timezone AFTER the plan computes: CalculateNightWindow initialises the
        // transform's Julian date (via EventTimes), so the DateTime/FromOADate read inside
        // TryGetSiteTimeZone is valid. Any residual failure - e.g. an IANA zone id TimeZoneInfo can't
        // resolve under InvariantGlobalization - falls back to UTC.
        try
        {
            _state.SiteTimeZone = transform.TryGetSiteTimeZone(out var tz, out _) ? tz : TimeSpan.Zero;
        }
        catch (Exception ex)
        {
            _state.SiteTimeZone = TimeSpan.Zero;
            Console.WriteLine($"[tianwen-web] timezone resolution failed, using UTC: {ex.Message}");
        }

        _state.SelectedTargetIndex = 0;
        _status = $"{_state.TonightsBest.Length} targets · {_lat:0.0}°, {_lon:0.0}°";

        // Re-apply the saved session (pins + handoff sliders) against the freshly computed
        // TonightsBest. Runs after EVERY compute: the first compute may run on the default site
        // (saved pins get site-invalidated), and the geolocation recompute then restores them.
        await TryRestorePlannerSessionAsync();

        // Remember the site this plan was computed for, so the next reload starts from it.
        await SaveSiteAsync();
    }

    // --- Planner session persistence: pins + sliders survive F5 via localStorage --------------
    // The web analogue of the desktop's PlannerPersistence file store (AppData/Planner/...):
    // same DTO + restore logic (SerializeToJson / TryRestoreFromJson), different storage.

    // --- Tonight's-best candidate cache: skip the catalog scan on a repeat visit ----------------
    //
    // The planner's own two costs are the ONLY part of a boot that nothing caches. Measured on the
    // deployed build, cold and then reloaded: catalog init 1306 -> 1330 ms and the sweep 1507 -> 1482
    // ms, i.e. unchanged, while the star tiles went 12305 -> 998 ms off IndexedDB. The catalog is
    // embedded in the assembly, so there is no fetch to cache and its cost is the parse; the sweep is
    // pure computation, and THAT is cacheable -- not its result, but its candidate set.
    //
    // localStorage rather than IndexedDB: the payload is ~100 targets of a few fields, the same store
    // the pins already use, and a synchronous string get is far simpler than a keyed binary store for
    // something this small.

    const string TonightsBestCacheKey = "tianwen.planner.tonightsbest";

    /// <summary>The night being planned, which is the cache's freshness axis (see
    /// <see cref="PlannerPersistence.TonightsBestCacheMaxAgeDays"/>).</summary>
    DateTimeOffset PlannedForNight()
        => _state.PlanningDate ?? Time.GetUtcNow().ToOffset(_state.SiteTimeZone);

    async Task<bool> TryRestoreTonightsBestCacheAsync(Transform transform)
    {
        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", TonightsBestCacheKey) is not { Length: > 0 } json)
            {
                return false;
            }

            var sw = System.Diagnostics.Stopwatch.StartNew();
            var restored = PlannerPersistence.TryRestoreTonightsBest(
                _state, json, transform.SiteLatitude, transform.SiteLongitude,
                _state.MinHeightAboveHorizon, PlannedForNight(), Logger);
            Console.WriteLine($"[tianwen-web] tonight's best cache: "
                + $"{(restored ? $"{_state.TonightsBest.Length} candidates restored" : "rejected")} in {sw.ElapsedMilliseconds} ms");
            return restored;
        }
        catch (Exception ex)
        {
            // Never fatal: a refused cache just means the full sweep runs, which is the old behaviour.
            Console.WriteLine($"[tianwen-web] tonight's best cache unavailable: {ex.Message}");
            return false;
        }
    }

    async Task SaveTonightsBestCacheAsync(Transform transform)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", TonightsBestCacheKey,
                PlannerPersistence.SerializeTonightsBest(
                    _state, transform.SiteLatitude, transform.SiteLongitude, PlannedForNight()));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tonight's best cache write failed (non-fatal): {ex.Message}");
        }
    }

    // --- Date changes: honour PlannerState.NeedsRecompute ---------------------------------------
    //
    // The web host is the only one of the three that never read this flag. ShiftPlanningDate /
    // ShiftPlanningHours / ResetPlanningDate (PageUp / PageDown / N / T on the sky map) set it and
    // nothing acted, so the map moved to the new night while every score, night window and altitude
    // profile stayed on the old one -- silently, since both look perfectly plausible. The desktop's
    // AppSignalHandler.CheckRecompute is the model; this is its browser counterpart.

    /// <summary>
    /// Coalescing window for a date change. PageUp autorepeats, and each press is a different night
    /// costing a ~170 ms synchronous rescore (measured on the deployed build), so firing per press
    /// would queue the whole autorepeat behind the user's fingers. Long enough to swallow a repeat,
    /// short enough that a single deliberate press feels immediate.
    /// </summary>
    const int RecomputeSettleMs = 250;

    bool _recomputeScheduled;

    /// <summary>
    /// Arms the settle when the flag is up. Gated on "not already armed" rather than superseding a
    /// pending one: this is called from every repaint, so a trailing debounce would be pushed back
    /// indefinitely by an unrelated pan and the recompute would never run.
    /// </summary>
    void CheckRecompute()
    {
        if (!_state.NeedsRecompute || _recomputeScheduled || _busy)
        {
            return;
        }

        _recomputeScheduled = true;
        _ = SettleRecomputeAsync();
    }

    async Task SettleRecomputeAsync()
    {
        try
        {
            await Task.Delay(RecomputeSettleMs);

            // Wait out any other compute (the toolbar button, a late geolocation fix) rather than
            // dropping the request. RecomputeAsync no-ops while _busy, and CheckRecompute cannot
            // re-arm from the repaint that runs INSIDE that compute -- _busy is still set there --
            // so returning here would strand the flag with nothing left to notice it.
            while (_busy)
            {
                await Task.Delay(RecomputeSettleMs);
            }

            // Cleared BEFORE the work, so a press that lands during the rescore sets it again and the
            // next repaint arms a fresh settle, rather than being swallowed by the one in flight.
            _state.NeedsRecompute = false;
            await RecomputeAsync(restoreFocus: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] date recompute failed: {ex.Message}");
        }
        finally
        {
            _recomputeScheduled = false;
        }
    }

    async Task TryRestorePlannerSessionAsync()
    {
        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", "tianwen.planner") is { Length: > 0 } json
                && PlannerPersistence.TryRestoreFromJson(_state, json, Logger))
            {
                _state.MarkSaved(); // freshly restored == already persisted
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] saved planner session unavailable: {ex.Message}");
        }
    }

    async Task SavePlannerSessionAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "tianwen.planner",
                PlannerPersistence.SerializeToJson(_state));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] planner session save failed: {ex.Message}");
        }
    }

    // --- Site persistence: last-used lat/lon survives F5 via localStorage --------------------

    async Task LoadSavedSiteAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "tianwen.site");
            if (saved?.Split(',') is [var lat, var lon]
                && double.TryParse(lat, CultureInfo.InvariantCulture, out var la)
                && double.TryParse(lon, CultureInfo.InvariantCulture, out var lo))
            {
                (_lat, _lon) = (la, lo);
            }
        }
        catch (Exception ex)
        {
            // Best-effort: localStorage can throw in private-browsing / storage-blocked modes.
            Console.WriteLine($"[tianwen-web] saved site unavailable: {ex.Message}");
        }
    }

    async Task SaveSiteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "tianwen.site",
                FormattableString.Invariant($"{_lat},{_lon}"));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] site save failed: {ex.Message}");
        }
    }

    // Site-initialised transform for the current lat/lon fields - the web analogue of the
    // desktop's TransformFactory.FromProfile (there is no profile in the browser). Used by the
    // planner compute AND the search interaction (createTransform).
    // CalculateNightWindow (inside ComputeTonightsBestAsync) reads transform.DateTimeOffset, whose
    // getter needs the Julian date initialised - an unset JD maps to year -4712 and throws
    // Arg_OleAutDateInvalid via DateTime.FromOADate. Seed the clock from the time provider first
    // (the public equivalent of the Lib-internal Transform.RefreshDateTimeFromTimeProvider).
    Transform CreateSiteTransform()
    {
        var transform = new Transform(Time);
        transform.SiteLatitude = _lat;
        transform.SiteLongitude = _lon;
        transform.SiteElevation = SiteElevationMeters;
        transform.DateTime = Time.GetUtcNow().UtcDateTime;

        // Plan for the night the user is LOOKING at, not for tonight. Mirrors the desktop
        // (AppSignalHandler.CheckRecompute): noon of the planning date, so CalculateNightWindow
        // resolves the dark window either side of that midnight rather than of the current one.
        //
        // Without this the date controls were half-wired -- PageUp/PageDown/N/T moved the sky map
        // and the planning date, and every score, night window and altitude profile was still
        // computed for today. Recompute did not fix it either; it built the transform here.
        if (_state.PlanningDate is { } planningDate)
        {
            transform.DateTimeOffset = new DateTimeOffset(planningDate.Date, planningDate.Offset).AddHours(12);
        }

        return transform;
    }

    // --- Canvas text-input focus (web counterpart of the Activate/DeactivateTextInputSignal
    // flow; the shared TextInputInteraction supplies the per-keystroke machinery) -----------

    // The browser's half of a focus change, bound ONCE (from OnInitializedAsync) exactly as the desktop
    // binds SDL's. Nothing else on this page shows or hides the overlay, so the <input> cannot get out of
    // step with which field the app thinks is focused.
    void BindTextInputFocus() => _focus.FocusChanged += (_, next) =>
    {
        if (next is { } input)
        {
            ShowOverlayFor(input);
            return;
        }

        // NO IsVisible guard here: a native blur (clicking a DOM chip / another element while the
        // input is focused) clears IsVisible BEFORE this runs, but the <input> is still display:block
        // until HideAsync's JS hide() -- guarding would skip the hide and strand a visible orphaned
        // input over the canvas (the same race fixed inside HideAsync itself, WebGl.Renderer 1.9).
        // HideAsync is idempotent, so calling it "already hidden" is a cheap no-op.
        if (_textOverlay is { } overlay)
        {
            _tracker.Run(() => overlay.HideAsync().AsTask(), "Hide text overlay");
        }
    };

    void ActivateTextInput(TextInputState input, int clicks)
    {
        _focus.Focus(input);
        if (clicks >= 2 && input.Text.Length > 0)
        {
            input.SelectAll();
        }
    }

    void DeactivateTextInput() => _focus.Blur();

    // Hands the keyboard back to the canvas. The canvas IS the app -- [O], [D], F3, the arrows and every
    // other shortcut are canvas keys -- but they ride DOM focus, and the canvas takes focus exactly ONCE
    // (AutoFocus, at startup) with nothing anywhere to give it back. So the shortcuts die silently the
    // first time focus leaves, while the map goes on panning and zooming perfectly, because pointer
    // events need no focus: it reads as "[O] is broken", not as "the page cannot hear me".
    //
    // Both ways out are ordinary. Any chrome button (a view chip, Locate, Recompute) takes focus on
    // click and keeps it. And TOUCH can never restore it, even by driving the map: the touch bridge
    // calls preventDefault() on touchstart -- which is what stops the page scrolling under the fingers
    // -- and that suppresses the browser's own focus-on-press along with it. A finger-driven session
    // therefore has no way back at all, which is how this was reported.
    //
    // Deliberately a no-op while a canvas text field is focused: the floating <input> legitimately owns
    // the keyboard then, and stealing it back would break typing and the IME with it. The lat/lon number
    // fields are real DOM inputs and are never touched here for the same reason -- they are not buttons,
    // so nothing calls this after clicking into them.
    void RestoreCanvasFocus()
    {
        if (_focus.Current is not null || _canvas is null)
        {
            return;
        }
        _tracker.Run(() => _canvas.FocusAsync().AsTask(), "Focus canvas");
    }

    // The active view's widget as the concrete pixel-widget base, for the region-rect scan
    // (GetRegisteredRegions is not on the IPixelWidget interface).
    PixelWidgetBase<WebGlContext>? ActivePixelTab => _view == View.SkyMap ? _skyTab : _tab;

    // The arranged rect of the widget's clickable region, converted backing px -> CSS px
    // (the overlay positions in CSS space). Null when the widget didn't render this frame.
    RectF32? FindInputRectCss(TextInputState input)
    {
        if (ActivePixelTab is not { } tab)
        {
            return null;
        }
        foreach (var region in tab.GetRegisteredRegions())
        {
            if (region.Result is HitResult.TextInputHit { Input: { } i } && ReferenceEquals(i, input))
            {
                var dpr = (float)(_metrics.DevicePixelRatio > 0 ? _metrics.DevicePixelRatio : 1);
                return new RectF32(region.X / dpr, region.Y / dpr, region.Width / dpr, region.Height / dpr);
            }
        }
        return null;
    }

    void ShowOverlayFor(TextInputState input)
    {
        if (_textOverlay is not { } overlay || FindInputRectCss(input) is not { } r)
        {
            return;
        }
        _overlayEpoch++;
        _overlayRect = r;
        var (text, caret) = (input.Text, input.CursorPos);
        _tracker.Run(() => overlay.ShowAsync(text, caret, r.X, r.Y, r.Width, r.Height).AsTask(), "Show text overlay");
    }

    // Called at the end of RenderFrame: the tab re-registers its regions every paint, so a
    // layout move (panel resize, dropdown reflow) re-anchors the overlay.
    void SyncOverlayRect()
    {
        if (_focus.Current is not { } active || _textOverlay is not { IsVisible: true } overlay)
        {
            return;
        }
        if (FindInputRectCss(active) is not { } r || r.Equals(_overlayRect))
        {
            return;
        }
        _overlayRect = r;
        _tracker.Run(() => overlay.SetRectAsync(r.X, r.Y, r.Width, r.Height).AsTask(), "Sync text overlay rect");
    }

    // --- CanvasTextOverlay callbacks: the browser input owns the text while editing ---------

    Task OnOverlayInput(CanvasOverlayInputArgs e)
    {
        if (_focus.Current is not { } active)
        {
            return Task.CompletedTask;
        }
        active.Text = e.Value;
        active.CursorPos = e.SelectionStart;
        active.OnTextChanged?.Invoke(active.Text);
        RenderFrame(); // suggestions dropdown updates under the overlay
        return Task.CompletedTask;
    }

    // The active search interaction (planner autocomplete / sky-map F3) when `active` is one of their
    // boxes -- feeds TextInputInteraction the Up/Down result nav (mirrors the desktop GuiEventHandlerBase).
    SearchInteraction? ResolveActiveSearch(TextInputState active)
        => active == _state.SearchInput ? _state.Search
        : _skyTab is { } st && active == st.State.Search.SearchInput ? st.State.Search.Interaction
        : null;

    Task OnOverlayKey(CanvasOverlayKeyArgs e)
    {
        if (_focus.Current is not { } active)
        {
            return Task.CompletedTask;
        }
        var key = e.Key switch
        {
            "ArrowUp" => InputKey.Up,
            "ArrowDown" => InputKey.Down,
            "Enter" => InputKey.Enter,
            "Escape" => InputKey.Escape,
            "Tab" => InputKey.Tab,
            _ => InputKey.None,
        };
        if (key == InputKey.None)
        {
            return Task.CompletedTask;
        }
        var mods = (e.Shift ? InputModifier.Shift : 0) | (e.Ctrl ? InputModifier.Ctrl : 0) | (e.Alt ? InputModifier.Alt : 0);
        var before = active.Text;
        // Tab cycling re-anchors the overlay through the FocusChanged binding, so no per-call hook here.
        TextInputInteraction.HandleKey(key, mods, new TextInputInteraction.KeyContext(
            Tracker: _tracker,
            Focus: _focus,
            RequestRedraw: () => { }, // the RenderFrame below covers this event
            ActiveSearch: ResolveActiveSearch(active),
            TabFields: () => ActiveTab?.GetRegisteredTextInputs() ?? []));
        // A canvas-side rewrite (suggestion committed on Enter) pushes back into the input.
        if (_focus.Current is { } current && ReferenceEquals(current, active) && current.Text != before)
        {
            var (text, caret) = (current.Text, current.CursorPos);
            _tracker.Run(() => _textOverlay is { } o ? o.SetValueAsync(text, caret).AsTask() : Task.CompletedTask,
                "Sync text overlay value");
        }
        RenderFrame();
        return Task.CompletedTask;
    }

    async Task OnOverlayBlurred()
    {
        // Deferred + epoch-guarded: when focus moves because the user clicked ANOTHER canvas
        // input, the pointer handler re-shows the overlay (bumping the epoch) around the same
        // time this blur arrives - deactivating here would kill the new focus. Only a blur that
        // stays unanswered (tap on the toolbar, browser chrome, page background) deactivates.
        var epoch = _overlayEpoch;
        await Task.Delay(100);
        if (epoch == _overlayEpoch && _focus.Current is not null)
        {
            DeactivateTextInput();
            RenderFrame();
        }
    }

    // Sky-map F3 search: the tab posts Open/Close/Commit signals; route them to the same shared
    // SkyMapSearchActions the desktop AppSignalHandler uses. Subscribers run inside RenderFrame's
    // bus pump (before the paint), so they mutate state only - never re-enter RenderFrame.
    void WireSkyMapSearch(WebSkyMapTab skyTab)
    {
        var skyState = skyTab.State;
        var skySearch = skyState.Search;

        // The F3 search-box interaction (shared DIR.Lib SearchInteraction) with web-flavoured dispatch:
        // commit + close post signals so the DI context resolves in the handlers below. Replaces the three
        // SearchInput.On* assignments.
        skySearch.Interaction = new SkyMapSearchInteraction(
            skySearch, Db,
            commit: () => _bus.Post(new SkyMapSearchCommitSignal()),
            close: () => _bus.Post(new CloseSkyMapSearchSignal()),
            requestRedraw: () => skyState.NeedsRedraw = true);

        _bus.Subscribe<OpenSkyMapSearchSignal>(_ =>
        {
            SkyMapSearchActions.OpenSearch(skySearch, Db, _state.Comets);
            ActivateTextInput(skySearch.SearchInput, clicks: 1);
            skyState.NeedsRedraw = true;
        });
        _bus.Subscribe<CloseSkyMapSearchSignal>(_ =>
        {
            SkyMapSearchActions.CloseSearch(skySearch);
            DeactivateTextInput();
            skyState.NeedsRedraw = true;
        });
        _bus.Subscribe<SkyMapSearchCommitSignal>(commit =>
        {
            if (skySearch.Interaction is not { } interaction
                || interaction.SelectedIndex < 0
                || interaction.SelectedIndex >= interaction.Results.Length)
            {
                return;
            }
            // Same viewing-time rule as the desktop handler: planning date (or now) + scrub offset,
            // so a commit resolves the position the map is actually showing.
            var viewingUtc = (_state.PlanningDate?.ToUniversalTime() ?? Time.GetUtcNow()) + skyState.TimeOffset;
            var site = SiteContext.Create(_state.SiteLatitude, _state.SiteLongitude, viewingUtc);
            SkyMapSearchActions.CommitResult(
                skySearch, skyState, Db, interaction.Results[interaction.SelectedIndex],
                _state.SiteLatitude, _state.SiteLongitude,
                viewingUtc, site, _state.Comets);
            DeactivateTextInput();
            skyState.NeedsRedraw = true;
            _ = InvokeAsync(SyncObjectToUrl);
        });
    }

    // Sky-map interactions beyond search: click-to-select (map clicks + planet/comet label clicks;
    // Ctrl forces a point-source pick), pin-from-atlas, and view-in-planner. There is no AppSignalHandler
    // in the browser, so this wires the SAME shared helpers (SkyMapSearchActions / PlannerActions) the
    // desktop handler uses to the web bus - the info panel (with its Pin / View in Planner / Goto buttons)
    // is drawn by the shared SkyMapTab base, so once a click populates it the buttons are already live.
    // Subscribers run inside RenderFrame's bus pump, so they only mutate state (never re-enter RenderFrame).
    void WireSkyMapInteractions(WebSkyMapTab skyTab)
    {
        var skyState = skyTab.State;

        _bus.Subscribe<SkyMapClickSelectSignal>(sig =>
        {
            // Match the render's viewing instant (planning date or now + the sky-map scrub offset) so a
            // scrubbed planet/comet dot hit-tests where it was drawn. All the projection + pinned-set
            // boilerplate lives in the shared SelectAtScreenPoint - the identical path the desktop uses.
            var viewingUtc = (_state.PlanningDate?.ToUniversalTime() ?? Time.GetUtcNow()) + skyState.TimeOffset;
            SkyMapSearchActions.SelectAtScreenPoint(
                skyState, Db, _state.SiteLatitude, _state.SiteLongitude, viewingUtc,
                sig.ScreenX, sig.ScreenY, sig.Modifiers, _state.Proposals, _state.Comets);
            skyState.NeedsRedraw = true;
            // Deferred for the same reason ViewInPlannerSignal defers its switch: this runs inside
            // RenderFrame's bus pump and NavigateTo raises LocationChanged synchronously.
            _ = InvokeAsync(SyncObjectToUrl);
        });

        _bus.Subscribe<SkyMapPinObjectSignal>(sig =>
        {
            // Pin/unpin the atlas selection into the planner. TogglePinFromExternal scores + profiles the
            // target (so the planner list can show it) and recomputes handoff sliders; the posted Save is
            // drained in this same pump (ProcessPending loops until the queue is empty).
            var target = new Target(sig.RA, sig.Dec, sig.Name, sig.Index);
            PlannerActions.TogglePinFromExternal(_state, Db, CreateSiteTransform(), target, sig.ObjectType);
            _bus.Post(new SavePlannerSessionSignal());
            skyState.NeedsRedraw = true;
        });

        _bus.Subscribe<ViewInPlannerSignal>(sig =>
        {
            // Score the target into the planner list (if not already), select + scroll it into view, then
            // switch to the Planner. The view switch is DEFERRED via InvokeAsync: SwitchView navigates,
            // which raises LocationChanged -> RenderFrame, and that would re-enter the bus pump we're in.
            var target = new Target(sig.RA, sig.Dec, sig.Name, sig.Index);
            if (!_state.ScoredTargets.ContainsKey(target))
            {
                PlannerActions.CommitSuggestion(_state, Db, CreateSiteTransform(), sig.Name, _state.Comets);
            }
            var filtered = PlannerActions.GetFilteredTargets(_state);
            for (var i = 0; i < filtered.Count; i++)
            {
                if (filtered[i].Target == target)
                {
                    _state.SelectedTargetIndex = i;
                    _tab?.EnsureVisible(i);
                    break;
                }
            }
            _ = InvokeAsync(() => SwitchView(View.Planner));
        });

        _bus.Subscribe<SkyMapSlewToObjectSignal>(sig =>
        {
            // Goto commands a connected mount - a desktop / hosted-server action. The browser has no
            // device layer, so surface a note rather than leaving the panel's Goto button silently dead.
            _ = sig;
            _status = "Goto needs a connected mount — not available in the browser.";
            _ = InvokeAsync(StateHasChanged);
        });
    }

    // Sets the status line and yields long enough for Blazor + the browser to actually paint it
    // before a following synchronous compute block freezes the single thread.
    async Task SetStatusAsync(string status)
    {
        _status = status;
        StateHasChanged();
        await Task.Delay(30);
    }

    // Comet ephemerides + the search autocomplete cache load off the critical path (mirrors the
    // desktop, where the tracker loads them in the background and markers appear when ready).
    // Best-effort: CORS/network failure leaves the session DSO-only. The autocomplete build walks
    // every catalog designation (interpreter-expensive on a dev run), so it must never sit on the
    // first-paint path; search commit works without it, suggestions just come online later.
    async Task LoadCometsInBackgroundAsync()
    {
        try
        {
            // This "background" task runs inline on the single browser thread until its first
            // await - yield so the first paint lands before the heavy build below.
            await Task.Delay(30);
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _autoComplete = PlannerActions.BuildAutoCompleteList(Db, null);
            Console.WriteLine($"[tianwen-web] search autocomplete: {sw.ElapsedMilliseconds} ms");

            sw.Restart();
            await Comets.EnsureLoadedAsync();
            // Fold comet designations/names into the search autocomplete (desktop parity:
            // AppSignalHandler rebuilds the cache on comet load).
            _autoComplete = PlannerActions.BuildAutoCompleteList(Db, Comets);
            Console.WriteLine($"[tianwen-web] comets loaded: {sw.ElapsedMilliseconds} ms");

            // A "?object=<comet>" deep link could not resolve until the repository was populated.
            ApplyPendingObjectSelection();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] comets unavailable (DSO-only session): {ex.Message}");
        }
    }

    // First Sky-Atlas open: fetch the full ~30 MB Tycho-2 catalog (stripped from the WASM bundle),
    // then decode + flatten it to star instances OFF the first-paint path and hand the buffer to
    // the sky pipeline for a render-thread swap. The HR bright-star seed stays on screen until it
    // lands. Best-effort: a 404 (dev server without the CI-baked asset) or any failure leaves the
    // HR field untouched - the atlas is a fine showcase either way. On single-threaded WASM the
    // decode + flatten are synchronous stalls, but they run after the atlas has already painted;
    // measuring the AOT wall-time here is what gates the P2 parallel-decode work (web-tycho2.md).
    // Bump when tyc2.bin.lz content OR the cached buffer format changes, so a stale IndexedDB
    // snapshot is discarded rather than fed to the DB. v2 = raw decompressed bytes (v1 cached the
    // flattened float buffer; raw enables clickable stars, which need the DB records + spatial index).
    const string Tyc2CacheVersion = "tyc2-v2-raw";

    async Task EnsureTycho2AtlasAsync()
    {
        try
        {
            // This "background" task runs inline until its first await; yield so the HR atlas
            // paints before the heavy work below (mirrors LoadCometsInBackgroundAsync).
            SetAtlasBusy(true, "Loading star catalog...");
            await Task.Delay(30);

            // Preferred path: fetch only the members the current view needs (web-tycho2.md). Falls
            // through to the whole-catalog path below if the member assets are not deployed, which
            // is what a dev server and any pre-member deploy look like.
            if (await TryStartIncrementalAtlasAsync())
            {
                return;
            }

            // Warm path: the raw decompressed catalog cached from a prior visit skips BOTH the
            // ~30 MB fetch and the lzip decompress. It feeds the SAME DB path as the cold decode
            // (records + spatial index), so click-to-identify works identically on a cached load.
            var cachedRaw = await TryReadTycho2CacheAsync();
            if (cachedRaw is { Length: > 0 })
            {
                await AtlasPhaseAsync("Building star field...");
                if (Db.TryLoadTycho2BulkFromDecoded(cachedRaw))
                {
                    FlattenAndSubmitTycho2("IndexedDB cache");
                    return;
                }
            }

            // Cold path: fetch the compressed catalog, decompress, wire the DB + spatial index,
            // flatten to the GPU, then cache the raw decompressed bytes for next time.
            var sw = System.Diagnostics.Stopwatch.StartNew();
            await AtlasPhaseAsync("Downloading star catalog (30 MB)...");
            var lz = await Http.GetByteArrayAsync("tyc2.bin.lz");
            Console.WriteLine($"[tianwen-web] tyc2 fetch: {lz.Length / (1024 * 1024)} MB in {sw.ElapsedMilliseconds} ms");

            sw.Restart();
            await AtlasPhaseAsync("Decompressing star catalog...");
            var raw = SharpAstro.Lzip.LzipDecoder.Decompress(lz);
            if (!Db.TryLoadTycho2BulkFromDecoded(raw))
            {
                Console.WriteLine("[tianwen-web] tyc2 decode produced no catalog; keeping the HR field");
                return;
            }
            Console.WriteLine($"[tianwen-web] tyc2 decompress: {raw.Length / (1024 * 1024)} MB in {sw.ElapsedMilliseconds} ms");

            await AtlasPhaseAsync("Building star field...");
            FlattenAndSubmitTycho2("decode");
            _ = SaveTycho2ToCacheAsync(raw); // persist the raw buffer (fire-and-forget; non-fatal)
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] Tycho-2 catalog unavailable (HR-only atlas): {ex.Message}");
        }
        finally
        {
            // In the finally so a 404 (a dev server with no baked catalog) cannot leave the app
            // permanently overlaid and unnavigable.
            SetAtlasBusy(false);
            RenderFrame();
        }
    }

    // ---- Incremental (per-member) atlas ------------------------------------------------------
    //
    // The catalog is also published as ~166 region-aligned lzip members plus a tiny manifest, so a
    // view fetches only the sky it is looking at: a 10-degree field is 9 files / 1.4 MiB against the
    // whole catalog's 28.7 MiB. Members are FILES rather than byte ranges of the one asset because
    // ranges are unusable on both candidate hosts -- GitHub Pages answers 206 over the GZIP
    // representation and Cloudflare Pages ignores Range entirely (docs/plans/web-tycho2.md).
    //
    // Absent regions are not "missing" from the buffer, they are filled with the catalog's own
    // no-data sentinel, so the completely unmodified star flatten skips them; see
    // Tycho2PartialCatalog for why that byte is 0xFF and why zero would paint a sky of impossibly
    // bright stars at the origin.
    Tycho2MemberManifest? _tyc2Manifest;
    Tycho2PartialCatalog? _tyc2Partial;
    Tycho2RegionSelector? _tyc2Selector;
    readonly List<int> _tyc2ScratchRegions = [];
    readonly List<int> _tyc2ScratchMembers = [];
    (long Ra, long Dec, long Fov) _tyc2ViewKey = (long.MinValue, 0, 0);
    bool _tyc2MembersActive;
    bool _tyc2FetchRunning;
    bool _tyc2FetchAgain;

    // The incremental chunk layout. Members are keyed into it as they arrive and a settle packs it;
    // only the member-path uses it (the whole-catalog fallback keeps FlattenAndSubmitTycho2).
    readonly StarChunkAccumulator _tyc2Accumulator = new();

    // Attempts the member path. Returns false (having changed nothing) when the assets are absent,
    // so the caller falls through to the whole-catalog fetch.
    async Task<bool> TryStartIncrementalAtlasAsync()
    {
        byte[] manifestBytes;
        try
        {
            manifestBytes = await Http.GetByteArrayAsync("tyc2/manifest.bin");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tyc2 members unavailable ({ex.Message}); using the whole catalog");
            return false;
        }

        try
        {
            var manifest = Tycho2MemberManifest.Read(manifestBytes);
            var selector = Tycho2RegionSelector.FromEmbeddedBounds();
            if (selector is null)
            {
                Console.WriteLine("[tianwen-web] GSC bounds are not embedded; using the whole catalog");
                return false;
            }

            await AtlasPhaseAsync("Loading star catalog...");

            // The header member carries the offset table, and nothing else can be placed until it
            // has: a member's position in the buffer is only knowable from it.
            var partial = new Tycho2PartialCatalog(manifest);
            if (!partial.Accept(0, await FetchMemberAsync(0)))
            {
                Console.WriteLine("[tianwen-web] tyc2 header member rejected; using the whole catalog");
                return false;
            }

            // Wire the DB once, now. The buffer is mutated in place as members land, so every later
            // member is visible to the DB with no re-wiring -- that aliasing is the whole point.
            if (!Db.TryLoadTycho2BulkFromDecoded(partial.Buffer))
            {
                Console.WriteLine("[tianwen-web] tyc2 partial buffer refused by the DB; using the whole catalog");
                return false;
            }

            _tyc2Manifest = manifest;
            _tyc2Partial = partial;
            _tyc2Selector = selector;
            _tyc2MembersActive = true;

            await AtlasPhaseAsync("Loading the sky you are looking at...");
            await FetchVisibleMembersAsync();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tyc2 member path failed ({ex.Message}); using the whole catalog");
            return false;
        }
    }

    async Task<byte[]> FetchMemberAsync(int member)
        => SharpAstro.Lzip.LzipDecoder.Decompress(
            await Http.GetByteArrayAsync($"tyc2/{Tycho2MemberManifest.MemberFileName(member)}"));

    // Single-flight with a re-check, so a gesture costs ONE rebuild rather than one per cell it
    // crosses. A drag walks through several quantized view cells, and the first version started a
    // fetch + a full re-flatten at every one of them: a measured pan produced six rounds, each
    // re-flattening every member held so far and re-uploading the whole instance buffer. Now a view
    // change during a running batch only raises a flag, and the batch re-evaluates once when it is
    // done -- which also means the final evaluation sees where the gesture ENDED.
    async Task FetchVisibleMembersAsync()
    {
        if (_tyc2FetchRunning)
        {
            _tyc2FetchAgain = true;
            return;
        }

        _tyc2FetchRunning = true;
        try
        {
            do
            {
                _tyc2FetchAgain = false;
                await FetchVisibleMembersOnceAsync();
            }
            while (_tyc2FetchAgain);
        }
        finally
        {
            _tyc2FetchRunning = false;
        }
    }

    // Fetches every member the current view needs and is not already holding, accumulating each into
    // the chunk layout as it lands. A member is keyed ONCE, here; the settle below is a concatenation.
    async Task FetchVisibleMembersOnceAsync()
    {
        if (_tyc2Manifest is not { } manifest || _tyc2Partial is not { } partial
            || _tyc2Selector is not { } selector || _skyTab is not { State: { } sky })
        {
            return;
        }

        _tyc2ScratchRegions.Clear();
        _tyc2ScratchMembers.Clear();
        // Radius = the FULL field of view, matching what both star pipelines already cull with
        // (StarChunkIndex.IsVisible), so the client fetches the sky it is about to try to draw.
        selector.SelectVisible(sky.CenterRA, sky.CenterDec, sky.FieldOfViewDeg, _tyc2ScratchRegions);
        manifest.MembersForRegions(_tyc2ScratchRegions, _tyc2ScratchMembers);

        var wanted = _tyc2ScratchMembers.Where(m => m > 0 && !partial.IsPresent(m)).ToArray();
        if (wanted.Length == 0)
        {
            return;
        }

        var sw = System.Diagnostics.Stopwatch.StartNew();

        // Which of these we already decoded on a previous visit. One probe for the whole batch, and
        // a cached member skips BOTH the network and the lzip decode -- the decode being the half
        // that costs main-thread time. A probe failure just reports nothing cached.
        var cached = await ProbeCachedMembersAsync(wanted);

        // Issue every request BEFORE awaiting any of them, and only for the members we do not already
        // have. Awaiting each in turn made a wide view 50 sequential round trips, which spends the
        // entire point of small files: the browser can have many in flight, and small independent
        // members are exactly what that is good at.
        var downloads = new Task<byte[]>?[wanted.Length];
        for (var i = 0; i < wanted.Length; i++)
        {
            downloads[i] = cached[i]
                ? null
                : Http.GetByteArrayAsync($"tyc2/{Tycho2MemberManifest.MemberFileName(wanted[i])}");
        }

        var landed = 0;
        var fromCache = 0;
        for (var i = 0; i < wanted.Length; i++)
        {
            var member = wanted[i];
            try
            {
                byte[] decoded;
                if (downloads[i] is { } body)
                {
                    var lz = await body;

                    // ONE MEMBER PER TASK. Decoding is ~15 ms of straight-line WASM, which is fine;
                    // what is not fine is a dozen of them back to back. `await body` completes
                    // SYNCHRONOUSLY once its download has landed -- the normal case here, since every
                    // request went out up front -- so without this the whole batch decodes inside one
                    // JS task and the page cannot paint until the last member is in. Measured on the
                    // deployed build, that batching WAS the residual jank after the chunk-build fix:
                    // 1183 ms of the 1443 ms still blocked over three pans, in tasks of 132-318 ms,
                    // every one ending at a "tyc2 members: +N" line. Split up, each decode lands under
                    // the 50 ms long-task threshold and the browser paints between them.
                    //
                    // Task.Delay(1), not Task.Yield(): a yield can be drained inside the current JS
                    // task by the runtime's own dispatcher, which would not end the frame this needs.
                    // It is the same load-bearing await AtlasPhaseAsync already relies on.
                    await Task.Delay(1);
                    decoded = SharpAstro.Lzip.LzipDecoder.Decompress(lz);
                    _ = SaveMemberToCacheAsync(member, decoded); // fire-and-forget; non-fatal
                }
                else
                {
                    decoded = await LoadMemberFromCacheAsync(member);
                    if (decoded.Length == 0)
                    {
                        // Evicted between the probe and the read. Fall back to the network rather than
                        // leaving a hole in the sky.
                        var lz = await Http.GetByteArrayAsync($"tyc2/{Tycho2MemberManifest.MemberFileName(member)}");
                        await Task.Delay(1);
                        decoded = SharpAstro.Lzip.LzipDecoder.Decompress(lz);
                    }
                    else
                    {
                        fromCache++;
                    }
                }

                if (partial.Accept(member, decoded))
                {
                    landed++;
                    AccumulateMemberStars(member);
                }
            }
            catch (Exception ex)
            {
                // One member failing is a hole in the sky, not a dead atlas: keep the rest.
                Console.WriteLine($"[tianwen-web] tyc2 member {member} failed: {ex.Message}");
            }
        }

        if (landed > 0)
        {
            Console.WriteLine($"[tianwen-web] tyc2 members: +{landed} of {wanted.Length} ({fromCache} cached) in "
                + $"{sw.ElapsedMilliseconds} ms ({partial.MembersPresent}/{partial.MemberCount} held)");
            ScheduleTycho2Flatten();
        }
    }

    // Flattens JUST the member that landed into the accumulator. This is the incremental half: the
    // whole-catalog flatten costs the same whether one member is held or all 166 (~74 ms on the
    // deployed build, because absent regions are still walked and skipped), so doing it per settle
    // made the pan path pay for every star it already had. Per member it is ~1 ms.
    void AccumulateMemberStars(int member)
    {
        if (_tyc2Partial is not { } partial || !partial.TryGetRecordRange(member, out var start, out var count))
        {
            return;
        }

        var sw = System.Diagnostics.Stopwatch.StartNew();
        var scratch = new float[count * SkyMapState.FloatsPerStar];
        var written = SkyMapState.FillTycho2StarVertices(Db, dtJulianYears: 0.0, scratch, start, count);
        if (written > 0)
        {
            _tyc2Accumulator.Add(scratch.AsSpan(0, written * SkyMapState.FloatsPerStar));
        }
        _tyc2AccumulateMs += sw.ElapsedMilliseconds;
    }

    async Task<bool[]> ProbeCachedMembersAsync(int[] members)
    {
        try
        {
            return await JS.InvokeAsync<bool[]>("tyc2Cache.hasMembers", Tyc2CacheVersion, members);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tyc2 member cache probe failed, fetching all: {ex.Message}");
            return new bool[members.Length];
        }
    }

    async Task<byte[]> LoadMemberFromCacheAsync(int member)
    {
        try
        {
            var streamRef = await JS.InvokeAsync<IJSStreamReference>("tyc2Cache.loadMember", Tyc2CacheVersion, member);
            await using var s = await streamRef.OpenReadStreamAsync(maxAllowedSize: 8L * 1024 * 1024);
            using var ms = new System.IO.MemoryStream();
            await s.CopyToAsync(ms);
            return ms.ToArray();
        }
        catch
        {
            return []; // treated as a miss; the caller re-fetches
        }
    }

    async Task SaveMemberToCacheAsync(int member, byte[] decoded)
    {
        try
        {
            using var ms = new System.IO.MemoryStream(decoded, writable: false);
            using var streamRef = new DotNetStreamReference(ms, leaveOpen: false);
            await JS.InvokeVoidAsync("tyc2Cache.saveMember", Tyc2CacheVersion, member, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tyc2 member {member} cache write failed (non-fatal): {ex.Message}");
        }
    }

    // The rebuild is DEBOUNCED, on the same generation-guard as the overlay labels and for the same
    // reason. Rebuilding is not cheap -- it re-walks all 2.5M record offsets, regroups the buffer
    // into chunks, and re-uploads the whole instance buffer -- and it does not get cheaper for
    // arriving more often, because it always covers every member held. A measured pan crossed six
    // quantized view cells and paid for all six; making the FETCH single-flight did not help,
    // because the fetches got fast enough to finish between crossings, which is the tell that the
    // REBUILD was the cost. During a gesture the stars are sliding past too fast to read anyway,
    // exactly as with the labels.
    //
    // Which HALF of the rebuild was expensive is a separate question, and it was guessed wrong for a
    // release: "the flatten" was blamed everywhere, while the deployed build's own log had it at
    // ~74 ms of a 2.4 s rebuild. The rest was a generic Span.Sort that Blazor WASM ran interpreted
    // (see StarMagnitudeIndex.SortBrightestFirst). It is now a counting scatter, and a rebuild here
    // measures 54-85 ms at ~1.4M stars held.
    int _tyc2SettleGeneration;
    bool _tyc2FlattenPending;

    void ScheduleTycho2Flatten()
    {
        _tyc2FlattenPending = true;
        var generation = ++_tyc2SettleGeneration;
        // Same shape as ScheduleLabelSettle: longer than a gesture's own event spacing so
        // mid-gesture requests supersede each other, but still a BACKSTOP that always fires -- a
        // gesture can end without a release reaching us, and a rebuild that waits for one that never
        // comes would leave the newly-fetched sky invisible until the next gesture ended.
        _ = SettleTycho2FlattenAsync(generation, _pointerGestureActive ? 700 : 120);
    }

    async Task SettleTycho2FlattenAsync(int generation, int delayMs)
    {
        await Task.Delay(delayMs);
        if (generation != _tyc2SettleGeneration || !_tyc2FlattenPending || _tyc2Partial is not { } partial)
        {
            return; // superseded by a later batch of the same gesture
        }

        // A fetch still in flight will schedule its own rebuild the moment it lands, so rebuilding
        // now buys one frame of slightly-fresher sky and pays for the whole thing twice. Measured, a
        // single pan repeatedly produced "+8 members -> rebuild" immediately followed by
        // "+1 member -> rebuild": the straggler's own view cell started a second fetch session that
        // the generation guard cannot merge, because it arrives AFTER this one has already fired.
        // Re-arming keeps the debounce's promise (one rebuild per settle) against a trickle, and the
        // backstop still holds -- the running fetch always ends, and its completion re-schedules.
        if (_tyc2FetchRunning)
        {
            _ = SettleTycho2FlattenAsync(generation, delayMs);
            return;
        }

        _tyc2FlattenPending = false;
        PackAndSubmitTycho2($"{partial.MembersPresent} members");
    }

    // The settle, now that arriving members are keyed as they land: concatenate the slots and hand
    // the buffer over with its table already built. No re-walk of the offset table, no re-keying of
    // stars that have not moved, and no comparison sort -- which is what the whole rebuild used to be.
    void PackAndSubmitTycho2(string source)
    {
        // Timed in THREE parts, permanently. The whole of this investigation turned on the app
        // already logging one phase and not the next: "the flatten" was blamed for a 2.4 s rebuild
        // it contributed 74 ms to, and only the deployed build's own log could settle it. An
        // external profile can see GL and JS but not which WASM phase it is inside, so the phases
        // say so themselves. Three integers a settle is not a cost worth saving.
        var sw = System.Diagnostics.Stopwatch.StartNew();
        var (verts, count, chunks) = _tyc2Accumulator.Pack();
        var packMs = sw.ElapsedMilliseconds;

        sw.Restart();
        _skyTab?.SubmitTycho2Stars(verts, count, chunks);
        var submitMs = sw.ElapsedMilliseconds;

        sw.Restart();
        RenderFrame(); // swap it in on the next paint
        Console.WriteLine($"[tianwen-web] tyc2 pack ({source}): {count} stars, "
            + $"pack {packMs} ms, submit {submitMs} ms, render {sw.ElapsedMilliseconds} ms, "
            + $"accumulate {_tyc2AccumulateMs} ms since last");
        _tyc2AccumulateMs = 0;
    }

    // Time spent keying arriving members into the accumulator since the last settle. Aggregated
    // rather than logged per member: a batch is up to 49 of them and the per-member number is only
    // interesting as a total against the settle it feeds.
    long _tyc2AccumulateMs;

    // Per-frame hook: fetch whatever the view now needs. The selector walks 9537 bounding boxes, so
    // it is gated on a QUANTIZED view key rather than run every frame.
    //
    // The cell size is derived from the BUCKETED field of view, never the raw one. Deriving it from
    // the raw value is the bug that made the object-overlay cache miss on every single zoom event
    // (69 gathers over a pinch against 8): the grid rescales continuously, so the rounded centre
    // moves even when the centre is perfectly still, and the quantization quantizes nothing.
    void MaybeFetchVisibleMembers()
    {
        if (!_tyc2MembersActive || _skyTab is not { State: { } sky })
        {
            return;
        }

        var fovBucket = (long)Math.Round(Math.Log(Math.Max(0.1, sky.FieldOfViewDeg)) * 8.0);
        var cellDeg = Math.Max(0.05, Math.Exp(fovBucket / 8.0) / 8.0);
        var key = (
            (long)Math.Round(sky.CenterRA * 15.0 / cellDeg),
            (long)Math.Round(sky.CenterDec / cellDeg),
            fovBucket);

        if (key == _tyc2ViewKey)
        {
            return;
        }

        _tyc2ViewKey = key;
        _ = FetchVisibleMembersAsync();
    }

    // Names the phase and gives the browser a frame to actually paint it before the next stall.
    // The await is load-bearing, not cosmetic: every phase below runs synchronously on the one WASM
    // thread, so a label set without yielding first is only ever rendered once the work it describes
    // has already finished.
    async Task AtlasPhaseAsync(string text)
    {
        SetAtlasBusy(true, text);
        await Task.Delay(30);
    }

    // Flattens the loaded Tycho-2 records to 5-float star instances (shared desktop builder, dt=0)
    // and hands them to the GPU pipeline for the render-thread swap over the HR seed.
    void FlattenAndSubmitTycho2(string source)
    {
        var sw = System.Diagnostics.Stopwatch.StartNew();

        // Size by the records actually HELD, not by Tycho2StarCount. The offset table describes the
        // whole catalog whether or not its members have been fetched, so the full count would
        // allocate ~51 MB to hold a couple of MB of stars -- on every member batch, on the one WASM
        // thread. A fresh array each time is deliberate: SubmitTycho2Stars keeps the reference for a
        // later render-thread upload and StarChunkIndex.Build reorders it in place, so reusing one
        // would rewrite a buffer the pipeline is still holding.
        var count = _tyc2Partial?.PresentRecordCount ?? Db.Tycho2StarCount;
        var verts = new float[count * SkyMapState.FloatsPerStar];
        var written = SkyMapState.FillTycho2StarVertices(Db, dtJulianYears: 0.0, verts);
        Console.WriteLine($"[tianwen-web] tyc2 flatten ({source}): {written} stars in {sw.ElapsedMilliseconds} ms");
        _skyTab?.SubmitTycho2Stars(verts, written);
        RenderFrame(); // swap it in on the next paint
    }

    // Reads the raw decompressed catalog from IndexedDB (a JS-to-.NET stream). Returns null on a
    // miss / version mismatch / any error (an empty stream = miss) so the caller fetches + decodes.
    async Task<byte[]?> TryReadTycho2CacheAsync()
    {
        try
        {
            // Existence check first, so a miss never opens a zero-length stream (Blazor's
            // OpenReadStreamAsync throws ArgumentOutOfRangeException "Length must be positive" on 0).
            if (!await JS.InvokeAsync<bool>("tyc2Cache.has", Tyc2CacheVersion))
            {
                return null;
            }

            var streamRef = await JS.InvokeAsync<IJSStreamReference>("tyc2Cache.load", Tyc2CacheVersion);
            await using var s = await streamRef.OpenReadStreamAsync(maxAllowedSize: 128L * 1024 * 1024);
            using var ms = new System.IO.MemoryStream();
            await s.CopyToAsync(ms);
            var bytes = ms.ToArray();
            return bytes.Length == 0 ? null : bytes;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tyc2 cache read failed, will fetch: {ex.Message}");
            return null;
        }
    }

    // Streams the raw decompressed catalog into IndexedDB (a .NET-to-JS stream) under the version key.
    async Task SaveTycho2ToCacheAsync(byte[] raw)
    {
        try
        {
            using var ms = new System.IO.MemoryStream(raw, writable: false);
            using var streamRef = new DotNetStreamReference(ms, leaveOpen: false);
            await JS.InvokeVoidAsync("tyc2Cache.save", Tyc2CacheVersion, streamRef);
            Console.WriteLine($"[tianwen-web] tyc2 cached to IndexedDB ({raw.Length / (1024 * 1024)} MB)");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[tianwen-web] tyc2 cache write failed (non-fatal): {ex.Message}");
        }
    }

    /// <param name="restoreFocus">
    /// True for the toolbar button, which took the keyboard by being clicked. False for a
    /// date-change recompute: nothing took focus, so pulling it to the canvas could yank it out of
    /// whatever the user is actually in.
    /// </param>
    async Task RecomputeAsync(bool restoreFocus = true)
    {
        if (restoreFocus)
        {
            RestoreCanvasFocus(); // the button click took the keyboard; give it straight back
        }
        if (_busy || _webGl is null) return;
        _busy = true;
        try
        {
            await ComputeAsync();
            RenderFrame();
        }
        finally
        {
            _busy = false;
        }
    }

    // Marks the frame dirty and ensures exactly one repaint lands on the next animation frame. Used by
    // the continuous-gesture handlers; see the field block and wwwroot/raf-pump.js.
    //
    // Falls back to painting synchronously when the pump is not up yet (the module import is async and
    // the first frames are painted during init). A dropped frame here would be a visibly stuck canvas,
    // so the fallback is "paint now", never "skip".
    // Debounced repaint that draws the overlay labels back once the view stops moving. Every frame
    // of a gesture bumps the generation, so only the LAST request survives its delay and exactly one
    // extra frame is painted per gesture.
    //
    // Answering immediately instead (an rAF) is the version that does not work: the repaint runs the
    // same suppression, asks again, and a 40-event gesture painted 159 frames -- each 2.5x cheaper
    // and more total work than doing nothing.
    int _labelSettleGeneration;

    // True between a press and its release (mouse, one-finger touch pan, or a pinch). A DELAY cannot
    // tell a pause from an end, which is what made the labels flicker: measured over a real touch
    // session, 3.7% of the gaps BETWEEN moves of a single gesture were longer than the 120 ms debounce
    // -- 33 of them -- so the labels blinked back on mid-drag and were hidden again by the next move.
    // Shortening the delay makes that worse (5.5% of gaps clear 60 ms) and lengthening it makes the
    // real settle late. A pointer gesture knows when it is over, so it says so instead of being timed.
    bool _pointerGestureActive;

    void ScheduleLabelSettle()
    {
        var generation = ++_labelSettleGeneration;
        // Mid-gesture this is only a BACKSTOP, not the settle: the release repaints with labels itself
        // (the view has not moved since the last frame, so nothing is suppressed). It exists because a
        // gesture can end without a release reaching us -- a pointercancel the app never sees -- and
        // without it the labels would then stay hidden until the next gesture ended. Set well past the
        // longest observed within-gesture pause (397 ms) so a genuine pause never trips it.
        var delayMs = _pointerGestureActive ? 700 : 120;
        _ = SettleLabelsAsync(generation, delayMs);
    }

    async Task SettleLabelsAsync(int generation, int delayMs)
    {
        // Longer than a frame, shorter than a deliberate pause: a gesture's own events arrive far
        // faster than this (median 8.3 ms, p90 26.5 ms), so mid-gesture requests supersede each other.
        await Task.Delay(delayMs);
        if (generation != _labelSettleGeneration || _skyTab is null)
        {
            return; // superseded by a later frame of the same gesture
        }
        RenderFrame();
    }

    void RequestRenderCoalesced()
    {
        if (_rafModule is null || _rafRef is null)
        {
            RenderFrame();
            return;
        }
        if (_rafPending)
        {
            _rafCoalesced++;
            return; // already dirty: costs nothing, not even an interop crossing
        }
        _rafPending = true;
        // Fire-and-forget by design: this is called from synchronous input handlers. A failure to
        // schedule would latch _rafPending and freeze the canvas, so clear it on the failure path.
        _ = ScheduleRepaintAsync();
    }

    async Task ScheduleRepaintAsync()
    {
        try
        {
            await _rafModule!.InvokeVoidAsync("schedule", _rafRef);
        }
        catch (Exception ex)
        {
            _rafPending = false;
            Logger.LogDebug(ex, "rAF repaint schedule failed; falling back to a direct paint");
            RenderFrame();
        }
    }

    /// <summary>
    /// The scheduled repaint. Public + [JSInvokable] so raf-pump.js can call it; not part of any
    /// contract otherwise.
    /// </summary>
    [JSInvokable]
    public void RenderFrameFromRaf()
    {
        // Cleared FIRST: if the paint below throws, the next gesture event must still be able to
        // schedule a frame rather than finding the flag latched forever.
        _rafPending = false;
        RenderFrame();
    }

    void RenderFrame()
    {
        if (_webGl is null || _tab is null) return;
        _renderFrames++;
        var frameStart = System.Diagnostics.Stopwatch.GetTimestamp();
        double busMs = 0, skyMs = 0, presentMs = 0, overlaySyncMs = 0, textLayerMs = 0;
        try
        {
            var phase = System.Diagnostics.Stopwatch.GetTimestamp();
            static double Since(ref long mark)
            {
                var now = System.Diagnostics.Stopwatch.GetTimestamp();
                var ms = System.Diagnostics.Stopwatch.GetElapsedTime(mark, now).TotalMilliseconds;
                mark = now;
                return ms;
            }
            // Web has no per-frame loop; every event ends in a RenderFrame, so this is the bus pump
            // (delivers the auto-posted SavePlannerSessionSignal after pin/slider mutations) and the
            // completion reaper for the tracked async saves.
            _bus.ProcessPending(_tracker);
            _tracker.ProcessCompletions(Logger);
            // A date change (PageUp / PageDown / N / T) only sets a flag; this is where it becomes a
            // rescore. Cheap: a field read, and it arms at most one settle at a time.
            CheckRecompute();
            busMs = Since(ref phase);
            _webGl.Clear(Background);
            var content = new RectF32(0f, 0f, _metrics.BackingWidth, _metrics.BackingHeight);
            if (_view == View.SkyMap && _skyTab is not null)
            {
                // First atlas paint: kick the lazy Tycho-2 fetch (once). Triggering here - rather than
                // in ApplyViewFromLocation - guarantees the pipeline exists (a deep-link resolves the
                // view before the renderer/tabs are created), and it naturally covers chip switches +
                // browser back/forward too.
                if (!_tycho2Requested)
                {
                    _tycho2Requested = true;
                    _ = EnsureTycho2AtlasAsync();
                }
                // On the member path, panning and zooming reveal sky we have not fetched. Cheap: it
                // returns immediately unless the quantized view key actually moved.
                MaybeFetchVisibleMembers();
                // DPI + font each have one owner: the widget's DpiScale / FontPath properties (the browser's
                // devicePixelRatio + resolved font, re-set per frame since the JS resize observer updates
                // _metrics / _fontPath out of band). The web host has no emoji font.
                _skyTab.DpiScale = (float)_metrics.DevicePixelRatio;
                _skyTab.FontPath = _fontPath;
                _skyTab.Render(_state, content, Time);
                skyMs = Since(ref phase);

                // The overlay skips its labels while the view is moving -- about half of a gesture's
                // frame time, spent on text sliding past too fast to read. There is no render loop
                // here to notice the motion has stopped, so the repaint that draws them back is
                // DEBOUNCED: every moving frame supersedes the last request, so one repaint lands at
                // the end of the gesture instead of one per event.
                if (_skyTab.OverlayLabelsPending)
                {
                    ScheduleLabelSettle();
                }
            }
            else
            {
                _tab.DpiScale = (float)_metrics.DevicePixelRatio;
                _tab.FontPath = _fontPath;
                _tab.Render(_state, content, Time, _mouse);
                skyMs = Since(ref phase);
            }
            _webGl.Present();
            presentMs = Since(ref phase);
            SyncOverlayRect(); // regions were re-registered by the Render above
            overlaySyncMs = Since(ref phase);
            SyncSelectableTextLayer();
            textLayerMs = Since(ref phase);
        }
        finally
        {
            // Measured here rather than read off a trace: the browser runs the whole paint inside the
            // animation-frame callback, so a trace cannot separate "the frame was slow" from "the
            // candidate gather inside it was slow". Paired with the tab's own gather timer it can.
            var frameMs = System.Diagnostics.Stopwatch.GetElapsedTime(frameStart).TotalMilliseconds;
            _renderMs += frameMs;
            _phaseBusMs += busMs;
            _phaseSkyMs += skyMs;
            _phasePresentMs += presentMs;
            _phaseOverlaySyncMs += overlaySyncMs;
            _phaseTextLayerMs += textLayerMs;
            if (frameMs >= 50.0)
            {
                _slowFrames++;
            }
            if (frameMs > _worstFrameMs)
            {
                _worstFrameMs = frameMs;
                _worstBusMs = busMs;
                _worstSkyMs = skyMs;
                _worstPresentMs = presentMs;
                _worstOverlaySyncMs = overlaySyncMs;
                _worstTextLayerMs = textLayerMs;
            }
        }
    }

    // ── Selectable-text DOM layer ─────────────────────────────────────────────
    // Mirrors the active tab's DrawSelectableText regions (backing px) into <CanvasTextLayer> runs
    // (CSS px) after every frame. Double-buffered: build into a scratch list (capacity reused, no
    // per-frame allocation), swap + StateHasChanged only when something actually changed — pointer
    // moves that repaint the canvas without touching the details text cost no Blazor re-render.
    List<OverlayTextRun> _textRuns = [];
    List<OverlayTextRun> _textRunsScratch = [];

    void SyncSelectableTextLayer()
    {
        if (ActivePixelTab is not { } tab) return;
        var regions = tab.SelectableTextRegions;
        var dpr = (float)(_metrics.DevicePixelRatio > 0 ? _metrics.DevicePixelRatio : 1);

        _textRunsScratch.Clear();
        var changed = regions.Length != _textRuns.Count;
        for (var i = 0; i < regions.Length; i++)
        {
            ref readonly var r = ref regions[i];
            var run = new OverlayTextRun(
                r.X / dpr, r.Y / dpr, r.Width / dpr, r.Height / dpr,
                r.Text, r.FontSize / dpr, r.Color, r.HorizontalAlign, r.VerticalAlign, r.Href);
            if (!changed && run != _textRuns[i]) changed = true;
            _textRunsScratch.Add(run);
        }

        if (changed)
        {
            (_textRuns, _textRunsScratch) = (_textRunsScratch, _textRuns);
            StateHasChanged();
        }
    }

    // Fullscreen via the Fullscreen API on the canvas's host container (F11 is browser-reserved and
    // unobservable by the page, so an edge-to-edge sky needs this in-app entry point; the titlebar +
    // toolbar sit outside the fullscreened subtree and vanish automatically).
    async Task ToggleFullscreenAsync()
    {
        if (_canvas is { } c) await c.ToggleFullscreenAsync();
        // After the transition, not before: entering fullscreen moves focus to the fullscreen element
        // itself, so a restore beforehand would be undone by the very call it precedes.
        RestoreCanvasFocus();
    }

    // Active view's widget for generic input routing (both are PixelWidgetBase<WebGlContext>).
    DIR.Lib.IPixelWidget? ActiveTab => _view == View.SkyMap ? _skyTab : _tab;

    // Resolves the active view from the current URL. Canonical form is the "?view=sky" query string
    // (aliases sky-atlas/skymap/atlas -> Sky Atlas; anything else, incl. no query -> Planner). Query
    // form - not a "/sky-atlas" PATH segment - so a shared link / browser refresh keeps the path at
    // the app root and GitHub Pages serves index.html rather than 404-ing (a project-site SPA has no
    // server-side rewrite for path segments). A legacy "/sky-atlas" path still resolves via the path
    // fallback below, so pre-query bookmarks (served through the 404.html SPA fallback) keep working.
    // RenderFrame is a safe no-op until the renderer exists - the init path paints explicitly once ready.
    void ApplyViewFromLocation()
    {
        var view = ParseViewFromQuery(Nav.ToAbsoluteUri(Nav.Uri).Query)
            ?? ParseViewFromPath(Nav.ToBaseRelativePath(Nav.Uri));
        if (view != _view)
        {
            // Leaving a view: release any focused canvas text input so its floating <input> overlay
            // doesn't linger over the next view (the chip is a DOM button, so no canvas pointer event
            // fires to deactivate it -- this is the single choke point for chip / back-forward / deep link).
            DeactivateTextInput();
            _view = view;
            RenderFrame();
        }
    }

    // The selection currently written into the URL, so LocationChanged can tell "the user picked
    // something and we are syncing the address bar" from "the address bar changed and we must apply
    // it". Without it the two drive each other in a loop.
    string? _urlObject;

    // "?object=<canonical>" -> the token, or null when absent.
    static string? ParseObjectFromQuery(string query)
    {
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq > 0 && part.AsSpan(0, eq).Equals("object", StringComparison.OrdinalIgnoreCase))
            {
                var value = Uri.UnescapeDataString(part[(eq + 1)..]);
                return string.IsNullOrWhiteSpace(value) ? null : value;
            }
        }
        return null;
    }

    // Mirror the current sky-map selection into "?object=". REPLACE rather than push, so a session of
    // clicking around the atlas does not bury the entry the user arrived on under one history entry
    // per click; the address bar still holds a shareable link to whatever is selected right now.
    void SyncObjectToUrl()
    {
        var token = _skyTab?.State.Search.InfoPanel is { } panel ? UrlTokenFor(panel) : null;
        if (string.Equals(token, _urlObject, StringComparison.Ordinal))
        {
            return;
        }

        _urlObject = token;
        var viewToken = _view == View.SkyMap ? "sky" : "planner";
        var url = token is { Length: > 0 }
            ? $"{Nav.BaseUri}?view={viewToken}&object={EscapeObjectToken(token)}"
            : $"{Nav.BaseUri}?view={viewToken}";
        Nav.NavigateTo(url, forceLoad: false, replace: true);
    }

    // What to write into "?object=". A COMET takes its display name ("10P/Tempel"), not its canonical
    // designation ("10P"): the designation alone is a bare catalogue number that says nothing about
    // which comet it is, and the full form is what the object calls itself everywhere else in the app.
    // Both resolve on the way back in -- CometSearchKeys.TryResolve accepts either -- so preferring the
    // informative one costs nothing. Everything else keeps the canonical index, which is the stable
    // identifier for a catalogued object (a common name like "Orion Nebula" is not).
    static string UrlTokenFor(SkyMapInfoPanelData panel)
        => panel.ObjType == ObjectType.Comet && !string.IsNullOrWhiteSpace(panel.Name)
            ? panel.Name
            : (string.IsNullOrWhiteSpace(panel.Canonical) ? panel.Name : panel.Canonical);

    // Uri.EscapeDataString escapes "/" to %2F, which is correct for a path segment and needless in a
    // query value -- RFC 3986 lists "/" among the characters a query may contain literally. Restoring
    // it keeps "10P/Tempel" readable in the address bar instead of "10P%2FTempel", and it round-trips
    // because UnescapeDataString leaves a bare "/" alone.
    static string EscapeObjectToken(string token) => Uri.EscapeDataString(token).Replace("%2F", "/", StringComparison.Ordinal);

    // Apply "?object=" from the address bar (deep link, refresh, back/forward). Resolves through the
    // SEARCH resolver rather than a catalog lookup, so a comet designation restores too -- comets are
    // not in the object DB, which is exactly the case a DB-only restore would silently drop.
    void ApplyObjectFromLocation()
    {
        var token = ParseObjectFromQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (string.Equals(token, _urlObject, StringComparison.Ordinal))
        {
            return;
        }

        _urlObject = token;
        if (_skyTab is not { State: { } skyState })
        {
            return; // resolved again by ApplyPendingObjectSelection once the tab exists
        }

        if (token is not { Length: > 0 })
        {
            skyState.Search.InfoPanel = null;
            skyState.NeedsRedraw = true;
            return;
        }

        var viewingUtc = (_state.PlanningDate?.ToUniversalTime() ?? Time.GetUtcNow()) + skyState.TimeOffset;
        var site = SiteContext.Create(_state.SiteLatitude, _state.SiteLongitude, viewingUtc);
        SkyMapSearchActions.TrySelectByToken(
            skyState.Search, skyState, Db, token,
            _state.SiteLatitude, _state.SiteLongitude, viewingUtc, site, _state.Comets);
        skyState.NeedsRedraw = true;
    }

    // A deep link is parsed before the catalog (and the comet set) has loaded, so the resolve above
    // can legitimately fail on the first attempt. Retried from every point where one of those inputs
    // has just become available: after the sky tab is constructed, after InitDBAsync, and after the
    // comet fetch settles.
    //
    // All three matter, and the first version only called it at the first, which is why "?object=M42"
    // put M42 in the address bar and left the view at the default pole: at that point the tab existed
    // but Db.InitDBAsync had not run yet (it is awaited inside ComputeAsync, further down
    // OnInitializedAsync), so the catalog was empty and the resolve simply answered false with nothing
    // to retry it. Idempotent and cheap -- it returns immediately once something is selected.
    void ApplyPendingObjectSelection()
    {
        if (_urlObject is not { Length: > 0 } token
            || _skyTab is not { State: { } skyState }
            || skyState.Search.InfoPanel is not null)
        {
            return;
        }

        var viewingUtc = (_state.PlanningDate?.ToUniversalTime() ?? Time.GetUtcNow()) + skyState.TimeOffset;
        var site = SiteContext.Create(_state.SiteLatitude, _state.SiteLongitude, viewingUtc);
        if (SkyMapSearchActions.TrySelectByToken(
                skyState.Search, skyState, Db, token,
                _state.SiteLatitude, _state.SiteLongitude, viewingUtc, site, _state.Comets))
        {
            skyState.NeedsRedraw = true;
        }
    }

    // "?view=<alias>" -> the view; null when the query carries no view key (so the caller falls back
    // to the legacy path form).
    static View? ParseViewFromQuery(string query)
    {
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0 || !part.AsSpan(0, eq).Equals("view", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            return MapViewToken(Uri.UnescapeDataString(part[(eq + 1)..]));
        }
        return null;
    }

    // Legacy path form ("/sky-atlas", "/skymap", "/sky") - kept so pre-query bookmarks still land on
    // the atlas. New navigation (SwitchView) only ever produces the query form.
    static View ParseViewFromPath(string path) => MapViewToken(path.TrimEnd('/'));

    static View MapViewToken(string token) => token.ToLowerInvariant() switch
    {
        "sky" or "sky-atlas" or "skymap" or "atlas" => View.SkyMap,
        _ => View.Planner,
    };

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyViewFromLocation();
        ApplyObjectFromLocation();
        StateHasChanged(); // chip active states + PageTitle (LocationChanged is not a Blazor event)
    }

    void SwitchView(View view)
    {
        // The chip click just moved DOM focus onto that button, so hand it back (see
        // RestoreCanvasFocus) -- BEFORE the early-out, so re-clicking the chip of the view you are
        // already on is not the one path that leaves the map deaf to the keyboard.
        RestoreCanvasFocus();
        if (_view == view) return;
        // Build the target from the app ROOT (Nav.BaseUri), NEVER from the current URI, and always
        // stamp an EXPLICIT "?view=" - "?view=planner" as well as "?view=sky" (symmetric + shareable).
        // Deriving the Planner URL from the current one (removing the "view" query param) left a legacy
        // "/sky-atlas" PATH deep-link unchanged -> NavigateTo no-op'd -> the Planner chip looked dead;
        // a root-built explicit query clears BOTH the path and any old query every time. Both forms
        // keep the path at the app root, so a refresh/share stays 404-safe on GitHub Pages (see
        // ApplyViewFromLocation, which also treats a bare root as the Planner default).
        // OnLocationChanged syncs the URL back to the active view + chips.
        var objectSuffix = _urlObject is { Length: > 0 } token ? $"&object={EscapeObjectToken(token)}" : "";
        Nav.NavigateTo($"{Nav.BaseUri}?view={(view == View.SkyMap ? "sky" : "planner")}{objectSuffix}");
    }

    // --- E2E view-state inspection hook (activated by ?e2e=1) --------------------------------
    // The sky atlas is a single WebGL canvas with no DOM to inspect, so a browser test can't read
    // zoom/pan the way a DOM-mirrored canvas app (e.g. Drawboard) can. This hook exposes the live
    // view state to window.__tianwenTest.getSkyView() (wired by the index.html shim), gated on a URL
    // flag so it is inert in a normal session. Read-only - it never mutates state.

    bool IsE2ETestMode()
        => Nav.ToAbsoluteUri(Nav.Uri).Query.Contains("e2e=1", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// <see cref="IsE2ETestMode"/> latched at the moment the test ref was handed out. Ask THIS, never
    /// the URL, after startup: <see cref="SwitchView"/> navigates to "?view=sky" and the flag is gone
    /// from the query the moment the user (or a test) leaves the planner.
    /// </summary>
    bool _isE2ETestSession;

    // Live sky-map view state as JSON (fov + centre), invoked from the index.html test shim. Returns
    // "null" before the sky tab exists. Hand-built JSON (no JsonSerializerContext) keeps it AOT-trivial.
    [JSInvokable]
    public string GetSkyViewJson()
    {
        if (_skyTab is not { State: { } s })
        {
            return "null";
        }
        var ci = CultureInfo.InvariantCulture;
        return "{\"fovDeg\":" + s.FieldOfViewDeg.ToString(ci)
            + ",\"centerRA\":" + s.CenterRA.ToString(ci)
            + ",\"centerDec\":" + s.CenterDec.ToString(ci) + "}";
    }

    // The planner search box + autocomplete rows are canvas-drawn, so a browser E2E has no DOM to click
    // to reach them. These return the arranged clickable rects (CSS px, relative to the canvas host) so a
    // Playwright test can click the canvas at the exact spot -- the "assert canvas state without pixels"
    // pattern GetSkyViewJson uses, applied to interaction targets. Read-only; wired only under ?e2e=1.
    // Repaint accounting, so the two perf properties this app depends on are assertable from a browser
    // test instead of only from a hand-read Chrome trace:
    //   coalesced - repaints the frame pump skipped because the frame was already dirty. A continuous
    //               gesture must produce some; zero means every event painted its own frame again.
    //   gathers   - object-overlay candidate gathers. Bounded per FOV bucket / pan cell, so a gesture
    //               must NOT produce one per event (see SkyMapOverlayCacheKeyTests).
    //   uploads   - overlay instance-buffer re-uploads. Bounded by the same reasoning as gathers but
    //               on a DIFFERENT axis: the gather is cached across a pan AND a wide zoom, while the
    //               instances additionally depend on the arcmin-to-pixel scale, so a zoom is expected
    //               to re-upload and a pan is expected not to.
    //   overlay   - whether the [O] catalog overlay is on. Reported because it is OFF by default and
    //               the gather is skipped entirely when it is off: without this a test asserting
    //               "gathers stay bounded" passes on zero, i.e. passes while measuring nothing. The
    //               first version of the E2E did exactly that and passed with the fix reverted.
    [JSInvokable]
    public string GetRenderStatsJson()
        => "{\"frames\":" + _renderFrames.ToString(CultureInfo.InvariantCulture)
            + ",\"coalesced\":" + _rafCoalesced.ToString(CultureInfo.InvariantCulture)
            + ",\"gathers\":" + (_skyTab?.PrimOverlayGathers ?? 0).ToString(CultureInfo.InvariantCulture)
            + ",\"overlay\":" + ((_skyTab?.State.ShowObjectOverlay ?? false) ? "true" : "false")
            // pins - reported for exactly the reason `overlay` is. The overlay pass runs on every frame
            // whenever anything is pinned and early-outs when nothing is, so a test asserting the
            // gather stays bounded WITH pins passes trivially on zero pins, i.e. passes while measuring
            // the other branch. Assert pins > 0 beside any such bound.
            + ",\"pins\":" + (_state.Proposals.Length).ToString(CultureInfo.InvariantCulture)
            // cands - what the last gather produced. With both layers off and N targets pinned this
            // must be N: the pass is drawing landmarks and nothing else, so anything larger is work
            // the caller is about to discard.
            + ",\"cands\":" + (_skyTab?.PrimOverlayCandidateCount ?? 0).ToString(CultureInfo.InvariantCulture)
            + ",\"renderMs\":" + _renderMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"gatherMs\":" + (_skyTab?.PrimOverlayGatherMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"uploads\":" + (_skyTab?.OverlayInstanceUploads ?? 0).ToString(CultureInfo.InvariantCulture)
            + ",\"projectMs\":" + (_skyTab?.PrimOverlayProjectMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"markerMs\":" + (_skyTab?.PrimOverlayMarkerMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"labelMs\":" + (_skyTab?.PrimOverlayLabelMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            // documentKeys - keys the document listener delivered because the canvas did not have
            // focus. Reported for the same reason `overlay` is: a test that presses at the document
            // and sees the map react cannot otherwise tell the FALLBACK carrying the key from focus
            // having been on the canvas all along, and the second passes with the fallback removed.
            + ",\"documentKeys\":" + _documentKeys.ToString(CultureInfo.InvariantCulture)
            // Phase totals, and the split of the WORST single frame -- see the fields' remarks for
            // why a total alone cannot find a phase that only fires on the slowest 1% of repaints.
            + ",\"slowFrames\":" + _slowFrames.ToString(CultureInfo.InvariantCulture)
            + ",\"busMs\":" + _phaseBusMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"skyMs\":" + _phaseSkyMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"presentMs\":" + _phasePresentMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"overlaySyncMs\":" + _phaseOverlaySyncMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"textLayerMs\":" + _phaseTextLayerMs.ToString("F1", CultureInfo.InvariantCulture)
            // Inside skyMs: the CPU-vs-GPU split of the map draw. 96% of a repaint is skyMs, and
            // these say which half of it, which decides the fix.
            + ",\"skyBgMs\":" + (_skyTab?.SkyBackgroundMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"skyGeomMs\":" + (_skyTab?.SkyGeometryMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"skyUpdateMs\":" + (_skyTab?.SkyUpdateFrameMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"skyDrawMs\":" + (_skyTab?.SkyDrawMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            // The label layers drawn ON TOP of the map, which are the rest of skyMs. Ranked rather
            // than inferred: they are sky-anchored, so the fix for an expensive one is to skip it
            // while the view moves (as the object overlay already does), not to cache its geometry.
            + ",\"lblGrid\":" + (_skyTab?.GridLabelMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblConst\":" + (_skyTab?.ConstellationNameMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblPlanet\":" + (_skyTab?.PlanetLabelMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblComet\":" + (_skyTab?.CometLabelMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblOverlay\":" + (_skyTab?.ObjectOverlayMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblFixed\":" + (_skyTab?.FixedMarkerMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblInfo\":" + (_skyTab?.InfoStripMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"lblSearch\":" + (_skyTab?.SearchPanelMs ?? 0).ToString("F1", CultureInfo.InvariantCulture)
            + ",\"worst\":{\"frameMs\":" + _worstFrameMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"busMs\":" + _worstBusMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"skyMs\":" + _worstSkyMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"presentMs\":" + _worstPresentMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"overlaySyncMs\":" + _worstOverlaySyncMs.ToString("F1", CultureInfo.InvariantCulture)
            + ",\"textLayerMs\":" + _worstTextLayerMs.ToString("F1", CultureInfo.InvariantCulture) + "}}";

    /// <summary>
    /// Pins (or unpins) a catalog object by designation and returns the resulting pin count, so an E2E
    /// can put the app in the configuration a real user is in. Not merely convenience: the object-overlay
    /// pass takes a completely different branch once anything is pinned, and every perf measurement taken
    /// so far ran against an empty planner and therefore against the branch nobody is on.
    /// Returns "null" when the catalog is not loaded or the designation does not resolve.
    /// </summary>
    [JSInvokable]
    public string PinObjectForTest(string catalogName)
    {
        // Every other hook here is read-only; this one MUTATES, so it re-checks the gate itself rather
        // than relying only on the .NET ref never being handed out outside ?e2e=1. The LATCHED flag,
        // not the URL -- switching to the sky view rewrites the query and drops "e2e=1", so the live
        // check answers false for every call a test makes after its first chip click, which is all of
        // them. (Found the hard way: this hook returned "null" against the deployed build and looked
        // like an unresolvable catalog name.)
        if (!_isE2ETestSession)
        {
            return "null";
        }

        // Distinct reasons rather than a bare "null", so a failure names itself instead of sending the
        // reader to the catalog when the gate, or the load order, is what refused.
        if (_state.ObjectDb is not { } db)
        {
            return "\"no-catalog\"";
        }
        if (!CatalogUtils.TryGetCleanedUpCatalogName(catalogName, out var idx))
        {
            return "\"unparsed\"";
        }
        if (!db.TryLookupByIndex(idx, out var obj))
        {
            return "\"unresolved\"";
        }

        PlannerActions.ToggleProposal(_state, new Target(obj.RA, obj.Dec, obj.DisplayName, obj.Index));
        RenderFrame();
        return _state.Proposals.Length.ToString(CultureInfo.InvariantCulture);
    }

    [JSInvokable]
    public string GetPlannerSearchRectJson()
        => RegionRectCssJson(r => r.Result is HitResult.TextInputHit { Input: { } i } && ReferenceEquals(i, _state.SearchInput));

    [JSInvokable]
    public string GetPlannerSuggestionRectJson(int index)
        => RegionRectCssJson(r => r.Result is HitResult.ListItemHit { ListId: "Suggestion", Index: var idx } && idx == index);

    // Finds the first registered clickable matching the predicate and returns its rect as CSS px, or
    // "null" when absent (widget not rendered / dropdown not shown). Regions are re-registered every
    // frame, so this reflects the last painted layout.
    string RegionRectCssJson(Func<ClickableRegion, bool> match)
    {
        if (ActivePixelTab is { } tab)
        {
            var dpr = (float)(_metrics.DevicePixelRatio > 0 ? _metrics.DevicePixelRatio : 1);
            var ci = CultureInfo.InvariantCulture;
            foreach (var region in tab.GetRegisteredRegions())
            {
                if (match(region))
                {
                    return "{\"x\":" + (region.X / dpr).ToString(ci)
                        + ",\"y\":" + (region.Y / dpr).ToString(ci)
                        + ",\"w\":" + (region.Width / dpr).ToString(ci)
                        + ",\"h\":" + (region.Height / dpr).ToString(ci) + "}";
                }
            }
        }
        return "null";
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _testRef?.Dispose();
        _rafRef?.Dispose();
        _docKeysRef?.Dispose();
        // Detach BEFORE releasing the module: the listener is the only thing still holding a reference
        // to this component, and one left on the document goes on invoking into a disposed page.
        if (_docKeysHandle is not null)
        {
            await DisposeJsAsync(_docKeysHandle, "document-keys.js listener", detach: true);
        }
        if (_docKeysModule is not null)
        {
            await DisposeJsAsync(_docKeysModule, "document-keys.js module", detach: false);
        }
        if (_rafModule is not null)
        {
            // A JS module reference can only be released asynchronously, which is why this component is
            // IAsyncDisposable. Teardown ordering is not guaranteed (the circuit may already be gone,
            // and on a WASM page unload it always is), so a failure here is expected, not exceptional.
            try
            {
                await _rafModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Page going away; the module dies with it.
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "raf-pump.js module disposal failed during teardown");
            }
        }
    }

    // Teardown ordering is not guaranteed (the circuit may already be gone, and on a WASM page unload
    // it always is), so a failure here is expected rather than exceptional -- the same reasoning as the
    // rAF module's disposal above, which predates this helper and is left inline beside its own comment.
    async ValueTask DisposeJsAsync(IJSObjectReference reference, string what, bool detach)
    {
        try
        {
            if (detach)
            {
                await reference.InvokeVoidAsync("detach");
            }
            await reference.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Page going away; the listener and the module die with it.
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "{What} disposal failed during teardown", what);
        }
    }

    // --- Input: routed through the tab's InputEvent handler, mirroring the desktop host ---------
    // WebGlCanvas delivers coordinates pre-mapped to backing space; no dpr scaling here.

    void OnPointerDown(CanvasPointerEventArgs e)
    {
        if (CanvasInputBlocked) return;
        if (ActiveTab is not { } tab || e.Original.Button != 0) return;
        _pointerGestureActive = true; // a pause inside a drag is not the end of it (see ScheduleLabelSettle)
        var mods = ToModifiers(e.Original);
        // Desktop order (GuiEventHandlerBase): hit-test the registered clickable regions FIRST
        // (planet/comet labels, reticles, planner rows), then feed the result to the shared
        // handoff-divider interaction, and only forward an unclaimed press to the tab's
        // HandleInput (drag-pan, scrollbar). The sky map's HandleInput consumes EVERY press for
        // drag tracking, so hit-testing last would make all its labels unclickable.
        var hit = tab.HitTestAndDispatch(e.X, e.Y, mods);

        // Text-input focus management (desktop: GuiEventHandlerBase's TextInputHit branch).
        if (hit is HitResult.TextInputHit { Input: { } clickedInput })
        {
            ActivateTextInput(clickedInput, (int)e.Original.Detail);
            RenderFrame();
            return;
        }

        var sliderHandled = _view == View.Planner && _tab is not null
            && PlannerSliderInteraction.HandleMouseDown(_state, hit, _tab.ChartRect, e.X, e.Y);
        if (sliderHandled)
        {
            RenderFrame();
            return;
        }

        // Clicking outside a text input releases focus (after the slider branch, mirroring the
        // desktop order - a slider grab keeps the focused input).
        DeactivateTextInput();

        // A press on the map claims the keyboard for it. This also covers a ONE-FINGER touch pan, which
        // the JS bridge routes through these same pointer callbacks (see RestoreCanvasFocus for why
        // touch cannot do it for itself).
        RestoreCanvasFocus();

        if (hit is null)
        {
            tab.HandleInput(new InputEvent.MouseDown(e.X, e.Y, Modifiers: mods, ClickCount: (int)e.Original.Detail));
        }
        RenderFrame();
    }

    void OnPointerMove(CanvasPointerEventArgs e)
    {
        if (CanvasInputBlocked) return;
        if (ActiveTab is not { } tab) return;
        _mouse = (e.X, e.Y);
        // An active divider drag consumes the move (shared state machine with the desktop
        // event handler); otherwise the tab gets it for hover / drag / scrollbar handling.
        if (_view != View.Planner || _tab is null
            || !PlannerSliderInteraction.HandleMouseMove(_state, _tab.ChartRect, e.X))
        {
            tab.HandleInput(new InputEvent.MouseMove(e.X, e.Y));
        }
        // Coalesced: a drag delivers several moves per vsync and only the last is ever presented.
        RequestRenderCoalesced(); // mouse-follower / sky-map drag pan
    }

    void OnPointerUp(CanvasPointerEventArgs e)
    {
        // The release CLEARS the gesture flag before anything can return: a press that began before
        // the atlas landed would otherwise end while input is blocked and leave the flag stuck on, so
        // the labels would stay suppressed until the 700 ms backstop caught every later frame.
        _pointerGestureActive = false;
        if (CanvasInputBlocked) return;
        if (ActiveTab is not { } tab) return;
        tab.HandleInput(new InputEvent.MouseUp(e.X, e.Y));
        if (_view == View.Planner)
        {
            PlannerSliderInteraction.HandleMouseUp(_state);
        }
        RenderFrame();
    }

    // A browser reports a TOUCHPAD PINCH as a wheel event with ctrlKey set. There is no pinch event
    // and no touch event, so without this the gesture arrived as a burst of plain scrolls and zoomed
    // in coarse jumps -- it never reached HandlePinchZoom, never got tagged PinchSource.Touchpad, and
    // so missed the centre-anchored, dedup-guarded path that exists for exactly this gesture (which is
    // why the touchSCREEN pinch felt better: it is different code, arriving as a real Pinch).
    //
    // Pixels per e-fold of zoom. A cumulative deltaY of 100 px is then a factor of exp(100/144) ~ 2,
    // which is about one comfortable pinch.
    const double PinchPixelsPerEFold = 144.0;

    // DeltaMode is an ENUM, not a unit: 0 = pixels, 1 = lines, 2 = pages. Chrome sends pixels with
    // deltaY ~100 per wheel notch, Firefox sends lines with deltaY = 3. Dividing both by a hardcoded
    // 100 (what this did) made one browser's notch a 15% zoom and the other's 0.45%, and made the same
    // physical gesture behave differently per device on the same browser.
    static double WheelPixels(CanvasWheelEventArgs e) => e.DeltaMode switch
    {
        1 => e.DeltaY * 16.0,   // lines -> px, at a nominal line height
        2 => e.DeltaY * 800.0,  // pages -> px, at a nominal viewport height
        _ => e.DeltaY,          // already pixels
    };

    void OnWheel(CanvasWheelEventArgs e)
    {
        if (CanvasInputBlocked) return;
        if (ActiveTab is not { } tab) return;
        var pixels = WheelPixels(e);

        if (e.Original.CtrlKey)
        {
            // Relative per-event factor, the same convention the touch bridge produces: fingers apart
            // (deltaY < 0) gives Scale > 1. PinchEnd immediately after, because a wheel stream has no
            // end event and IsPinching left latched would swallow every later drag.
            var scale = Math.Exp(-pixels / PinchPixelsPerEFold);
            tab.HandleInput(new InputEvent.Pinch((float)scale, e.X, e.Y) { Source = PinchSource.Touchpad });
            tab.HandleInput(new InputEvent.PinchEnd());
            // Coalesced: a trackpad pinch is the densest gesture the app sees - a continuous stream of
            // ctrl+wheel events, several per vsync.
            RequestRenderCoalesced();
            return;
        }

        // Browser deltaY > 0 = wheel down; the tab uses the SDL convention (positive = up).
        var scrollY = (float)(-pixels / 100.0);
        tab.HandleInput(new InputEvent.Scroll(scrollY, e.X, e.Y));
        RequestRenderCoalesced(); // a wheel stream is continuous too
    }

    // Two-finger pinch (touchscreen): drive the shared sky-map zoom the same way the desktop SDL host
    // does (TianWen.UI.Gui Program.cs OnPinch). WebGlCanvas already anchors at the finger midpoint in
    // backing space; Source=Touchscreen tells SkyMapTab to zoom around that point (not the view centre).
    // SINGLE-finger pan needs no handler here - WebGlCanvas bridges a lone finger to OnPointerDown/Move/Up,
    // so the existing drag-pan handles it for free.
    void OnPinch(CanvasPinchEventArgs e)
    {
        if (CanvasInputBlocked) return;
        if (ActiveTab is not { } tab) return;
        _pointerGestureActive = true; // fingers still down; the pinch END is what settles the labels
        tab.HandleInput(new InputEvent.Pinch((float)e.Scale, e.X, e.Y) { Source = PinchSource.Touchscreen });
        RequestRenderCoalesced(); // touchscreen pinch: same density as the trackpad one
    }

    void OnPinchEnd()
    {
        // Cleared before any early-out, for the same reason as OnPointerUp above.
        _pointerGestureActive = false;
        if (CanvasInputBlocked) return;
        if (ActiveTab is not { } tab) return;
        tab.HandleInput(new InputEvent.PinchEnd());
        // Driving the map with two fingers is as clear a claim on it as a click, and touch cannot take
        // focus by itself (RestoreCanvasFocus explains why). Done on END, not on every pinch step: a
        // pinch delivers a move per touchmove and a focus call per frame would be pure interop traffic.
        RestoreCanvasFocus();
        RenderFrame();
    }

    void OnKeyDown(KeyboardEventArgs e) => HandleKey(e.Key, e.ShiftKey, e.CtrlKey, e.AltKey);

    /// <summary>
    /// A key the DOCUMENT saw, delivered because the canvas did not have focus. Public + [JSInvokable]
    /// so document-keys.js can call it; not part of any contract otherwise.
    /// </summary>
    /// <remarks>
    /// This is the same path as the canvas's own keydown, deliberately -- there is one keyboard and one
    /// meaning for [O], so a second entry point that handled keys its own way would be two behaviours
    /// waiting to diverge. The JS side has already decided the app is entitled to this key (it skips
    /// editables, the canvas itself, Tab, and a button's activation keys), so nothing is re-judged here.
    /// </remarks>
    [JSInvokable]
    public void HandleDocumentKey(string key, bool shift, bool ctrl, bool alt)
    {
        _documentKeys++;
        HandleKey(key, shift, ctrl, alt);
    }

    void HandleKey(string eventKey, bool shift, bool ctrl, bool alt)
    {
        if (ActiveTab is not { } tab) return;
        var mods = (shift ? InputModifier.Shift : 0) | (ctrl ? InputModifier.Ctrl : 0) | (alt ? InputModifier.Alt : 0);
        var key = MapKey(eventKey);

        // A focused text input swallows every key first (desktop: GuiEventHandlerBase's
        // active-input branch). Printable characters then insert as text - the browser keydown
        // carries the character itself, where the SDL host gets a separate TextInput event.
        // Clipboard delegates stay null for now: the browser clipboard API is async-only, so
        // Ctrl+V paste into canvas inputs is a deferred follow-up.
        if (_focus.Current is { } active)
        {
            if (key != InputKey.None)
            {
                TextInputInteraction.HandleKey(key, mods, new TextInputInteraction.KeyContext(
                    Tracker: _tracker,
                    Focus: _focus,
                    RequestRedraw: () => { }, // the RenderFrame below covers this event
                    ActiveSearch: ResolveActiveSearch(active),
                    TabFields: tab.GetRegisteredTextInputs));
            }
            if (eventKey.Length == 1 && !ctrl && !alt)
            {
                TextInputInteraction.HandleText(active, eventKey);
            }
            RenderFrame();
            return;
        }

        var handled = key != InputKey.None && tab.HandleInput(new InputEvent.KeyDown(key, mods));

        // Printable characters additionally flow as text (the SDL host sends both KeyDown +
        // TextInput too; the tab's focused-text-input handling sorts out which one applies).
        if (eventKey.Length == 1 && !ctrl && !alt)
        {
            handled |= tab.HandleInput(new InputEvent.TextInput(eventKey));
        }

        if (handled)
        {
            RenderFrame();
        }
    }

    static InputModifier ToModifiers(MouseEventArgs e)
        => (e.ShiftKey ? InputModifier.Shift : 0) | (e.CtrlKey ? InputModifier.Ctrl : 0) | (e.AltKey ? InputModifier.Alt : 0);

    // Browser KeyboardEvent.Key -> the platform-agnostic InputKey (the web analogue of the SDL
    // scancode map in TianWen.UI.Shared).
    static InputKey MapKey(string key) => key switch
    {
        "ArrowUp" => InputKey.Up,
        "ArrowDown" => InputKey.Down,
        "ArrowLeft" => InputKey.Left,
        "ArrowRight" => InputKey.Right,
        "Home" => InputKey.Home,
        "End" => InputKey.End,
        "PageUp" => InputKey.PageUp,
        "PageDown" => InputKey.PageDown,
        "Enter" => InputKey.Enter,
        "Escape" => InputKey.Escape,
        "Tab" => InputKey.Tab,
        " " => InputKey.Space,
        "Backspace" => InputKey.Backspace,
        "Delete" => InputKey.Delete,
        "+" => InputKey.Plus,
        "-" => InputKey.Minus,
        "." => InputKey.Period,
        "," => InputKey.Comma,
        "/" => InputKey.Slash,
        "\\" => InputKey.Backslash,
        ";" => InputKey.Semicolon,
        "'" => InputKey.Quote,
        "[" => InputKey.BracketLeft,
        "]" => InputKey.BracketRight,
        "`" => InputKey.Grave,
        ['F', var d] when d is >= '1' and <= '9' => InputKey.F1 + (d - '1'),
        "F10" => InputKey.F10,
        "F11" => InputKey.F11,
        "F12" => InputKey.F12,
        [var c] when c is >= 'a' and <= 'z' => InputKey.A + (c - 'a'),
        [var c] when c is >= 'A' and <= 'Z' => InputKey.A + (c - 'A'),
        [var c] when c is >= '0' and <= '9' => InputKey.D0 + (c - '0'),
        _ => InputKey.None,
    };
}
