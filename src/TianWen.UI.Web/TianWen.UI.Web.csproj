<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The in-browser app is a consumer of TianWen.Lib / TianWen.UI.Abstractions, not a shipped
         package and not part of the desktop test/release chain, and it lives OUTSIDE TianWen.slnx.
         It is nonetheless under Central Package Management like every other project here: it used to
         opt out, so that the Blazor deps could carry their own versions without touching
         Directory.Packages.props, and the cost of that convenience was WebGl.Renderer. Pinned inline,
         it was invisible to a sweep of the props file, so it drifted two minors behind and became the
         last sibling built against DIR.Lib 7.0 while the rest moved to 7.4. Being outside a solution
         has no bearing on CPM, which resolves by walking directories, so there was never a technical
         reason for the opt-out. All three versions now live in Directory.Packages.props. -->
    <IsPackable>false</IsPackable>
    <!-- No culture data needed; dropping ICU trims the payload. Site timezone resolves via the
         bundled wasm tzdata (TimeZoneInfo), which is independent of ICU; the planner falls back to
         UTC if a zone id cannot be resolved (Transform.TryGetSiteTimeZone). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Default (full) trimming: TianWen.Lib is IsTrimmable + IsAotCompatible (the native binaries
         already publish AOT), and embedded catalog resources survive trimming regardless (they are
         resources, not IL), so the catalog DB + planner load fine under a trimmed build - no
         TrimmerRootAssembly rooting needed. Keeps the WASM download small. -->
    <!-- This is a lightweight build: the ~30 MB Tycho-2 catalog is dropped via the GLOBAL publish
         property -p:Lightweight=true (see TianWen.Lib.csproj) - the pages.yml deploy passes it, same
         slot as -p:UseLocalSiblings=false. A property set HERE would not flow across the
         ProjectReference into TianWen.Lib's own build, so it must ride the publish command line. -->
  </PropertyGroup>

  <!-- The browser draws the sky and plans a night. It calibrates no image's colour and runs no simulated camera, so
       the two groups of TianWen.Lib's embedded data it never reads are trimmed out of its download (#2155; the groups
       are in TianWen.Lib's ILLink.Substitutions.xml). Stars stays embedded: the atlas picks its Tycho-2 tiles with its region bounds, and the
       cross-reference snapshot is checked against the rest. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="TianWen.Lib.EmbeddedData.Imaging" Value="false" Trim="true" />
    <RuntimeHostConfigurationOption Include="TianWen.Lib.EmbeddedData.FakeDevices" Value="false" Trim="true" />
    <!-- The sky's own catalogues are switched off in the assembly too, and served as plain files beside the app
         (StageSkyDataFiles below, read through HttpDataFiles in Program.cs): a new build of the code then leaves
         them in a visitor's cache instead of sending them again inside TianWen.Lib (#2161). -->
    <RuntimeHostConfigurationOption Include="TianWen.Lib.EmbeddedData.Sky" Value="false" Trim="true" />
  </ItemGroup>

  <!-- What the trimmer takes out of TianWen.Lib for the Sky switch is put in the published wwwroot/data, with an
       index.txt naming each file. The list is READ from TianWen.Lib's ILLink.Substitutions.xml, the one place a
       file is given its group, so the folder cannot fall behind it. The files are the library's own build
       outputs and inputs (Astrometry/Catalogs), copied as they are. After Publish and not through the static
       web assets pipeline: the generated .gs.gz do not exist when this project is evaluated on a clean tree,
       and they are compressed already. A build that is run and not published (dotnet run, the E2E fixture) is
       not trimmed, embeds everything and has no such folder, which HttpDataFiles reads as "carries nothing". -->
  <Target Name="StageSkyDataFiles" AfterTargets="Publish">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\TianWen.Lib\ILLink.Substitutions.xml"
             Query="/linker/assembly[@feature='TianWen.Lib.EmbeddedData.Sky']/resource/@name">
      <Output TaskParameter="Result" ItemName="_SkyResource" />
    </XmlPeek>
    <ItemGroup>
      <_SkyDataFile Include="@(_SkyResource)">
        <DataFileName>$([System.String]::Copy('%(Identity)').Replace('TianWen.Lib.Astrometry.Catalogs.', ''))</DataFileName>
      </_SkyDataFile>
    </ItemGroup>
    <Error Condition="'@(_SkyDataFile)' == ''" Text="No Sky group found in TianWen.Lib's ILLink.Substitutions.xml: the web app would publish with no catalogue at all." />
    <Copy SourceFiles="@(_SkyDataFile->'$(MSBuildThisFileDirectory)..\TianWen.Lib\Astrometry\Catalogs\%(DataFileName)')"
          DestinationFolder="$(PublishDir)wwwroot\data" />
    <WriteLinesToFile File="$(PublishDir)wwwroot\data\index.txt" Lines="@(_SkyDataFile->'%(DataFileName)')" Overwrite="true" />
  </Target>

  <!-- The planets' offline texture atlas, served beside the page (Planner.razor's LoadPlanetAtlasAsync); one file, kept in
       TianWen.UI.Abstractions where the desktop hosts copy it from. -->
  <ItemGroup>
    <Content Include="..\TianWen.UI.Abstractions\Resources\planet-textures.png" Link="wwwroot\planet-textures.png" CopyToOutputDirectory="Never"
             ContentRoot="$(MSBuildThisFileDirectory)..\TianWen.UI.Abstractions\Resources\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.UI.Abstractions\TianWen.UI.Abstractions.csproj" />
  </ItemGroup>

  <!-- AOT (RunAOTCompilation=true on the deploy publish): the mono AOT cross-compiler fail-fasts
       (sgen assertion, 0xC0000409) on these P/Invoke-dense vendor SDK assemblies - and they are
       dead weight in a browser anyway (no native device I/O). Keep them interpreted; the rest of
       the app AOTs. Item identity must be the .dll name so MSBuild's %(Filename) batching matches
       the aot-in file names. Why the trimmer keeps them in the bundle at all is a tracked
       follow-up - once they trim away, this list can go. -->
  <ItemGroup>
    <_AOT_InternalForceInterpretAssemblies Include="ZWOptical.SDK.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="QHYCCD.SDK.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="LibUsbDotNet.LibUsbDotNet.dll" />
  </ItemGroup>

  <!-- WebGL backend: sibling working copy for local iteration, NuGet otherwise, on the same
       UseLocalSiblings switch and the same CPM pin as every desktop sibling. WebGl.Renderer is in that
       switch's own Exists list, so the two branches below can never disagree about whether the sibling
       is on disk. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\WebGl.Renderer\src\WebGl.Renderer\WebGl.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="WebGl.Renderer" />
  </ItemGroup>


</Project>
