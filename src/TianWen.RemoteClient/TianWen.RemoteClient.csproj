<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <!-- Consumed by the AOT-published tianwen-gui, so the trim/AOT analyzers run here. All JSON
         goes through the source-generated HostingJsonContext in TianWen.Hosting.Contracts; there is
         no reflection-based serialization anywhere in this assembly. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport (DetachedProcess: CreateProcessW, to start the node's keeper broken away from the client's job). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.Lib\TianWen.Lib.csproj" />
    <ProjectReference Include="..\TianWen.Hosting.Contracts\TianWen.Hosting.Contracts.csproj" />
  </ItemGroup>

  <!-- LAN.Lib: LanClockOffset, how far a node's clock is ahead of this computer's (the mirror's exposure countdown). Sibling
       repo's csproj lives at ../LAN.Lib/src/LAN.Lib/LAN.Lib.csproj. -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\LAN.Lib\src\LAN.Lib\LAN.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="LAN.Lib" />
  </ItemGroup>

</Project>
