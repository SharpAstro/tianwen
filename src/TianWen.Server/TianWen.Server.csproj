<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tianwen-server</AssemblyName>
    <PublishAot>true</PublishAot>
    <Platforms>AnyCPU</Platforms>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Version)' == '' ">
    <Version Condition=" '$(VersionSuffix)' != '' And $(VersionSuffix[0]) != '+'">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Version Condition=" '$(VersionSuffix)' != '' And $(VersionSuffix[0]) == '+'">$(VersionPrefix)$(VersionSuffix)</Version>
    <Version Condition=" '$(Version)' == '' ">$(VersionPrefix)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.Lib\TianWen.Lib.csproj" />
    <ProjectReference Include="..\TianWen.Devices.Native\TianWen.Devices.Native.csproj" />
    <ProjectReference Include="..\TianWen.Hosting\TianWen.Hosting.csproj" />
    <!-- AI enhancers (RC-Astro CLI wrappers + SAS ONNX fallback) for POST /api/v1/image/enhance. -->
    <ProjectReference Include="..\TianWen.AI.Imaging\TianWen.AI.Imaging.csproj" />
  </ItemGroup>

  <!-- tianwen-ascomhost beside the node, which looks for it beside itself to host a legacy in-proc COM ASCOM
       driver out of process (docs/plans/ascom-oop-host.md). Windows only: it hosts Windows COM. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ExeBesideThis Include="..\TianWen.AscomHost\TianWen.AscomHost.csproj" />
  </ItemGroup>
  <Import Project="..\ExeBeside.targets" />

</Project>
