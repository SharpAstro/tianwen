<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <ProjectReference Include="..\..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" />
    <PackageReference Include="SdlVulkan.Renderer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.UI.Abstractions\TianWen.UI.Abstractions.csproj" />
  </ItemGroup>

  <!-- Shaders are authored as GLSL 450 in Shaders/*.vert|*.frag and pre-baked to SPIR-V under
       Shaders/spirv/*.spv by the tools/BakeShaders tool (committed). VkFitsImagePipeline /
       VkSkyMapPipeline embed the .spv and load it at runtime (LoadShaderModule) - NO runtime
       GLSL->SPIR-V compilation, so the shipped assembly carries no shaderc (SdlVulkan.Renderer 6.23
       dropped the runtime shaderc it used to transit; this removes the dependency for real, which is
       what makes an Android build possible - shaderc ships no android RID - and trims AOT/startup).
       Re-bake and commit the .spv when a shader changes (see the TWSH0001 warning below). -->
  <ItemGroup>
    <None Remove="Shaders\spirv\*.spv" />
    <EmbeddedResource Include="Shaders\spirv\*.spv">
      <LogicalName>TianWen.UI.Shared.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ShaderSource Include="Shaders\*.vert;Shaders\*.frag" />
  </ItemGroup>

  <!-- Warn (never fail) when a shader source is not the content its .spv was baked from, or the .spv is
       missing, so an edit that forgets to re-bake is caught in the build log instead of silently
       shipping stale bytecode. Each shader is judged on its own and its warning names it. Nothing in CI
       checks the .spv against its source, so this is the shaders' only guard. tools/BakeShaders records
       every source's SHA-256 (of the LF bytes git stores) in Shaders/spirv/sources.sha256, in sha256sum
       format, and this hashes each source as it stands with GetFileHash: the same bytes on every host,
       since the working copy is LF everywhere (.gitattributes). CONTENT, never modification times: a
       time comparison fires for ever on a clone that PULLED a source edit which bakes to identical
       SPIR-V (a comment, whitespace), because git then rewrites the source and not the .spv (#792). -->
  <PropertyGroup>
    <_ShaderBakeManifest>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Shaders', 'spirv', 'sources.sha256'))</_ShaderBakeManifest>
  </PropertyGroup>

  <Target Name="WarnStaleBakedShaders" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ShaderBakeManifestText Condition="Exists('$(_ShaderBakeManifest)')">$([System.IO.File]::ReadAllText('$(_ShaderBakeManifest)'))</_ShaderBakeManifestText>
    </PropertyGroup>
    <ItemGroup>
      <_ShaderToHash Include="@(ShaderSource)">
        <BakedFile>Shaders\spirv\%(ShaderSource.Filename)%(ShaderSource.Extension).spv</BakedFile>
        <BakedPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Shaders', 'spirv', '%(ShaderSource.Filename)%(ShaderSource.Extension).spv'))</BakedPath>
        <RecordedHash>$([System.Text.RegularExpressions.Regex]::Match('$(_ShaderBakeManifestText)', '(?m)^[0-9A-Fa-f]{64}(?=  $([System.Text.RegularExpressions.Regex]::Escape('%(ShaderSource.Filename)%(ShaderSource.Extension)'))\r?$)').Value)</RecordedHash>
      </_ShaderToHash>
      <_ShaderToHash>
        <BakedExists>$([System.IO.File]::Exists('%(BakedPath)'))</BakedExists>
      </_ShaderToHash>
    </ItemGroup>
    <GetFileHash Files="@(_ShaderToHash)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_ShaderBakeCheck" />
    </GetFileHash>
    <!-- MSBuild's == is case-insensitive, so the case GetFileHash writes its hex in does not matter. -->
    <Warning Code="TWSH0001"
             Condition="'%(_ShaderBakeCheck.BakedExists)' != 'True'"
             Text="%(_ShaderBakeCheck.Identity) has no baked SPIR-V (%(_ShaderBakeCheck.BakedFile) is missing); run 'dotnet run --project tools/BakeShaders -c Release -- src/TianWen.UI.Shared/Shaders' and commit Shaders/spirv/." />
    <Warning Code="TWSH0001"
             Condition="'%(_ShaderBakeCheck.BakedExists)' == 'True' and '%(_ShaderBakeCheck.RecordedHash)' == ''"
             Text="%(_ShaderBakeCheck.Identity) has no hash in Shaders/spirv/sources.sha256, so %(_ShaderBakeCheck.BakedFile) cannot be checked against it; run 'dotnet run --project tools/BakeShaders -c Release -- src/TianWen.UI.Shared/Shaders' and commit Shaders/spirv/." />
    <Warning Code="TWSH0001"
             Condition="'%(_ShaderBakeCheck.BakedExists)' == 'True' and '%(_ShaderBakeCheck.RecordedHash)' != '' and '%(_ShaderBakeCheck.RecordedHash)' != '%(_ShaderBakeCheck.FileHash)'"
             Text="%(_ShaderBakeCheck.Identity) has changed since %(_ShaderBakeCheck.BakedFile) was baked (its SHA-256 is not the one Shaders/spirv/sources.sha256 records); re-run 'dotnet run --project tools/BakeShaders -c Release -- src/TianWen.UI.Shared/Shaders' and commit Shaders/spirv/." />
  </Target>

</Project>
