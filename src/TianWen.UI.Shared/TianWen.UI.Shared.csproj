<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <ProjectReference Include="..\..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" />
    <PackageReference Include="SdlVulkan.Renderer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianWen.UI.Abstractions\TianWen.UI.Abstractions.csproj" />
  </ItemGroup>

  <!-- Shaders are authored as GLSL 450 in Shaders/*.vert|*.frag and pre-baked to SPIR-V under
       Shaders/spirv/*.spv by the tools/BakeShaders tool (committed). VkFitsImagePipeline /
       VkSkyMapPipeline embed the .spv and load it at runtime (LoadShaderModule) - NO runtime
       GLSL->SPIR-V compilation, so the shipped assembly carries no shaderc (SdlVulkan.Renderer 6.23
       dropped the runtime shaderc it used to transit; this removes the dependency for real, which is
       what makes an Android build possible - shaderc ships no android RID - and trims AOT/startup).
       Re-bake and commit the .spv when a shader changes (see the TWSH0001 warning below). -->
  <ItemGroup>
    <None Remove="Shaders\spirv\*.spv" />
    <EmbeddedResource Include="Shaders\spirv\*.spv">
      <LogicalName>TianWen.UI.Shared.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ShaderSource Include="Shaders\*.vert;Shaders\*.frag" />
  </ItemGroup>

  <!-- Warn (never fail) when a shader source is newer than its baked .spv by more than
       StaleBakeToleranceSeconds, or the .spv is missing, so an edit that forgets to re-bake is caught in
       the build log instead of silently shipping stale bytecode. Each shader is judged on its own and
       its warning names it. Nothing in CI checks the .spv against its source, so this is the shaders'
       only guard. The tolerance exists because a git checkout writes files in directory order, often a
       few milliseconds apart with the source last, which a plain Inputs/Outputs comparison reported as
       stale on a clean clone; a forgotten re-bake is an edit made minutes or days after the last bake,
       well past the tolerance. -->
  <PropertyGroup>
    <StaleBakeToleranceSeconds Condition="'$(StaleBakeToleranceSeconds)' == ''">60</StaleBakeToleranceSeconds>
  </PropertyGroup>

  <Target Name="WarnStaleBakedShaders" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ShaderBakeCheck Include="@(ShaderSource)">
        <BakedFile>Shaders\spirv\%(ShaderSource.Filename)%(ShaderSource.Extension).spv</BakedFile>
        <BakedPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Shaders', 'spirv', '%(ShaderSource.Filename)%(ShaderSource.Extension).spv'))</BakedPath>
      </_ShaderBakeCheck>
      <_ShaderBakeCheck>
        <BakedExists>$([System.IO.File]::Exists('%(BakedPath)'))</BakedExists>
        <AheadTicks>$([MSBuild]::Subtract($([System.IO.File]::GetLastWriteTime('%(FullPath)').ToUniversalTime().Ticks), $([System.IO.File]::GetLastWriteTime('%(BakedPath)').ToUniversalTime().Ticks)))</AheadTicks>
      </_ShaderBakeCheck>
    </ItemGroup>
    <PropertyGroup>
      <_StaleBakeToleranceTicks>$([MSBuild]::Multiply($(StaleBakeToleranceSeconds), 10000000))</_StaleBakeToleranceTicks>
    </PropertyGroup>
    <Warning Code="TWSH0001"
             Condition="'%(_ShaderBakeCheck.BakedExists)' != 'True'"
             Text="%(_ShaderBakeCheck.Identity) has no baked SPIR-V (%(_ShaderBakeCheck.BakedFile) is missing); run 'dotnet run --project tools/BakeShaders -c Release -- src/TianWen.UI.Shared/Shaders' and commit Shaders/spirv/*.spv." />
    <Warning Code="TWSH0001"
             Condition="'%(_ShaderBakeCheck.BakedExists)' == 'True' and %(_ShaderBakeCheck.AheadTicks) &gt; $(_StaleBakeToleranceTicks)"
             Text="%(_ShaderBakeCheck.Identity) is newer than %(_ShaderBakeCheck.BakedFile) by more than $(StaleBakeToleranceSeconds) s; re-run 'dotnet run --project tools/BakeShaders -c Release -- src/TianWen.UI.Shared/Shaders' and commit Shaders/spirv/*.spv." />
  </Target>

</Project>
