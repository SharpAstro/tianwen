# Catalog preprocessor output: derived from src/TianWen.Lib/Astrometry/Catalogs/*.json.lz
# via tools/preprocess-catalog.ps1. Built locally by the PreprocessCatalogs MSBuild
# target (pure .NET, no external binaries) and on CI by the `build` job, then shared
# with downstream jobs as the `preprocessed-catalogs` artifact. See docs/plans/catalog-binary-format.md.
src/TianWen.Lib/Astrometry/Catalogs/*.gs.gz

# SASP filter/sensor/SED data is produced by tools/import-sasp-data (downloads
# SASP_data.fits from setiastro/setiastrosuitepro on GitHub). Unlike the catalog
# .gs.gz files there's no committed .json.lz source to regenerate from, so these
# three files ARE tracked in git -- exempt from the wildcard above.
!src/TianWen.Lib/Astrometry/Catalogs/filter_curves.gs.gz
!src/TianWen.Lib/Astrometry/Catalogs/sensor_qe.gs.gz
!src/TianWen.Lib/Astrometry/Catalogs/pickles_sed.gs.gz
# Lavapipe min-repro zip (built artifact for upstream bug filing)
LavapipeMinRepro.zip
__pycache__/
# CI-baked comet assets (pages.yml runs tools/bake-comets into wwwroot on the runner): the bulk SBDB
# query response, and the per-object Horizons current-apparition overlay seeded from the live site
src/TianWen.UI.Web/wwwroot/comets-sbdb.json
src/TianWen.UI.Web/wwwroot/comets-apparitions.json
# CI-staged Tycho-2 catalog (pages.yml copies the LFS .lz into wwwroot on the runner; the atlas
# fetches it at runtime - it must never be committed into the source tree's wwwroot)
src/TianWen.UI.Web/wwwroot/tyc2.bin.lz
# ... and the region-aligned members bake-tycho2 derives from it (166 files + manifest.bin), so a
# view can fetch only the sky it is looking at. Derived on the runner, never committed.
src/TianWen.UI.Web/wwwroot/tyc2/
# Isolated AOT-publish output (local :5100 perf builds; keeps the dev server's obj/bin unclobbered)
bin-aot/
obj-aot/

# Local MSIX packaging output (packaging/windows/msix/build-msix.ps1)
/artifacts/
/bundle/

# BenchmarkDotNet run output (dotnet run --project src/TianWen.UI.Benchmarks); lands
# beside whatever directory the run started from, so both are ignored.
BenchmarkDotNet.Artifacts/
